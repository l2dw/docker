# ## Portainer Environment Variables
# ## Portainer volumes
PORTAINER_DATA_DIR=
PORTAINER_DATA_VOLUME_NAME=portainer_data
PORTAINER_DATA_VOLUME_EXTERNAL=false
PORTAINER_DATA_VOLUME_DIR=
# ## Portainer domain
PORTAINER_DOMAIN=example.com
PORTAINER_BASE_PATH=/portainer
# ## Portainer Traefik
PORTAINER_TRAEFIK_ENTRYPOINTS=web
PORTAINER_TRUSTED_ORIGINS=example.com
# Leave empty to use strip-prefix-portainer@docker from compose defaults
PORTAINER_TRAEFIK_MIDDLEWARES=
PORTAINER_TRAEFIK_TLS_ENABLE=false
PORTAINER_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
# ## Portainer container
PORTAINER_IMAGE_REGISTRY=
PORTAINER_IMAGE_PATH=
PORTAINER_IMAGE_TAG=
PORTAINER_PORT=9000
PORTAINER_PULL_POLICY=always
PORTAINER_RESTART=unless-stopped
PORTAINER_PRIVILEGED=false
PORTAINER_MEMORY_LIMIT=512M
# ## Portainer Homepage
PORTAINER_HOMEPAGE_GROUP=Infra
PORTAINER_HOMEPAGE_NAME=Portainer
PORTAINER_HOMEPAGE_ICON=portainer.png
PORTAINER_HOMEPAGE_HREF=http://example.com/portainer
PORTAINER_HOMEPAGE_DESCRIPTION="Portainer is a platform for managing Docker containers."
# ## Portainer Deployment
PORTAINER_DEPLOY_REPLICAS=1
PORTAINER_DEPLOY_MODE=replicated
PORTAINER_DEPLOY_PLACEMENT_CONSTRAINTS=
# ## PORTAINER Deploy Placement (Swarm): leave empty → any eligible Linux node (scheduler picks). Pin when needed, e.g.:
# PORTAINER_DEPLOY_PLACEMENT_CONSTRAINTS=node.role==manager
# PORTAINER_DEPLOY_PLACEMENT_CONSTRAINTS=node.hostname==db-1
# PORTAINER_DEPLOY_PLACEMENT_CONSTRAINTS=node.labels.name==portainer-1
