# Copied to `.env` and loaded by `make` via `-include` + export.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock
APPDATA_DIR=/appdata

HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:latest
HOMEPAGE_ENV_FILE=.env.example
HOMEPAGE_DATA_HOST_PATH=/appdata/homepage/config
HOMEPAGE_DATA_CONTAINER_PATH=/app/config
HOMEPAGE_DATA_VOLUME_NAME=homepage_data
HOMEPAGE_ALLOWED_HOSTS=homepage.example.com
HOMEPAGE_HOST_DOMAIN=homepage.example.com
HOMEPAGE_HOST_URI=/
HOMEPAGE_HOST_PROTOCOL=http
HOMEPAGE_PLACEMENT_CONSTRAINTS=node.role==manager
HOMEPAGE_MEMORY_LIMIT=1G
HOMEPAGE_PRIVILEGED=false
HOMEPAGE_TRAEFIK_ENTRYPOINTS=web
HOMEPAGE_TRAEFIK_TLS_ENABLED=false
HOMEPAGE_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
