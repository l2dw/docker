# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://gethomepage.dev/installation/docker/
# Subpath deploy is unsupported (assets use absolute paths) — prefer Host-only (HOMEPAGE_BASE_PATH=/).

APP_NAME=homepage

DEFAULT_NETWORK_NAME=homepage-network
DEFAULT_NETWORK_EXTERNAL=false

HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:latest
HOMEPAGE_RESTART=unless-stopped
HOMEPAGE_PRIVILEGED=false
HOMEPAGE_ENV_FILE=.env.example
HOMEPAGE_PORT=3000

# Required by Homepage when not on localhost (comma-separated hosts, no spaces).
HOMEPAGE_ALLOWED_HOSTS=homepage.example.com
HOMEPAGE_DOMAIN=homepage.example.com
HOMEPAGE_BASE_PATH=/
HOMEPAGE_APP_URL=http://homepage.example.com/

# Compose key `config` → container HOMEPAGE_CONFIG_VOLUME_DIR (/app/config).
# Bind recipe (default). For local named volume: leave TYPE/OPTS/PATH empty.
# NFS: TYPE=nfs OPTS=addr=host,rw,nfsvers=4 PATH=:/exports/homepage
HOMEPAGE_CONFIG_VOLUME_NAME=homepage_config
HOMEPAGE_CONFIG_VOLUME_EXTERNAL=false
HOMEPAGE_CONFIG_VOLUME_DRIVER=local
HOMEPAGE_CONFIG_VOLUME_TYPE=none
HOMEPAGE_CONFIG_VOLUME_OPTS=bind
HOMEPAGE_CONFIG_VOLUME_PATH=/appdata/homepage/config
HOMEPAGE_CONFIG_VOLUME_DIR=/app/config

# Filesystem path for the Docker API socket (not unix://…). Mounted read-only.
HOMEPAGE_DOCKER_SOCKET=/var/run/docker.sock

HOMEPAGE_DEPLOY_MODE=replicated
HOMEPAGE_DEPLOY_REPLICAS=1
HOMEPAGE_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HOMEPAGE_RESTART_POLICY_CONDITION=any
HOMEPAGE_RESTART_POLICY_DELAY=5s
HOMEPAGE_RESTART_POLICY_MAX_ATTEMPTS=3
HOMEPAGE_MEMORY_LIMIT=1G

HOMEPAGE_TRAEFIK_LABELS_SWARM_ENABLE=true
HOMEPAGE_TRAEFIK_LABELS_DOCKER_ENABLE=true
HOMEPAGE_ENTRYPOINTS=web
HOMEPAGE_MIDDLEWARES=
HOMEPAGE_TLS_ENABLED=false
HOMEPAGE_TLS_CERTRESOLVER=letsencrypt

# Homepage dashboard labels (Traefik/Homepage discovery)
HOMEPAGE_HOMEPAGE_GROUP=Infrastructure
HOMEPAGE_HOMEPAGE_NAME=Homepage
HOMEPAGE_HOMEPAGE_ICON=homepage.png
HOMEPAGE_HOMEPAGE_DESCRIPTION=Application dashboard
HOMEPAGE_HOMEPAGE_URL=
HOMEPAGE_HOMEPAGE_SITEMONITOR=http://homepage:3000
