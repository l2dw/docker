# Fleet Server — placeholders only. Production: FLEET_SERVER_ENV_FILE=.env
# Elastic Fleet Server 8.17 (elastic-agent image) — placeholders only. Needs Elasticsearch + a Fleet Server policy and service token created in Kibana.
# Fleet Server serves HTTPS by default: for the Traefik HTTP route set FLEET_SERVER_INSECURE_HTTP=true. Agents can also enrol directly on the published host port.
APP_NAME=fleet-server
DEFAULT_NETWORK_NAME=fleet-server-network
DEFAULT_NETWORK_EXTERNAL=false
# Join Dokploy overlay: DEFAULT_NETWORK_NAME=dokploy-network (setup sets EXTERNAL=true).
FLEET_SERVER_IMAGE=docker.elastic.co/beats/elastic-agent:8.17.0
FLEET_SERVER_HOSTNAME=fleet-server
FLEET_SERVER_RESTART=unless-stopped
FLEET_SERVER_PRIVILEGED=false
FLEET_SERVER_ENV_FILE=.env.example
FLEET_SERVER_DOMAIN=fleet-server.example.com
FLEET_SERVER_BASE_PATH=/fleet
FLEET_SERVER_APP_URL=http://fleet-server.example.com/fleet
FLEET_SERVER_ENTRYPOINTS=web
FLEET_SERVER_TLS_ENABLED=false
FLEET_SERVER_TLS_CERTRESOLVER=letsencrypt
FLEET_SERVER_TRAEFIK_LABELS_SWARM_ENABLE=true
FLEET_SERVER_TRAEFIK_LABELS_DOCKER_ENABLE=true
FLEET_SERVER_HTTP_PORT=8220
FLEET_SERVER_ELASTICSEARCH_HOST=http://elasticsearch:9200
FLEET_SERVER_SERVICE_TOKEN=ChangeMe
FLEET_SERVER_POLICY=fleet-server-policy
FLEET_SERVER_INSECURE_HTTP=false
FLEET_SERVER_INSECURE=1
FLEET_SERVER_ENROLL=1
# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Multi-instance / Dokploy: use a distinct NAME per app (fleet_server_data_01, …).
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/fleet-server
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/fleet-server
#   External:              EXTERNAL=true   (pre-create: docker volume create fleet_server_data)
#   # FLEET_SERVER_DATA_VOLUME_TYPE=none
#   # FLEET_SERVER_DATA_VOLUME_OPTS=bind
#   # FLEET_SERVER_DATA_VOLUME_PATH=/appdata/fleet-server
FLEET_SERVER_DATA_VOLUME_NAME=fleet_server_data
FLEET_SERVER_DATA_VOLUME_EXTERNAL=false
FLEET_SERVER_DATA_VOLUME_DRIVER=local
FLEET_SERVER_DATA_VOLUME_TYPE=
FLEET_SERVER_DATA_VOLUME_OPTS=
FLEET_SERVER_DATA_VOLUME_PATH=
FLEET_SERVER_DATA_VOLUME_DIR=/usr/share/elastic-agent/state
FLEET_SERVER_DEPLOY_MODE=replicated
FLEET_SERVER_DEPLOY_REPLICAS=1
FLEET_SERVER_MEMORY_LIMIT=1G
FLEET_SERVER_PLACEMENT_CONSTRAINTS=node.platform.os==linux
FLEET_SERVER_RESTART_POLICY_CONDITION=any
FLEET_SERVER_RESTART_POLICY_DELAY=5s
FLEET_SERVER_RESTART_POLICY_MAX_ATTEMPTS=3
FLEET_SERVER_HOMEPAGE_GROUP=Search
FLEET_SERVER_HOMEPAGE_NAME=Fleet Server
FLEET_SERVER_HOMEPAGE_ICON=elasticsearch.png
FLEET_SERVER_HOMEPAGE_DESCRIPTION=Elastic Fleet Server
FLEET_SERVER_HOMEPAGE_URL=
FLEET_SERVER_HOMEPAGE_SITEMONITOR=http://fleet-server:8220/api/status
