# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://hub.docker.com/r/b3log/siyuan
# Entrypoint (v3.7.0+): serve --workspace=<path>. Uses SIYUAN_WORKSPACE_CONTAINER_PATH for the command path and the mount target.
# Default SIYUAN_BASE_PATH=/ → http://siyuan.example.com/ (Host + PathPrefix(/), no stripPrefix).
# Subpath is NOT supported by SiYuan docs (reverse proxy is recommended; WebSocket /ws required). Keep BASE_PATH=/ and use a subdomain.

DEFAULT_NETWORK_NAME=siyuan-network
DEFAULT_NETWORK_EXTERNAL=false

SIYUAN_IMAGE=docker.io/b3log/siyuan:latest
SIYUAN_RESTART=unless-stopped
SIYUAN_PRIVILEGED=false
SIYUAN_ENV_FILE=.env.example

SIYUAN_DOMAIN=siyuan.example.com
SIYUAN_BASE_PATH=/
SIYUAN_LANG=en
SIYUAN_ACCESS_AUTH_CODE=ChangeMe
SIYUAN_PUID=1000
SIYUAN_PGID=1000

# # Data volume — named Docker volume by default. Can be repointed to a bind mount or an NFS share
# # via driver_opts, without changing compose.yml/docker-compose.yml (see README § Volume NFS).
SIYUAN_DATA_VOLUME_NAME=siyuan_data
SIYUAN_DATA_VOLUME_EXTERNAL=false
SIYUAN_DATA_VOLUME_DRIVER=local
# # Leave TYPE/O/DEVICE empty => normal local named volume (Docker manages the storage).
# # Set the three below to mount an NFS export directly as the named volume:
# SIYUAN_DATA_VOLUME_DRIVER_TYPE=nfs
# SIYUAN_DATA_VOLUME_DRIVER_O=addr=nfs-server.example.com,rw,nfsvers=4
# SIYUAN_DATA_VOLUME_DRIVER_DEVICE=:/exports/siyuan-data
SIYUAN_DATA_VOLUME_DRIVER_TYPE=
SIYUAN_DATA_VOLUME_DRIVER_O=
SIYUAN_DATA_VOLUME_DRIVER_DEVICE=
SIYUAN_DATA_HOST_PATH=siyuan_data
SIYUAN_WORKSPACE_CONTAINER_PATH=/siyuan/workspace

SIYUAN_TRAEFIK_LABELS_SWARM_ENABLE=true
SIYUAN_TRAEFIK_LABELS_DOCKER_ENABLE=true
SIYUAN_ENTRYPOINTS=web
SIYUAN_MIDDLEWARES=
SIYUAN_TLS_ENABLED=false
SIYUAN_TLS_CERTRESOLVER=letsencrypt

SIYUAN_DEPLOY_MODE=replicated
SIYUAN_DEPLOY_REPLICAS=1
SIYUAN_PLACEMENT_CONSTRAINTS=node.platform.os==linux
SIYUAN_MEMORY_LIMIT=1G

SIYUAN_HOMEPAGE_GROUP=Notes
SIYUAN_HOMEPAGE_NAME=SiYuan
SIYUAN_HOMEPAGE_ICON=siyuan.png
SIYUAN_HOMEPAGE_HREF=http://siyuan.example.com/
SIYUAN_HOMEPAGE_DESCRIPTION=Local-first knowledge base
SIYUAN_HOMEPAGE_SITEMONITOR=http://siyuan:6806
