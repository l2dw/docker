# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Docs: https://docs.paperless-ngx.com/configuration/
# Redis and PostgreSQL are **external** (dokploy-redis / dokploy-postgresql). Create the DB first.

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:3.0.5
PAPERLESS_RESTART=unless-stopped
PAPERLESS_PRIVILEGED=false
PAPERLESS_ENV_FILE=.env.example

# Subpath is supported (PAPERLESS_FORCE_SCRIPT_NAME + PAPERLESS_STATIC_URL).
# Host-only: PAPERLESS_BASE_PATH=/ then make paperless-setup clears FORCE_SCRIPT_NAME and sets STATIC_URL=/static/
PAPERLESS_BASE_PATH=/paperless
PAPERLESS_DOMAIN=paperless.example.com
# PAPERLESS_URL must NOT include a path (vendor rule). Public path is FORCE_SCRIPT_NAME / Homepage href.
PAPERLESS_URL=http://paperless.example.com
PAPERLESS_FORCE_SCRIPT_NAME=/paperless
PAPERLESS_STATIC_URL=/paperless/static/
PAPERLESS_HEALTHCHECK_URL=http://127.0.0.1:8000/paperless/

# redis://[:password@]host:port — copy REDIS_PASSWORD from the redis stack into this URL.
PAPERLESS_REDIS=redis://:ChangeMe@dokploy-redis:6379

PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=dokploy-postgresql
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=ChangeMe

# Generated by make paperless-setup if empty
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=

PAPERLESS_OCR_LANGUAGE=fra+eng
PAPERLESS_USERMAP_UID=1000
PAPERLESS_USERMAP_GID=1000

PAPERLESS_DATA_VOLUME_NAME=paperless-data
PAPERLESS_DATA_VOLUME_EXTERNAL=false
PAPERLESS_MEDIA_VOLUME_NAME=paperless-media
PAPERLESS_MEDIA_VOLUME_EXTERNAL=false
PAPERLESS_EXPORT_VOLUME_NAME=paperless-export
PAPERLESS_EXPORT_VOLUME_EXTERNAL=false
PAPERLESS_CONSUME_VOLUME_NAME=paperless-consume
PAPERLESS_CONSUME_VOLUME_EXTERNAL=false
# Swarm: volume *names*, not host paths. See README (named volume trap).
# Named *_BIND (not *_DIR) so they do not collide with Paperless path settings.
PAPERLESS_DATA_BIND=paperless-data
PAPERLESS_MEDIA_BIND=paperless-media
PAPERLESS_EXPORT_BIND=paperless-export
PAPERLESS_CONSUME_BIND=paperless-consume

PAPERLESS_TRAEFIK_LABELS_SWARM_ENABLE=true
PAPERLESS_TRAEFIK_LABELS_DOCKER_ENABLE=true
PAPERLESS_ENTRYPOINTS=web
PAPERLESS_MIDDLEWARES=
PAPERLESS_TLS_ENABLED=false
PAPERLESS_TLS_CERTRESOLVER=letsencrypt

PAPERLESS_DEPLOY_MODE=replicated
PAPERLESS_DEPLOY_REPLICAS=1
PAPERLESS_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PAPERLESS_MEMORY_LIMIT=1G

PAPERLESS_HOMEPAGE_GROUP=Documents
PAPERLESS_HOMEPAGE_NAME=Paperless
PAPERLESS_HOMEPAGE_ICON=paperless-ngx.png
PAPERLESS_HOMEPAGE_HREF=http://paperless.example.com/paperless
PAPERLESS_HOMEPAGE_DESCRIPTION=Paperless-ngx DMS
PAPERLESS_HOMEPAGE_SITEMONITOR=http://paperless:8000
