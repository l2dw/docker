# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Docs: https://github.com/netbox-community/netbox-docker
# Image netboxcommunity/netbox (HTTP 8080). Postgres + Redis are external.

DEFAULT_NETWORK_NAME=netbox-network
DEFAULT_NETWORK_EXTERNAL=false

NETBOX_IMAGE=docker.io/netboxcommunity/netbox:v4.6-5.0.2
NETBOX_RESTART=unless-stopped
NETBOX_PRIVILEGED=false
NETBOX_ENV_FILE=.env.example

NETBOX_WORKER_IMAGE=docker.io/netboxcommunity/netbox:v4.6-5.0.2
NETBOX_WORKER_RESTART=unless-stopped
NETBOX_WORKER_PRIVILEGED=false
NETBOX_WORKER_ENV_FILE=.env.example

NETBOX_DOMAIN=netbox.example.com
# Subpath is unsupported / fragile in netbox-docker (Unit static routes) — keep / (Host-only).
NETBOX_BASE_PATH=/
NETBOX_APP_URL=http://netbox.example.com
NETBOX_ALLOWED_HOSTS=netbox.example.com
NETBOX_TIME_ZONE=America/Toronto

# Generated by netbox-setup if empty (50+ chars recommended).
NETBOX_SECRET_KEY=

# External PostgreSQL (same overlay as the stack).
NETBOX_DB_HOST=postgresql
NETBOX_DB_PORT=5432
NETBOX_DB_NAME=netbox
NETBOX_DB_USER=netbox
NETBOX_DB_PASSWORD=

# External Redis / Valkey — tasks DB 0, cache DB 1 on the same host by default.
NETBOX_REDIS_HOST=redis
NETBOX_REDIS_PORT=6379
NETBOX_REDIS_PASSWORD=
NETBOX_REDIS_DATABASE=0
NETBOX_REDIS_CACHE_HOST=redis
NETBOX_REDIS_CACHE_PORT=6379
NETBOX_REDIS_CACHE_PASSWORD=
NETBOX_REDIS_CACHE_DATABASE=1

NETBOX_CORS_ORIGIN_ALLOW_ALL=true
NETBOX_SKIP_SUPERUSER=true
NETBOX_WEBHOOKS_ENABLED=true
NETBOX_GRAPHQL_ENABLED=true
NETBOX_METRICS_ENABLED=false
NETBOX_MEDIA_ROOT=/opt/netbox/netbox/media

NETBOX_TRAEFIK_LABELS_SWARM_ENABLE=true
NETBOX_TRAEFIK_LABELS_DOCKER_ENABLE=true
NETBOX_ENTRYPOINTS=web
NETBOX_MIDDLEWARES=
NETBOX_TLS_ENABLED=false
NETBOX_TLS_CERTRESOLVER=letsencrypt

NETBOX_DEPLOY_MODE=replicated
NETBOX_DEPLOY_REPLICAS=1
NETBOX_PLACEMENT_CONSTRAINTS=node.platform.os==linux
NETBOX_MEMORY_LIMIT=1G

NETBOX_WORKER_DEPLOY_MODE=replicated
NETBOX_WORKER_DEPLOY_REPLICAS=1
NETBOX_WORKER_PLACEMENT_CONSTRAINTS=node.platform.os==linux
NETBOX_WORKER_MEMORY_LIMIT=1G

NETBOX_MEDIA_VOLUME_NAME=netbox-media
NETBOX_MEDIA_VOLUME_EXTERNAL=false
NETBOX_MEDIA_DIR=netbox-media
NETBOX_REPORTS_VOLUME_NAME=netbox-reports
NETBOX_REPORTS_VOLUME_EXTERNAL=false
NETBOX_REPORTS_DIR=netbox-reports
NETBOX_SCRIPTS_VOLUME_NAME=netbox-scripts
NETBOX_SCRIPTS_VOLUME_EXTERNAL=false
NETBOX_SCRIPTS_DIR=netbox-scripts

NETBOX_HOMEPAGE_GROUP=Apps
NETBOX_HOMEPAGE_NAME=NetBox
NETBOX_HOMEPAGE_ICON=netbox.png
NETBOX_HOMEPAGE_DESCRIPTION=NetBox
NETBOX_HOMEPAGE_SITEMONITOR=http://netbox:8080
