# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Docs: https://nocodb.com/docs/self-hosting/environment-variables
# Image nocodb/nocodb (HTTP 8080). Default DB is SQLite under /usr/app/data/.

# Stack-local default. To join a shared overlay (Traefik), set NAME + EXTERNAL=true explicitly.
DEFAULT_NETWORK_NAME=nocodb-network
DEFAULT_NETWORK_EXTERNAL=false

NOCODB_IMAGE=docker.io/nocodb/nocodb:2026.08.1
NOCODB_RESTART=unless-stopped
NOCODB_PRIVILEGED=false
NOCODB_ENV_FILE=.env.example
NOCODB_PORT=8080

NOCODB_DOMAIN=nocodb.example.com
# Subpath is unsupported / fragile — keep / (Host-only dedicated subdomain).
NOCODB_BASE_PATH=/
NOCODB_APP_URL=http://nocodb.example.com
# Public URL for emails / Swagger (vendor NC_SITE_URL). Align with APP_URL.
NOCODB_SITE_URL=http://nocodb.example.com

NOCODB_AUTH_JWT_SECRET=
NOCODB_DISABLE_TELE=true
# Postgres (optional): uncomment and set — also add to compose environment:
#   - NC_DB=${NOCODB_DB}
# NOCODB_DB=pg://postgresql:5432?u=nocodb&p=ChangeMe&d=nocodb

NOCODB_TRAEFIK_LABELS_SWARM_ENABLE=true
NOCODB_TRAEFIK_LABELS_DOCKER_ENABLE=true
NOCODB_ENTRYPOINTS=web
NOCODB_MIDDLEWARES=
NOCODB_TLS_ENABLED=false
NOCODB_TLS_CERTRESOLVER=letsencrypt

NOCODB_DEPLOY_MODE=replicated
NOCODB_DEPLOY_REPLICAS=1
NOCODB_PLACEMENT_CONSTRAINTS=node.platform.os==linux
NOCODB_MEMORY_LIMIT=1G

NOCODB_DATA_VOLUME_NAME=nocodb-data
NOCODB_DATA_VOLUME_EXTERNAL=false
# Swarm: volume *name*, not a host path, unless you override with a bind.
NOCODB_DATA_DIR=nocodb-data

NOCODB_HOMEPAGE_GROUP=Apps
NOCODB_HOMEPAGE_NAME=NocoDB
NOCODB_HOMEPAGE_ICON=nocodb.png
NOCODB_HOMEPAGE_DESCRIPTION=NocoDB
NOCODB_HOMEPAGE_SITEMONITOR=http://nocodb:8080
