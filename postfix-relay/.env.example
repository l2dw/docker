# Postfix relay (boky/postfix) — placeholders only.
APP_NAME=postfix-relay
DEFAULT_NETWORK_NAME=postfix-relay-network
DEFAULT_NETWORK_EXTERNAL=false

POSTFIX_RELAY_IMAGE=docker.io/boky/postfix:5.1.0-alpine
POSTFIX_RELAY_RESTART=unless-stopped
POSTFIX_RELAY_PRIVILEGED=false
POSTFIX_RELAY_ENV_FILE=.env.example

POSTFIX_RELAY_RELAYHOST=
POSTFIX_RELAY_RELAYHOST_USERNAME=
POSTFIX_RELAY_RELAYHOST_PASSWORD=
POSTFIX_RELAY_ALLOWED_SENDER_DOMAINS=

POSTFIX_RELAY_PUBLISHED_PORT=2525
POSTFIX_RELAY_PORT_MODE=ingress

POSTFIX_RELAY_DEPLOY_MODE=replicated
POSTFIX_RELAY_DEPLOY_REPLICAS=1
POSTFIX_RELAY_PLACEMENT_CONSTRAINTS=node.platform.os==linux
POSTFIX_RELAY_RESTART_POLICY_CONDITION=any
POSTFIX_RELAY_RESTART_POLICY_DELAY=5s
POSTFIX_RELAY_RESTART_POLICY_MAX_ATTEMPTS=3
POSTFIX_RELAY_MEMORY_LIMIT=512M

POSTFIX_RELAY_HOMEPAGE_GROUP=Infrastructure
POSTFIX_RELAY_HOMEPAGE_NAME=Postfix Relay
POSTFIX_RELAY_HOMEPAGE_ICON=postfix.png
POSTFIX_RELAY_HOMEPAGE_DESCRIPTION=Outbound Postfix relay
POSTFIX_RELAY_HOMEPAGE_URL=
POSTFIX_RELAY_HOMEPAGE_SITEMONITOR=
