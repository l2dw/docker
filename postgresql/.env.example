# Copied into `.env` (or project env) and loaded by make / compose.
# - One assignment per line: KEY=value
# - Leave *_DIR empty to use the named volumes declared in docker-compose.yml

# # Timezone:
TZ=America/Montreal

# # Network:
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

## POSTGRESQL
POSTGRESQL_NETWORK_ALIAS=postgresql-server
POSTGRESQL_IMAGE=docker.io/postgres:16
POSTGRESQL_DATA_VOLUME_NAME=postgresql_data
POSTGRESQL_DATA_VOLUME_EXTERNAL=false
POSTGRESQL_LOGS_VOLUME_NAME=postgresql_logs
POSTGRESQL_LOGS_VOLUME_EXTERNAL=false
POSTGRESQL_DATA_DIR=
POSTGRESQL_LOGS_DIR=
POSTGRESQL_REPLICAS=1
POSTGRESQL_DEPLOY_MODE=replicated
POSTGRESQL_PLACEMENT_CONSTRAINTS=node.role==worker
POSTGRESQL_ENDPOINT_MODE=dnsrr
# Required — compose refuses to start without this
POSTGRESQL_PASSWORD=
POSTGRESQL_USER=postgres
POSTGRESQL_DB=postgres
