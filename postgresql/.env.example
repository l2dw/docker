# PostgreSQL — placeholders only. Production: POSTGRESQL_ENV_FILE=.env
# Official image: https://hub.docker.com/_/postgres
# TCP only — no Traefik.

APP_NAME=postgresql
DEFAULT_NETWORK_NAME=postgresql-network
DEFAULT_NETWORK_EXTERNAL=false
# Join Dokploy overlay: DEFAULT_NETWORK_NAME=dokploy-network (setup sets EXTERNAL=true).

POSTGRESQL_IMAGE=docker.io/library/postgres:16
POSTGRESQL_RESTART=unless-stopped
POSTGRESQL_PRIVILEGED=false
POSTGRESQL_ENV_FILE=.env.example

POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=
POSTGRESQL_DB=postgres

POSTGRESQL_DATA_VOLUME_NAME=postgresql_data
POSTGRESQL_DATA_VOLUME_EXTERNAL=false
POSTGRESQL_DATA_VOLUME_DRIVER=local
POSTGRESQL_DATA_VOLUME_TYPE=
POSTGRESQL_DATA_VOLUME_OPTS=
POSTGRESQL_DATA_VOLUME_PATH=
POSTGRESQL_DATA_VOLUME_DIR=/var/lib/postgresql/data
POSTGRESQL_LOGS_VOLUME_NAME=postgresql_logs
POSTGRESQL_LOGS_VOLUME_EXTERNAL=false
POSTGRESQL_LOGS_VOLUME_DRIVER=local
POSTGRESQL_LOGS_VOLUME_TYPE=
POSTGRESQL_LOGS_VOLUME_OPTS=
POSTGRESQL_LOGS_VOLUME_PATH=
POSTGRESQL_LOGS_VOLUME_DIR=/var/log/postgresql
POSTGRESQL_SCRIPTS_VOLUME_NAME=postgresql_scripts
POSTGRESQL_SCRIPTS_VOLUME_EXTERNAL=false
POSTGRESQL_SCRIPTS_VOLUME_DRIVER=local
POSTGRESQL_SCRIPTS_VOLUME_TYPE=
POSTGRESQL_SCRIPTS_VOLUME_OPTS=
POSTGRESQL_SCRIPTS_VOLUME_PATH=
POSTGRESQL_SCRIPTS_VOLUME_DIR=/docker-entrypoint-initdb.d

POSTGRESQL_PUBLISHED_PORT=25432
POSTGRESQL_PORT=5432
POSTGRESQL_PORT_PROTOCOL=tcp
POSTGRESQL_PORT_MODE=ingress

POSTGRESQL_DEPLOY_MODE=replicated
POSTGRESQL_DEPLOY_REPLICAS=1
POSTGRESQL_PLACEMENT_CONSTRAINTS=node.platform.os==linux
POSTGRESQL_RESTART_POLICY_CONDITION=any
POSTGRESQL_RESTART_POLICY_DELAY=5s
POSTGRESQL_RESTART_POLICY_MAX_ATTEMPTS=3
POSTGRESQL_MEMORY_LIMIT=512M

POSTGRESQL_HOMEPAGE_GROUP=Database
POSTGRESQL_HOMEPAGE_NAME=PostgreSQL
POSTGRESQL_HOMEPAGE_ICON=postgresql.png
POSTGRESQL_HOMEPAGE_DESCRIPTION=PostgreSQL server
POSTGRESQL_HOMEPAGE_URL=
POSTGRESQL_HOMEPAGE_SITEMONITOR=
