# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Set POSTGRESQL_PASSWORD before up (or pass on make command line).

DEFAULT_NETWORK_NAME=postgresql-network
DEFAULT_NETWORK_EXTERNAL=false

POSTGRESQL_IMAGE=docker.io/library/postgres:16
POSTGRESQL_RESTART=unless-stopped
POSTGRESQL_PRIVILEGED=false
# Stable DNS aliases for clients on the same network.
POSTGRESQL_NETWORK_ALIAS=postgresql-server
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=
POSTGRESQL_DB=postgres
POSTGRESQL_DEPLOY_MODE=replicated
POSTGRESQL_DEPLOY_REPLICAS=1
# Empty → any Linux node. Pin e.g. node.role==worker | node.hostname==db-1
POSTGRESQL_PLACEMENT_CONSTRAINTS=
POSTGRESQL_RESTART_POLICY_CONDITION=any
POSTGRESQL_RESTART_POLICY_DELAY=5s
POSTGRESQL_RESTART_POLICY_MAX_ATTEMPTS=3
POSTGRESQL_MEMORY_LIMIT=512M
POSTGRESQL_ENV_FILE=.env.example
POSTGRESQL_DATA_HOST_PATH=data
POSTGRESQL_DATA_CONTAINER_PATH=/var/lib/postgresql/data
POSTGRESQL_DATA_VOLUME_NAME=postgresql_data
POSTGRESQL_DATA_VOLUME_EXTERNAL=false
POSTGRESQL_DATA_VOLUME_DRIVER=local
POSTGRESQL_DATA_VOLUME_DRIVER_TYPE=
POSTGRESQL_DATA_VOLUME_DRIVER_O=
POSTGRESQL_DATA_VOLUME_DRIVER_DEVICE=
POSTGRESQL_LOGS_HOST_PATH=logs
POSTGRESQL_LOGS_CONTAINER_PATH=/var/log/postgresql
POSTGRESQL_LOGS_VOLUME_NAME=postgresql_logs
POSTGRESQL_LOGS_VOLUME_EXTERNAL=false
POSTGRESQL_LOGS_VOLUME_DRIVER=local
POSTGRESQL_LOGS_VOLUME_DRIVER_TYPE=
POSTGRESQL_LOGS_VOLUME_DRIVER_O=
POSTGRESQL_LOGS_VOLUME_DRIVER_DEVICE=
POSTGRESQL_SCRIPTS_HOST_PATH=scripts
POSTGRESQL_SCRIPTS_CONTAINER_PATH=/docker-entrypoint-initdb.d
POSTGRESQL_SCRIPTS_VOLUME_NAME=postgresql_scripts
POSTGRESQL_SCRIPTS_VOLUME_EXTERNAL=false
POSTGRESQL_SCRIPTS_VOLUME_DRIVER=local
POSTGRESQL_SCRIPTS_VOLUME_DRIVER_TYPE=
POSTGRESQL_SCRIPTS_VOLUME_DRIVER_O=
POSTGRESQL_SCRIPTS_VOLUME_DRIVER_DEVICE=
POSTGRESQL_HOMEPAGE_ENABLED=true
POSTGRESQL_HOMEPAGE_GROUP=Database
POSTGRESQL_HOMEPAGE_ICON=postgresql.png
POSTGRESQL_HOMEPAGE_URL=
POSTGRESQL_HOMEPAGE_DESCRIPTION=
POSTGRESQL_HOMEPAGE_SITEMONITOR_URL=
POSTGRESQL_HOMEPAGE_PING=
