# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name


# Kibana — see kibana/.env.example
# Subpath supported (SERVER_BASEPATH + rewriteBasePath): keep KIBANA_BASE_PATH (Traefik) and KIBANA_SERVER_BASE_PATH aligned; empty/`/` = Host-only (set REWRITE=false).
# Optional vendor settings (e.g. XPACK_FLEET_ISAIRGAPPED, XPACK_FLEET_REGISTRYPROXYURL): add them to the file named by KIBANA_ENV_FILE.
APP_NAME=kibana
DEFAULT_NETWORK_NAME=kibana-network
DEFAULT_NETWORK_EXTERNAL=false
# Join Dokploy overlay: DEFAULT_NETWORK_NAME=dokploy-network (setup sets EXTERNAL=true).
KIBANA_IMAGE=docker.io/library/kibana:8.17.0
KIBANA_HOSTNAME=kibana
KIBANA_RESTART=unless-stopped
KIBANA_PRIVILEGED=false
KIBANA_ENV_FILE=.env.example
KIBANA_DOMAIN=kibana.example.com
KIBANA_BASE_PATH=/kibana
KIBANA_MIDDLEWARES=
KIBANA_APP_URL=http://kibana.example.com/kibana
KIBANA_ENTRYPOINTS=web
KIBANA_TLS_ENABLED=false
KIBANA_TLS_CERTRESOLVER=letsencrypt
KIBANA_TRAEFIK_LABELS_SWARM_ENABLE=true
KIBANA_TRAEFIK_LABELS_DOCKER_ENABLE=true
KIBANA_HTTP_PORT=5601
KIBANA_SERVER_BASE_PATH=/kibana
KIBANA_SERVER_REWRITE_BASE_PATH=true
KIBANA_ELASTICSEARCH_HOSTS=http://elasticsearch:9200
KIBANA_ELASTICSEARCH_USERNAME=kibana_system
KIBANA_ELASTICSEARCH_PASSWORD=ChangeMe
KIBANA_XPACK_SECURITY_ENCRYPTION_KEY=ChangeMeChangeMeChangeMeChangeMe00
KIBANA_XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTION_KEY=ChangeMeChangeMeChangeMeChangeMe00
KIBANA_XPACK_REPORTING_ENCRYPTION_KEY=ChangeMeChangeMeChangeMeChangeMe00
# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Multi-instance / Dokploy: use a distinct NAME per app (kibana_data_01, …).
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/kibana
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/kibana
#   External:              EXTERNAL=true   (pre-create: docker volume create kibana_data)
#   # KIBANA_DATA_VOLUME_TYPE=none
#   # KIBANA_DATA_VOLUME_OPTS=bind
#   # KIBANA_DATA_VOLUME_PATH=/appdata/kibana
KIBANA_DATA_VOLUME_NAME=kibana_data
KIBANA_DATA_VOLUME_EXTERNAL=false
KIBANA_DATA_VOLUME_DRIVER=local
KIBANA_DATA_VOLUME_TYPE=
KIBANA_DATA_VOLUME_OPTS=
KIBANA_DATA_VOLUME_PATH=
KIBANA_DATA_VOLUME_DIR=/usr/share/kibana/data
KIBANA_DEPLOY_MODE=replicated
KIBANA_DEPLOY_REPLICAS=1
KIBANA_MEMORY_LIMIT=1G
KIBANA_PLACEMENT_CONSTRAINTS=node.platform.os==linux
KIBANA_RESTART_POLICY_CONDITION=any
KIBANA_RESTART_POLICY_DELAY=5s
KIBANA_RESTART_POLICY_MAX_ATTEMPTS=3
KIBANA_HOMEPAGE_GROUP=Search
KIBANA_HOMEPAGE_NAME=Kibana
KIBANA_HOMEPAGE_ICON=kibana.png
KIBANA_HOMEPAGE_DESCRIPTION=Kibana UI
KIBANA_HOMEPAGE_URL=
KIBANA_HOMEPAGE_SITEMONITOR=http://kibana:5601/kibana/api/status
