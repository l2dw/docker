# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## POSTEIO — see posteio/.env.example

POSTEIO_IMAGE=docker.io/analogic/poste.io:latest
POSTEIO_RESTART=unless-stopped
POSTEIO_PRIVILEGED=false
POSTEIO_ENV_FILE=.env.example

POSTEIO_HOSTNAME=mail.example.com
POSTEIO_DOMAIN=mail.example.com
POSTEIO_BASE_PATH=/
POSTEIO_APP_URL=http://mail.example.com

POSTEIO_HTTPS=OFF
POSTEIO_DISABLE_CLAMAV=
POSTEIO_DISABLE_RSPAMD=

POSTEIO_TRAEFIK_LABELS_SWARM_ENABLE=true
POSTEIO_TRAEFIK_LABELS_DOCKER_ENABLE=true
POSTEIO_ENTRYPOINTS=web
POSTEIO_MIDDLEWARES=
POSTEIO_TLS_ENABLED=false
POSTEIO_TLS_CERTRESOLVER=letsencrypt

POSTEIO_DEPLOY_MODE=replicated
POSTEIO_DEPLOY_REPLICAS=1
POSTEIO_PLACEMENT_CONSTRAINTS=node.role==manager
POSTEIO_MEMORY_LIMIT=2G

POSTEIO_PORT_MODE=host
POSTEIO_PORT_SMTP=25
POSTEIO_PORT_SMTPS=465
POSTEIO_PORT_SUBMISSION=587
POSTEIO_PORT_IMAPS=993
POSTEIO_PORT_POP3S=995
POSTEIO_PORT_SIEVE=4190

POSTEIO_DATA_DIR=
POSTEIO_DATA_VOLUME_NAME=posteio-data
POSTEIO_DATA_VOLUME_EXTERNAL=false

POSTEIO_HOMEPAGE_GROUP=Mail
POSTEIO_HOMEPAGE_NAME=Poste.io
POSTEIO_HOMEPAGE_ICON=mail.png
POSTEIO_HOMEPAGE_DESCRIPTION=Mail server admin and webmail
POSTEIO_HOMEPAGE_SITEMONITOR=http://posteio:80

