# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK=dokploy-network
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name

USER_UID= # default: 1000, echo $(id -u) to get the current user's UID
USER_GID= # default: 1000, echo $(id -g) to get the current user's GID
USER_NAME= # default: jenkins, echo $(id -un) to get the current user's name
TZ=America/Montreal
DEFAULT_NETWORK=dokploy-network
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock
NODE_ENV=production

ADMIN_USER=admin # default: ubuntu, echo $(id -un) to get the current user's name

INFRA_DIR=/infra
APPDATA_DIR=/appdata
CERTS_DIR=/appdata/certs
BACKUPS_DIR=/appdata/backups
LOGS_DIR=/appdata/logs

# Docker Registry
DOCKER_REGISTRY_HOST=registry.cloud-name
DOCKER_REGISTRY_USER=docker-username
DOCKER_REGISTRY_PASS=docker-password

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## RIE configuration
RIE_VERSION=1.1.0
RIE_IMAGE=atelier.cen.umontreal.ca/rie/rie-fullstack:latest
RIE_ENV_NAME=spider-dev
RIE_NETWORK_ALIAS=rie-app


## Stack configuration
RIE_PLACEMENT_NODE_ROLE=manager
RIE_REPLICAS=1
## Memory configuration
RIE_MEMORY_LIMIT=512M
RIE_CPU_LIMIT=1
RIE_TTY=true # raw, console, true
RIE_STDIN_OPEN=true # true, false
RIE_PULL_POLICY=always # always, never, if-not-present
RIE_RESTART=unless-stopped # unless-stopped, always, no
RIE_PRIVILEGED=true # true, false

## Volume configuration
RIE_MOUNT_DATA=
RIE_DATA_VOLUME_NAME=
RIE_DATA_VOLUME_EXTERNAL=

## RIE Workspace configuration
RIE_WORKSPACE_IMAGE=atelier.cen.umontreal.ca/rie/rie-fullstack:workspace
RIE_WORKSPACE_PLACEMENT_NODE_ROLE=manager
RIE_WORKSPACE_REPLICAS=1

## Database configuration
RIE_POSTGRESQL_IMAGE=docker.io/postgres:15
RIE_POSTGRESQL_MOUNT_DATA=
RIE_POSTGRESQL_NETWORK_ALIAS=
RIE_DATABASE_NAME=rie
RIE_DATABASE_USER=rie
RIE_DATABASE_PASSWORD=rie123
RIE_DATABASE_HOST=rie-postgresql
RIE_DATABASE_PORT=5432

## RIE Image configuration
RIE_ENABLE_SERVICE_WEB_APP=true # true, false
RIE_ENABLE_SERVICE_API=true # true, false
RIE_NETWORK_ALIAS= # rie-app, rie-workspace

## Posthog configuration
RIE_POSTHOG_KEY=your-posthog-api-key
RIE_POSTHOG_HOST=https://us.i.posthog.com

## API configuration
RIE_API_BASE_PATH=/api
RIE_API_PORT=4000
RIE_API_DOMAIN=rie.example.com
RIE_API_URL=http://rie.example.com/api
RIE_API_HTTP_PROTOCOL=https
RIE_API_HTTP_HOST=rie.example.com
RIE_API_HTTP_PORT=443
# Client configuration
RIE_CLIENT_DOMAIN=rie.example.com
RIE_CLIENT_BASE_PATH=/
RIE_CLIENT_ORIGIN_URL=http://rie.example.com/
RIE_CLIENT_PORT=3000
RIE_CLIENT_HTTP_PROTOCOL=https
RIE_CLIENT_HTTP_HOST=rie.example.com
RIE_CLIENT_HTTP_PORT=443
## Authentication
RIE_MICROSOFT_TENANT_ID=your-microsoft-tenant-id
RIE_MICROSOFT_CLIENT_ID=your-microsoft-client-id
RIE_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
RIE_BETTER_AUTH_SECRET=your-better-auth-secret--long-32
# Logging and telemetry
RIE_LOG_LEVEL=info
RIE_OTEL_API_ENABLED=true
RIE_OTEL_CLIENT_ENABLED=true
RIE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# S3 Storage client
RIE_S3_ENDPOINT=https://s3.example.com
RIE_S3_ACCESS_KEY=your-s3-access-key
RIE_S3_SECRET_KEY=your-s3-secret-key
RIE_S3_PROVIDER=minio # minio, aws .
RIE_S3_USE_SSL=true
RIE_S3_REGION=your-s3-region
RIE_S3_BUCKET=rie-spider-dev
## Traefik configuration
RIE_TRAEFIK_ENABLE=true # true, false
RIE_TRAEFIK_SERVER_PORT=4000 # 3000 for web app
RIE_TRAEFIK_ENTRYPOINTS=web
RIE_TRAEFIK_MIDDLEWARES=
RIE_TRAEFIK_TLS_ENABLED=false
RIE_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
RIE_TRAEFIK_DOMAIN=rie.example.com
RIE_TRAEFIK_BASE_PATH=/
## Homepage configuration
RIE_HOMEPAGE_ENABLED=true # true, false
RIE_HOMEPAGE_GROUP=RIÉ
RIE_HOMEPAGE_NAME=RIÉ
RIE_HOMEPAGE_ICON=
RIE_HOMEPAGE_HREF=http://rie.example.com/
RIE_HOMEPAGE_DESCRIPTION=
RIE_HOMEPAGE_SITEMONITOR=http://rie.example.com/
RIE_HOMEPAGE_PING=
