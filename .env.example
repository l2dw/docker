# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## Arcane (https://getarcane.app/docs/setup/installation)
# openssl rand -hex 32  →  ARCANE_ENCRYPTION_KEY and ARCANE_JWT_SECRET
ARCANE_IMAGE=ghcr.io/getarcaneapp/manager:latest
ARCANE_RESTART=unless-stopped
ARCANE_PRIVILEGED=false
ARCANE_PUID=1000
ARCANE_PGID=1000
ARCANE_DOMAIN=arcane.example.com
# Subpath deploy is NOT supported by Arcane — keep / and use a subdomain (Host-only Traefik rule).
ARCANE_BASE_PATH=/
ARCANE_APP_URL=http://arcane.example.com
# CIDR of the Docker/Traefik network (X-Forwarded-* / rate limits). See reverse-proxy docs.
ARCANE_TRUSTED_PROXIES=172.16.0.0/12
ARCANE_TRAEFIK_LABELS_SWARM_ENABLE=true
ARCANE_TRAEFIK_LABELS_DOCKER_ENABLE=true
ARCANE_ENTRYPOINTS=web
ARCANE_MIDDLEWARES=
ARCANE_TLS_ENABLED=false
ARCANE_TLS_CERTRESOLVER=letsencrypt
ARCANE_ENCRYPTION_KEY=
ARCANE_JWT_SECRET=
ARCANE_DEPLOY_MODE=replicated
ARCANE_DEPLOY_REPLICAS=1
ARCANE_PLACEMENT_CONSTRAINTS=node.role==manager
ARCANE_MEMORY_LIMIT=512M
ARCANE_DATA_DIR=
ARCANE_DATA_VOLUME_NAME=arcane-data
ARCANE_DATA_VOLUME_EXTERNAL=false
ARCANE_BUILDS_DIR=
ARCANE_BUILDS_VOLUME_NAME=arcane-builds
ARCANE_BUILDS_VOLUME_EXTERNAL=false
ARCANE_BACKUPS_DIR=
ARCANE_BACKUPS_VOLUME_NAME=arcane-backups
ARCANE_BACKUPS_VOLUME_EXTERNAL=false
ARCANE_HOMEPAGE_GROUP=Infra
ARCANE_HOMEPAGE_NAME=Arcane
ARCANE_HOMEPAGE_ICON=arcane.png
ARCANE_HOMEPAGE_HREF=http://arcane.example.com
ARCANE_HOMEPAGE_DESCRIPTION=Modern Docker management UI
ARCANE_HOMEPAGE_SITEMONITOR=http://arcane:3552

# Edge agent (arcane/agent-compose.yml)
ARCANE_AGENT_IMAGE=ghcr.io/getarcaneapp/agent:latest
ARCANE_AGENT_RESTART=unless-stopped
ARCANE_AGENT_PRIVILEGED=false
ARCANE_AGENT_ENV_FILE=.env.example
ARCANE_EDGE_AGENT=true
ARCANE_EDGE_TRANSPORT=poll
ARCANE_AGENT_TOKEN=
ARCANE_MANAGER_API_URL=http://arcane.example.com
ARCANE_AGENT_DEPLOY_MODE=replicated
ARCANE_AGENT_DEPLOY_REPLICAS=1
ARCANE_AGENT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
ARCANE_AGENT_MEMORY_LIMIT=256M
ARCANE_AGENT_DATA_DIR=
ARCANE_AGENT_DATA_VOLUME_NAME=arcane-agent-data
ARCANE_AGENT_DATA_VOLUME_EXTERNAL=false
