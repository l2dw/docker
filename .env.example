# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=false
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name

# # default: 1000, echo $(id -u) to get the current user's UID
# USER_UID=
# # default: 1000, echo $(id -g) to get the current user's GID
# USER_GID=
# # default: jenkins, echo $(id -un) to get the current   user's name
# USER_NAME=
# # default: admin, echo $(id -un) to get the current user's name
# ADMIN_USER=

INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## ADGUARD — see adguard/.env.example

ADGUARD_IMAGE=docker.io/adguard/adguardhome:latest
ADGUARD_RESTART=unless-stopped
ADGUARD_PRIVILEGED=false
ADGUARD_ENV_FILE=.env.example

ADGUARD_DOMAIN=adguard.example.com
ADGUARD_BASE_PATH=/
ADGUARD_APP_URL=http://adguard.example.com

ADGUARD_TRAEFIK_LABELS_SWARM_ENABLE=true
ADGUARD_TRAEFIK_LABELS_DOCKER_ENABLE=true
ADGUARD_ENTRYPOINTS=web
ADGUARD_MIDDLEWARES=
ADGUARD_TLS_ENABLED=false
ADGUARD_TLS_CERTRESOLVER=letsencrypt

ADGUARD_DEPLOY_MODE=replicated
ADGUARD_DEPLOY_REPLICAS=1
ADGUARD_PLACEMENT_CONSTRAINTS=node.role==manager
ADGUARD_MEMORY_LIMIT=512M

ADGUARD_PORT_DNS_TCP=53
ADGUARD_PORT_DNS_UDP=53
ADGUARD_PORT_DNS_MODE=host
ADGUARD_PORT_SETUP=3053
ADGUARD_PORT_SETUP_MODE=host

ADGUARD_CONF_DIR=
ADGUARD_CONF_VOLUME_NAME=adguard-conf
ADGUARD_CONF_VOLUME_EXTERNAL=false
ADGUARD_WORK_DIR=
ADGUARD_WORK_VOLUME_NAME=adguard-work
ADGUARD_WORK_VOLUME_EXTERNAL=false

ADGUARD_HOMEPAGE_GROUP=Infra
ADGUARD_HOMEPAGE_NAME=AdGuard Home
ADGUARD_HOMEPAGE_ICON=adguard.png
ADGUARD_HOMEPAGE_DESCRIPTION=Network-wide ad blocking DNS
ADGUARD_HOMEPAGE_SITEMONITOR=http://adguard:80
