# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## HEDGEDOC — see hedgedoc/.env.example (external Postgres)

HEDGEDOC_IMAGE=quay.io/hedgedoc/hedgedoc:1.11.1
HEDGEDOC_RESTART=unless-stopped
HEDGEDOC_PRIVILEGED=false
HEDGEDOC_ENV_FILE=.env.example

HEDGEDOC_BASE_PATH=/
HEDGEDOC_URL_PATH=
HEDGEDOC_DOMAIN=hedgedoc.example.com
HEDGEDOC_PROTOCOL_USESSL=false
HEDGEDOC_URL_ADDPORT=false
HEDGEDOC_SESSION_SECRET=ChangeMe

HEDGEDOC_DB_URL=postgres://hedgedoc:ChangeMe@dokploy-postgresql:5432/hedgedoc

HEDGEDOC_UPLOADS_DIR=
HEDGEDOC_UPLOADS_VOLUME_NAME=hedgedoc_uploads
HEDGEDOC_UPLOADS_VOLUME_EXTERNAL=false

HEDGEDOC_TRAEFIK_LABELS_SWARM_ENABLE=true
HEDGEDOC_TRAEFIK_LABELS_DOCKER_ENABLE=true
HEDGEDOC_ENTRYPOINTS=web
HEDGEDOC_MIDDLEWARES=
HEDGEDOC_TLS_ENABLED=false
HEDGEDOC_TLS_CERTRESOLVER=letsencrypt

HEDGEDOC_DEPLOY_MODE=replicated
HEDGEDOC_DEPLOY_REPLICAS=1
HEDGEDOC_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HEDGEDOC_MEMORY_LIMIT=512M

HEDGEDOC_HOMEPAGE_GROUP=Notes
HEDGEDOC_HOMEPAGE_NAME=HedgeDoc
HEDGEDOC_HOMEPAGE_ICON=hedgedoc.png
HEDGEDOC_HOMEPAGE_HREF=http://hedgedoc.example.com/
HEDGEDOC_HOMEPAGE_DESCRIPTION=Collaborative markdown
HEDGEDOC_HOMEPAGE_SITEMONITOR=http://hedgedoc:3000

