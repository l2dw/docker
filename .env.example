# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

# Plane Community Edition — app services only. Postgres / Redis / RabbitMQ / S3 are external.
# Placeholder values only. Production: PLANE_*_ENV_FILE=.env
APP_NAME=plane
DEFAULT_NETWORK_NAME=plane-network
DEFAULT_NETWORK_EXTERNAL=false

PLANE_RESTART=unless-stopped
PLANE_PRIVILEGED=false

PLANE_WEB_IMAGE=docker.io/makeplane/plane-frontend:stable
PLANE_SPACE_IMAGE=docker.io/makeplane/plane-space:stable
PLANE_ADMIN_IMAGE=docker.io/makeplane/plane-admin:stable
PLANE_LIVE_IMAGE=docker.io/makeplane/plane-live:stable
PLANE_API_IMAGE=docker.io/makeplane/plane-backend:stable
PLANE_WORKER_IMAGE=docker.io/makeplane/plane-backend:stable
PLANE_BEAT_WORKER_IMAGE=docker.io/makeplane/plane-backend:stable
PLANE_MIGRATOR_IMAGE=docker.io/makeplane/plane-backend:stable

# Public URL (subdomain). Subpath deploy is unsupported — keep BASE_PATH=/
PLANE_DOMAIN=plane.example.com
PLANE_BASE_PATH=/
PLANE_APP_URL=http://plane.example.com
PLANE_CORS_ALLOWED_ORIGINS=http://plane.example.com
PLANE_ENTRYPOINTS=web
PLANE_MIDDLEWARES=
PLANE_TLS_ENABLED=false
PLANE_TLS_CERTRESOLVER=letsencrypt
PLANE_TRAEFIK_LABELS_SWARM_ENABLE=true
PLANE_TRAEFIK_LABELS_DOCKER_ENABLE=true

PLANE_WEB_PORT=3000
PLANE_SPACE_PORT=3000
PLANE_ADMIN_PORT=3000
PLANE_LIVE_PORT=3000
PLANE_API_PORT=8000

PLANE_DEBUG=0
PLANE_GUNICORN_WORKERS=1
# USE_MINIO=1 for MinIO-compatible path-style; 0 for AWS S3
PLANE_USE_MINIO=1
PLANE_MINIO_ENDPOINT_SSL=0
PLANE_FILE_SIZE_LIMIT=5242880
PLANE_API_KEY_RATE_LIMIT=60/minute
PLANE_AUTHENTICATION_RATE_LIMIT=10/minute
PLANE_WEBHOOK_ALLOWED_IPS=
PLANE_WEBHOOK_ALLOWED_HOSTS=
PLANE_API_BASE_URL=http://api:8000

# Secrets — make plane-setup generates missing ones (except AWS key if set)
PLANE_SECRET_KEY=ChangeMe
PLANE_LIVE_SERVER_SECRET_KEY=ChangeMe

# —— External dependencies (required) ——————————————————
# Reachable from the Plane network (e.g. dokploy-network / shared overlay).
PLANE_PGHOST=postgres
PLANE_PGDATABASE=plane
PLANE_POSTGRES_USER=plane
PLANE_POSTGRES_PASSWORD=ChangeMe
PLANE_POSTGRES_DB=plane
PLANE_POSTGRES_PORT=5432
PLANE_DATABASE_URL=postgresql://plane:ChangeMe@postgres:5432/plane

PLANE_REDIS_HOST=redis
PLANE_REDIS_PORT=6379
PLANE_REDIS_URL=redis://redis:6379/

PLANE_RABBITMQ_HOST=rabbitmq
PLANE_RABBITMQ_PORT=5672
PLANE_RABBITMQ_USER=plane
PLANE_RABBITMQ_PASSWORD=ChangeMe
PLANE_RABBITMQ_VHOST=plane
PLANE_AMQP_URL=amqp://plane:ChangeMe@rabbitmq:5672/plane

PLANE_AWS_REGION=
PLANE_AWS_ACCESS_KEY_ID=access-key
PLANE_AWS_SECRET_ACCESS_KEY=ChangeMe
PLANE_S3_ENDPOINT_URL=http://minio:9000
PLANE_S3_BUCKET_NAME=uploads

# env_file paths (relative to plane/)
PLANE_WEB_ENV_FILE=.env.example
PLANE_SPACE_ENV_FILE=.env.example
PLANE_ADMIN_ENV_FILE=.env.example
PLANE_LIVE_ENV_FILE=.env.example
PLANE_API_ENV_FILE=.env.example
PLANE_WORKER_ENV_FILE=.env.example
PLANE_BEAT_WORKER_ENV_FILE=.env.example
PLANE_MIGRATOR_ENV_FILE=.env.example

# Deploy / memory (per role)
PLANE_WEB_DEPLOY_MODE=replicated
PLANE_WEB_DEPLOY_REPLICAS=1
PLANE_WEB_MEMORY_LIMIT=1G
PLANE_WEB_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PLANE_WEB_RESTART_POLICY_CONDITION=any
PLANE_WEB_RESTART_POLICY_DELAY=5s
PLANE_WEB_RESTART_POLICY_MAX_ATTEMPTS=3

PLANE_SPACE_DEPLOY_MODE=replicated
PLANE_SPACE_DEPLOY_REPLICAS=1
PLANE_SPACE_MEMORY_LIMIT=1G
PLANE_SPACE_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PLANE_SPACE_RESTART_POLICY_CONDITION=any
PLANE_SPACE_RESTART_POLICY_DELAY=5s
PLANE_SPACE_RESTART_POLICY_MAX_ATTEMPTS=3

PLANE_ADMIN_DEPLOY_MODE=replicated
PLANE_ADMIN_DEPLOY_REPLICAS=1
PLANE_ADMIN_MEMORY_LIMIT=1G
PLANE_ADMIN_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PLANE_ADMIN_RESTART_POLICY_CONDITION=any
PLANE_ADMIN_RESTART_POLICY_DELAY=5s
PLANE_ADMIN_RESTART_POLICY_MAX_ATTEMPTS=3

PLANE_LIVE_DEPLOY_MODE=replicated
PLANE_LIVE_DEPLOY_REPLICAS=1
PLANE_LIVE_MEMORY_LIMIT=1G
PLANE_LIVE_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PLANE_LIVE_RESTART_POLICY_CONDITION=any
PLANE_LIVE_RESTART_POLICY_DELAY=5s
PLANE_LIVE_RESTART_POLICY_MAX_ATTEMPTS=3

PLANE_API_DEPLOY_MODE=replicated
PLANE_API_DEPLOY_REPLICAS=1
PLANE_API_MEMORY_LIMIT=1G
PLANE_API_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PLANE_API_RESTART_POLICY_CONDITION=any
PLANE_API_RESTART_POLICY_DELAY=5s
PLANE_API_RESTART_POLICY_MAX_ATTEMPTS=3

PLANE_WORKER_DEPLOY_MODE=replicated
PLANE_WORKER_DEPLOY_REPLICAS=1
PLANE_WORKER_MEMORY_LIMIT=1G
PLANE_WORKER_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PLANE_WORKER_RESTART_POLICY_CONDITION=any
PLANE_WORKER_RESTART_POLICY_DELAY=5s
PLANE_WORKER_RESTART_POLICY_MAX_ATTEMPTS=3

PLANE_BEAT_WORKER_DEPLOY_MODE=replicated
PLANE_BEAT_WORKER_DEPLOY_REPLICAS=1
PLANE_BEAT_WORKER_MEMORY_LIMIT=1G
PLANE_BEAT_WORKER_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PLANE_BEAT_WORKER_RESTART_POLICY_CONDITION=any
PLANE_BEAT_WORKER_RESTART_POLICY_DELAY=5s
PLANE_BEAT_WORKER_RESTART_POLICY_MAX_ATTEMPTS=3

PLANE_MIGRATOR_DEPLOY_MODE=replicated
PLANE_MIGRATOR_DEPLOY_REPLICAS=1
PLANE_MIGRATOR_MEMORY_LIMIT=1G
PLANE_MIGRATOR_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PLANE_MIGRATOR_RESTART_POLICY_CONDITION=on-failure
PLANE_MIGRATOR_RESTART_POLICY_DELAY=5s
PLANE_MIGRATOR_RESTART_POLICY_MAX_ATTEMPTS=3

PLANE_HOMEPAGE_GROUP=Productivity
PLANE_HOMEPAGE_NAME=Plane
PLANE_HOMEPAGE_ICON=plane.png
PLANE_HOMEPAGE_DESCRIPTION=Project management
PLANE_HOMEPAGE_URL=
PLANE_HOMEPAGE_SITEMONITOR=http://web:3000
