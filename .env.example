# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name


# prometheus-agent
PROMETHEUS_AGENT_IMAGE=docker.io/prom/prometheus:v3.16.0
PROMETHEUS_AGENT_NODE_EXPORTER_IMAGE=docker.io/prom/node-exporter:v1.12.1
PROMETHEUS_AGENT_RESTART=unless-stopped
PROMETHEUS_AGENT_PRIVILEGED=false
PROMETHEUS_AGENT_NODE_EXPORTER_PRIVILEGED=false
PROMETHEUS_AGENT_ENV_FILE=.env.example
PROMETHEUS_AGENT_NODE_EXPORTER_ENV_FILE=.env.example
PROMETHEUS_AGENT_CLUSTER=example-node
PROMETHEUS_AGENT_REMOTE_WRITE_URL=https://prometheus.example.com/prometheus/api/v1/write
PROMETHEUS_AGENT_REMOTE_WRITE_USERNAME=example-node
PROMETHEUS_AGENT_REMOTE_WRITE_INSECURE=true
PROMETHEUS_AGENT_SCRAPE_INTERVAL=30s
PROMETHEUS_AGENT_PORT=9090
PROMETHEUS_AGENT_NODE_EXPORTER_PORT=9100
PROMETHEUS_AGENT_DATA_VOLUME_NAME=prometheus_agent_data
PROMETHEUS_AGENT_DATA_VOLUME_EXTERNAL=false
PROMETHEUS_AGENT_DATA_VOLUME_DRIVER=local
PROMETHEUS_AGENT_DATA_VOLUME_TYPE=
PROMETHEUS_AGENT_DATA_VOLUME_OPTS=
PROMETHEUS_AGENT_DATA_VOLUME_PATH=
PROMETHEUS_AGENT_DATA_VOLUME_DIR=/prometheus
PROMETHEUS_AGENT_DEPLOY_MODE=replicated
PROMETHEUS_AGENT_DEPLOY_REPLICAS=1
PROMETHEUS_AGENT_MEMORY_LIMIT=1G
PROMETHEUS_AGENT_NODE_EXPORTER_DEPLOY_MODE=global
PROMETHEUS_AGENT_NODE_EXPORTER_MEMORY_LIMIT=256M
PROMETHEUS_AGENT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PROMETHEUS_AGENT_NODE_EXPORTER_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PROMETHEUS_AGENT_RESTART_POLICY_CONDITION=any
PROMETHEUS_AGENT_RESTART_POLICY_DELAY=5s
PROMETHEUS_AGENT_RESTART_POLICY_MAX_ATTEMPTS=3
PROMETHEUS_AGENT_HOMEPAGE_GROUP=Search
PROMETHEUS_AGENT_HOMEPAGE_NAME=Prometheus Agent
PROMETHEUS_AGENT_HOMEPAGE_ICON=prometheus.png
PROMETHEUS_AGENT_HOMEPAGE_DESCRIPTION=Prometheus agent (remote_write of node metrics)
PROMETHEUS_AGENT_HOMEPAGE_URL=
PROMETHEUS_AGENT_HOMEPAGE_SITEMONITOR=http://prometheus-agent:9090/-/healthy
