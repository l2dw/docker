# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## MEILISEARCH — see meilisearch/.env.example

MEILISEARCH_IMAGE=docker.io/getmeili/meilisearch:v1.37
MEILISEARCH_RESTART=unless-stopped
MEILISEARCH_PRIVILEGED=false
MEILISEARCH_ENV_FILE=.env.example
MEILISEARCH_BASE_PATH=/meilisearch

MEILISEARCH_DOMAIN=meilisearch.example.com
MEILISEARCH_APP_URL=http://meilisearch.example.com/meilisearch

MEILISEARCH_MASTER_KEY=

MEILISEARCH_ENV=production
MEILISEARCH_NO_ANALYTICS=true
MEILISEARCH_HTTP_ADDR=0.0.0.0:7700
MEILISEARCH_NETWORK_ALIAS=meilisearch

MEILISEARCH_TRAEFIK_LABELS_SWARM_ENABLE=true
MEILISEARCH_TRAEFIK_LABELS_DOCKER_ENABLE=true
MEILISEARCH_ENTRYPOINTS=web
MEILISEARCH_MIDDLEWARES=stripprefix-meilisearch
MEILISEARCH_TLS_ENABLED=false
MEILISEARCH_TLS_CERTRESOLVER=letsencrypt

MEILISEARCH_DEPLOY_MODE=replicated
MEILISEARCH_DEPLOY_REPLICAS=1
MEILISEARCH_PLACEMENT_CONSTRAINTS=node.platform.os==linux
MEILISEARCH_MEMORY_LIMIT=512M

MEILISEARCH_DATA_DIR=
MEILISEARCH_DATA_VOLUME_NAME=meilisearch-data
MEILISEARCH_DATA_VOLUME_EXTERNAL=false

MEILISEARCH_HOMEPAGE_GROUP=Search
MEILISEARCH_HOMEPAGE_NAME=Meilisearch
MEILISEARCH_HOMEPAGE_ICON=meilisearch.png
MEILISEARCH_HOMEPAGE_DESCRIPTION=Search engine
MEILISEARCH_HOMEPAGE_SITEMONITOR=http://meilisearch:7700/health

