# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Toronto
DEFAULT_NETWORK_NAME=registry-network
DEFAULT_NETWORK_EXTERNAL=false
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name

INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker CLI login (make docker-login) — can match REGISTRY_USER_* below
DOCKER_REGISTRY_HOST=registry.example.com
DOCKER_REGISTRY_USER=dockeradm
DOCKER_REGISTRY_PASS=ChangeMe

## REGISTRY
REGISTRY_IMAGE=docker.io/library/registry:2
REGISTRY_RESTART=unless-stopped
REGISTRY_PRIVILEGED=false
REGISTRY_ENV_FILE=.env.example
REGISTRY_MEMORY_LIMIT=1G

REGISTRY_HOST_PORT=5000
REGISTRY_PORT_MODE=ingress

REGISTRY_DOMAIN=registry.example.com
REGISTRY_BASE_PATH=/
REGISTRY_APP_URL=http://registry.example.com

REGISTRY_HTTP_SECRET=
REGISTRY_HTTP_RELATIVEURLS=true

REGISTRY_USER_NAME=dockeradm
REGISTRY_USER_PASS=ChangeMe

REGISTRY_AUTH=htpasswd
REGISTRY_AUTH_HTPASSWD_REALM=Registry Realm
REGISTRY_AUTH_HTPASSWD_PATH=/auth/htpasswd

REGISTRY_STORAGE_DELETE_ENABLED=true
REGISTRY_HEALTH_STORAGEDRIVER_ENABLED=true

REGISTRY_TRAEFIK_LABELS_SWARM_ENABLE=false
REGISTRY_TRAEFIK_LABELS_DOCKER_ENABLE=false
REGISTRY_ENTRYPOINTS=web
REGISTRY_MIDDLEWARES=
REGISTRY_TLS_ENABLED=false
REGISTRY_TLS_CERTRESOLVER=letsencrypt

REGISTRY_DEPLOY_MODE=replicated
REGISTRY_DEPLOY_REPLICAS=1
REGISTRY_PLACEMENT_CONSTRAINTS=node.platform.os==linux

REGISTRY_DATA_DIR=
REGISTRY_DATA_VOLUME_NAME=registry_data
REGISTRY_DATA_VOLUME_EXTERNAL=false
REGISTRY_DATA_VOLUME_DRIVER=local
REGISTRY_DATA_DRIVER_TYPE=
REGISTRY_DATA_DRIVER_O=
REGISTRY_DATA_DRIVER_DEVICE=

REGISTRY_HOMEPAGE_GROUP=Infra
REGISTRY_HOMEPAGE_NAME=Registry
REGISTRY_HOMEPAGE_ICON=registry.png
REGISTRY_HOMEPAGE_DESCRIPTION=Docker Registry v2
REGISTRY_HOMEPAGE_SITEMONITOR=http://registry:5000
