# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

# CockroachDB — see cockroach/.env.example
APP_NAME=cockroach
DEFAULT_NETWORK_NAME=cockroach-network
DEFAULT_NETWORK_EXTERNAL=false

COCKROACH_IMAGE=docker.io/cockroachdb/cockroach:v24.2.4
COCKROACH_HOSTNAME=cockroach
COCKROACH_ADVERTISE_ADDR=cockroach
COCKROACH_ALIAS=cockroach
COCKROACH_RESTART=unless-stopped
COCKROACH_PRIVILEGED=false
COCKROACH_ENV_FILE=.env.example

# DB Console (Traefik HTTP :8080). Subpath unsupported — keep BASE_PATH=/
COCKROACH_DOMAIN=cockroach.example.com
COCKROACH_BASE_PATH=/
COCKROACH_APP_URL=http://cockroach.example.com/
COCKROACH_ENTRYPOINTS=web
COCKROACH_MIDDLEWARES=
COCKROACH_TLS_ENABLED=false
COCKROACH_TLS_CERTRESOLVER=letsencrypt
COCKROACH_TRAEFIK_LABELS_SWARM_ENABLE=true
COCKROACH_TRAEFIK_LABELS_DOCKER_ENABLE=true
COCKROACH_HTTP_PORT=8080

# SQL (published TCP in both compose files)
COCKROACH_SQL_PORT=26257
COCKROACH_SQL_PUBLISHED_PORT=26257
COCKROACH_SQL_PORT_MODE=ingress
COCKROACH_SQL_PORT_PROTOCOL=tcp

# First-boot user / database (official image env)
COCKROACH_DATABASE=defaultdb
COCKROACH_USER=selfhost
COCKROACH_PASSWORD=ChangeMe

# Volumes
COCKROACH_DATA_VOLUME_NAME=cockroach_data
COCKROACH_DATA_VOLUME_EXTERNAL=false
COCKROACH_DATA_VOLUME_DRIVER=local
COCKROACH_DATA_VOLUME_TYPE=
COCKROACH_DATA_VOLUME_OPTS=
COCKROACH_DATA_VOLUME_PATH=
COCKROACH_DATA_VOLUME_DIR=/cockroach/cockroach-data

COCKROACH_CERTS_VOLUME_NAME=cockroach_certs
COCKROACH_CERTS_VOLUME_EXTERNAL=false
COCKROACH_CERTS_VOLUME_DRIVER=local
COCKROACH_CERTS_VOLUME_TYPE=
COCKROACH_CERTS_VOLUME_OPTS=
COCKROACH_CERTS_VOLUME_PATH=
COCKROACH_CERTS_VOLUME_DIR=/cockroach/certs

COCKROACH_DEPLOY_MODE=replicated
COCKROACH_DEPLOY_REPLICAS=1
COCKROACH_MEMORY_LIMIT=2G
COCKROACH_PLACEMENT_CONSTRAINTS=node.platform.os==linux
COCKROACH_RESTART_POLICY_CONDITION=any
COCKROACH_RESTART_POLICY_DELAY=5s
COCKROACH_RESTART_POLICY_MAX_ATTEMPTS=3

COCKROACH_HOMEPAGE_GROUP=Infrastructure
COCKROACH_HOMEPAGE_NAME=CockroachDB
COCKROACH_HOMEPAGE_ICON=cockroachdb.png
COCKROACH_HOMEPAGE_DESCRIPTION=Distributed SQL
COCKROACH_HOMEPAGE_URL=
COCKROACH_HOMEPAGE_SITEMONITOR=http://cockroach:8080/health
