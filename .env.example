# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name


# Elasticsearch — see elasticsearch/.env.example
APP_NAME=elasticsearch
DEFAULT_NETWORK_NAME=elasticsearch-network
DEFAULT_NETWORK_EXTERNAL=false

ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.17.4
ELASTICSEARCH_HOSTNAME=elasticsearch
ELASTICSEARCH_RESTART=unless-stopped
ELASTICSEARCH_PRIVILEGED=false
ELASTICSEARCH_ENV_FILE=.env.example
ELASTICSEARCH_NETWORK_ALIAS=dokploy-elasticsearch

ELASTICSEARCH_DOMAIN=elasticsearch.example.com
ELASTICSEARCH_BASE_PATH=/elasticsearch
ELASTICSEARCH_APP_URL=http://elasticsearch.example.com/elasticsearch
ELASTICSEARCH_ENTRYPOINTS=web
ELASTICSEARCH_MIDDLEWARES=elasticsearch-strip
ELASTICSEARCH_TLS_ENABLED=false
ELASTICSEARCH_TLS_CERTRESOLVER=letsencrypt
ELASTICSEARCH_TRAEFIK_LABELS_SWARM_ENABLE=true
ELASTICSEARCH_TRAEFIK_LABELS_DOCKER_ENABLE=true
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_HTTP_PUBLISHED_PORT=9200
ELASTICSEARCH_HTTP_PORT_MODE=ingress
ELASTICSEARCH_HTTP_PORT_PROTOCOL=tcp

# Single-node (default): DISCOVERY_TYPE=single-node
# Multi-node: set DISCOVERY_TYPE= (empty) and add ONLY non-empty literal ES settings in .env, e.g.:
#   discovery.seed_hosts=elasticsearch-01,elasticsearch-02,elasticsearch-03
#   cluster.initial_master_nodes=elasticsearch-01,elasticsearch-02,elasticsearch-03
# Do not leave seed_hosts / initial_master_nodes empty — ES exits with null-valued setting (exit 70).
ELASTICSEARCH_DISCOVERY_TYPE=single-node
ELASTICSEARCH_CLUSTER_NAME=elasticsearch
ELASTICSEARCH_NODE_NAME=elasticsearch
ELASTICSEARCH_XPACK_SECURITY_ENABLED=false
ELASTICSEARCH_XPACK_SECURITY_HTTP_SSL_ENABLED=false
ELASTICSEARCH_XPACK_ML_ENABLED=false
ELASTICSEARCH_BOOTSTRAP_MEMORY_LOCK=false
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# healthcheck wait_for_status: green | yellow | red (default yellow — single-node often never reaches green)
ELASTICSEARCH_HEALTHCHECK_WAIT_FOR_STATUS=yellow

ELASTICSEARCH_MEMLOCK_SOFT=-1
ELASTICSEARCH_MEMLOCK_HARD=-1
ELASTICSEARCH_NOFILE_SOFT=65536
ELASTICSEARCH_NOFILE_HARD=65536

# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Multi-node Dokploy: use a distinct NAME per app (elasticsearch_data_01, …).
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/elasticsearch
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/elasticsearch
#   External:              EXTERNAL=true   (pre-create: docker volume create elasticsearch_data)
#   # ELASTICSEARCH_DATA_VOLUME_TYPE=none
#   # ELASTICSEARCH_DATA_VOLUME_OPTS=bind
#   # ELASTICSEARCH_DATA_VOLUME_PATH=/appdata/elasticsearch
ELASTICSEARCH_DATA_VOLUME_NAME=elasticsearch_data
ELASTICSEARCH_DATA_VOLUME_EXTERNAL=false
ELASTICSEARCH_DATA_VOLUME_DRIVER=local
ELASTICSEARCH_DATA_VOLUME_TYPE=
ELASTICSEARCH_DATA_VOLUME_OPTS=
ELASTICSEARCH_DATA_VOLUME_PATH=
ELASTICSEARCH_DATA_VOLUME_DIR=/usr/share/elasticsearch/data

ELASTICSEARCH_DEPLOY_MODE=replicated
ELASTICSEARCH_DEPLOY_REPLICAS=1
ELASTICSEARCH_MEMORY_LIMIT=1G
ELASTICSEARCH_PLACEMENT_CONSTRAINTS=node.platform.os==linux
ELASTICSEARCH_RESTART_POLICY_CONDITION=any
ELASTICSEARCH_RESTART_POLICY_DELAY=5s
ELASTICSEARCH_RESTART_POLICY_MAX_ATTEMPTS=3

ELASTICSEARCH_HOMEPAGE_GROUP=Search
ELASTICSEARCH_HOMEPAGE_NAME=Elasticsearch
ELASTICSEARCH_HOMEPAGE_ICON=elasticsearch.png
ELASTICSEARCH_HOMEPAGE_DESCRIPTION=Elasticsearch HTTP
ELASTICSEARCH_HOMEPAGE_URL=
ELASTICSEARCH_HOMEPAGE_SITEMONITOR=http://elasticsearch:9200
