# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

# DOCKER_RUNTIME_SOCKET=/run/user/501/podman/podman.sock # For Podman
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock # For Docker
DOCKER_VOLUMES_PATH=/var/lib/docker/volumes


INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

# —— Portainer (see portainer/.env.example) ——
# DEFAULT_NETWORK_NAME=portainer-network
# DEFAULT_NETWORK_EXTERNAL=false
PORTAINER_IMAGE=docker.io/portainer/portainer-ce:lts
PORTAINER_RESTART=unless-stopped
PORTAINER_PRIVILEGED=false
PORTAINER_ENV_FILE=.env.example
PORTAINER_MEMORY_LIMIT=1G
PORTAINER_PORT=9000
PORTAINER_AGENT_IMAGE=docker.io/portainer/agent:lts
PORTAINER_AGENT_RESTART=unless-stopped
PORTAINER_AGENT_PRIVILEGED=false
PORTAINER_AGENT_ENV_FILE=.env.example
PORTAINER_AGENT_MEMORY_LIMIT=1G
PORTAINER_AGENT_SECRET=
PORTAINER_AGENT_PUBLISHED_PORT=9001
PORTAINER_AGENT_PORT_MODE=ingress
PORTAINER_DATA_DIR=
PORTAINER_DATA_VOLUME_NAME=portainer_data
PORTAINER_DATA_VOLUME_EXTERNAL=false
PORTAINER_DOMAIN=portainer.example.com
PORTAINER_BASE_PATH=/portainer
PORTAINER_APP_URL=http://portainer.example.com/portainer
PORTAINER_TRUSTED_ORIGINS=localhost,127.0.0.1,portainer.example.com
PORTAINER_TRAEFIK_LABELS_SWARM_ENABLE=true
PORTAINER_TRAEFIK_LABELS_DOCKER_ENABLE=true
PORTAINER_ENTRYPOINTS=web
PORTAINER_MIDDLEWARES=portainer-strip
PORTAINER_TLS_ENABLED=false
PORTAINER_TLS_CERTRESOLVER=letsencrypt
PORTAINER_DEPLOY_MODE=replicated
PORTAINER_DEPLOY_REPLICAS=1
PORTAINER_PLACEMENT_CONSTRAINTS=node.role==manager
PORTAINER_AGENT_DEPLOY_MODE=replicated
PORTAINER_AGENT_DEPLOY_REPLICAS=1
PORTAINER_AGENT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PORTAINER_HOMEPAGE_GROUP=Infra
PORTAINER_HOMEPAGE_NAME=Portainer
PORTAINER_HOMEPAGE_ICON=portainer.png
PORTAINER_HOMEPAGE_HREF=http://portainer.example.com/portainer
PORTAINER_HOMEPAGE_DESCRIPTION=Portainer CE
PORTAINER_HOMEPAGE_SITEMONITOR=http://server:9000

