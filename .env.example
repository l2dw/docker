# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name


# —— grafana stack (see grafana/.env.example) ——
APP_NAME=grafana


GRAFANA_IMAGE=docker.io/grafana/grafana:13.3.1
GRAFANA_RESTART=unless-stopped
GRAFANA_PRIVILEGED=false
# Compose env_file (path relative to grafana/). environment: overrides the file. Production: .env
GRAFANA_ENV_FILE=.env.example
GRAFANA_PORT=3000

# Public URL + base path (Grafana supports a subpath: root_url + serve_from_sub_path).
# Subdomain only: GRAFANA_BASE_PATH=/  GRAFANA_ROOT_URL=https://grafana.example.com/  GRAFANA_SERVE_FROM_SUB_PATH=false
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_BASE_PATH=/grafana
GRAFANA_ROOT_URL=http://grafana.example.com/grafana/
GRAFANA_SERVE_FROM_SUB_PATH=true
# true behind HTTPS
GRAFANA_COOKIE_SECURE=false

# Database — sqlite3 (default, in the data volume) or postgres / mysql.
# postgres example: GRAFANA_DB_TYPE=postgres GRAFANA_DB_HOST=postgresql:5432 GRAFANA_DB_NAME=grafana GRAFANA_DB_USER=grafana
GRAFANA_DB_TYPE=sqlite3
GRAFANA_DB_HOST=
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD=
GRAFANA_DB_SSL_MODE=disable

# Admin + signing key (secrets: leave empty here; generate, e.g. openssl rand -hex 32 for the key).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=

# Prometheus datasource URL (server side, from the Grafana container).
GRAFANA_PROMETHEUS_URL=http://prometheus:9090/prometheus

# Provisioning configs (Swarm configs are immutable: bump _vN after editing the files).
GRAFANA_DATASOURCES_CONFIG_NAME=grafana_datasources_v1
GRAFANA_DASHBOARD_PROVIDER_CONFIG_NAME=grafana_dashboard_provider_v1
GRAFANA_DASHBOARD_NODE_EXPORTER_FULL_CONFIG_NAME=grafana_dashboard_node_exporter_full_v1
GRAFANA_DASHBOARD_CADVISOR_CONFIG_NAME=grafana_dashboard_cadvisor_v1
GRAFANA_DASHBOARD_BLACKBOX_HTTP_CONFIG_NAME=grafana_dashboard_blackbox_http_v1
GRAFANA_DASHBOARD_PROMETHEUS_OVERVIEW_CONFIG_NAME=grafana_dashboard_prometheus_overview_v1

# Traefik (docker-compose.yml only)
GRAFANA_TRAEFIK_LABELS_SWARM_ENABLE=true
GRAFANA_TRAEFIK_LABELS_DOCKER_ENABLE=true
GRAFANA_ENTRYPOINTS=web
GRAFANA_MIDDLEWARES=
GRAFANA_TLS_ENABLED=false
GRAFANA_TLS_CERTRESOLVER=letsencrypt

# Homepage
GRAFANA_HOMEPAGE_GROUP=Observability
GRAFANA_HOMEPAGE_NAME=Grafana
GRAFANA_HOMEPAGE_ICON=grafana.png
GRAFANA_HOMEPAGE_DESCRIPTION=Dashboards
GRAFANA_HOMEPAGE_URL=
GRAFANA_HOMEPAGE_SITEMONITOR=http://grafana:3000/grafana/api/health

# Deploy
GRAFANA_DEPLOY_MODE=replicated
GRAFANA_DEPLOY_REPLICAS=1
GRAFANA_MEMORY_LIMIT=1G
GRAFANA_PLACEMENT_CONSTRAINTS=node.platform.os==linux
GRAFANA_RESTART_POLICY_CONDITION=any
GRAFANA_RESTART_POLICY_DELAY=5s
GRAFANA_RESTART_POLICY_MAX_ATTEMPTS=3

# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Grafana runs as uid 472: a bind/NFS path must be writable by uid 472.
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/grafana
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/grafana
#   External:              EXTERNAL=true   (pre-create: docker volume create grafana_data)
#   # GRAFANA_DATA_VOLUME_TYPE=none
#   # GRAFANA_DATA_VOLUME_OPTS=bind
#   # GRAFANA_DATA_VOLUME_PATH=/appdata/grafana
GRAFANA_DATA_VOLUME_NAME=grafana_data
GRAFANA_DATA_VOLUME_EXTERNAL=false
GRAFANA_DATA_VOLUME_DRIVER=local
GRAFANA_DATA_VOLUME_TYPE=
GRAFANA_DATA_VOLUME_OPTS=
GRAFANA_DATA_VOLUME_PATH=
GRAFANA_DATA_VOLUME_DIR=/var/lib/grafana
