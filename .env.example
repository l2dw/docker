# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name


# —— otel stack (see otel/.env.example) ——



OPENTELEMETRY_IMAGE=docker.io/otel/opentelemetry-collector-contrib:0.165.0
OPENTELEMETRY_RESTART=unless-stopped
OPENTELEMETRY_PRIVILEGED=false
# Compose env_file (relative to otel/); environment: overrides it. Production: .env
OPENTELEMETRY_ENV_FILE=.env.example
# Swarm config name (immutable): bump _vN after editing config/config.yaml
OPENTELEMETRY_CONFIG_NAME=otel_config_v2
OPENTELEMETRY_PORT=4318

# App configuration (expanded into the config file)
OTEL_OTLP_GRPC_PORT=4317
OTEL_OTLP_HTTP_PORT=4318
OTEL_HTTP_BASE_PATH=
OTEL_HEALTH_PORT=13133
OTEL_TELEMETRY_PORT=8888
OTEL_ENVIRONMENT=default
OTEL_CLUSTER=default
OTEL_TRACES_ENDPOINT=http://tempo:4318
OTEL_LOGS_ENDPOINT=http://loki:3100/otlp
OTEL_METRICS_ENDPOINT=http://prometheus:9090/api/v1/write
OTEL_SCRAPE_TEMPO=tempo:3200
OTEL_SCRAPE_LOKI=loki:3100
OTEL_MEMORY_LIMIT_PERCENTAGE=80
OTEL_MEMORY_SPIKE_PERCENTAGE=20
OTEL_DEBUG_VERBOSITY=basic

# Traefik (docker-compose.yml only)
OPENTELEMETRY_DOMAIN=otel.example.com
OPENTELEMETRY_BASE_PATH=/
OPENTELEMETRY_TRAEFIK_LABELS_SWARM_ENABLE=true
OPENTELEMETRY_TRAEFIK_LABELS_DOCKER_ENABLE=true
OPENTELEMETRY_ENTRYPOINTS=web
OPENTELEMETRY_MIDDLEWARES=
OPENTELEMETRY_TLS_ENABLED=false
OPENTELEMETRY_TLS_CERTRESOLVER=letsencrypt

# Homepage
OPENTELEMETRY_HOMEPAGE_GROUP=Observability
OPENTELEMETRY_HOMEPAGE_NAME=OpenTelemetry
OPENTELEMETRY_HOMEPAGE_ICON=otel.png
OPENTELEMETRY_HOMEPAGE_DESCRIPTION=OTLP-collector
OPENTELEMETRY_HOMEPAGE_URL=
OPENTELEMETRY_HOMEPAGE_SITEMONITOR=http://otel:13133/

# Deploy
OPENTELEMETRY_DEPLOY_MODE=replicated
OPENTELEMETRY_DEPLOY_REPLICAS=1
OPENTELEMETRY_MEMORY_LIMIT=1G
OPENTELEMETRY_PLACEMENT_CONSTRAINTS=node.platform.os==linux
OPENTELEMETRY_RESTART_POLICY_CONDITION=any
OPENTELEMETRY_RESTART_POLICY_DELAY=5s
OPENTELEMETRY_RESTART_POLICY_MAX_ATTEMPTS=3

# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/otel
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/otel
#   External:              EXTERNAL=true   (pre-create: docker volume create otel_data)
OPENTELEMETRY_DATA_VOLUME_NAME=otel_data
OPENTELEMETRY_DATA_VOLUME_EXTERNAL=false
OPENTELEMETRY_DATA_VOLUME_DRIVER=local
OPENTELEMETRY_DATA_VOLUME_TYPE=
OPENTELEMETRY_DATA_VOLUME_OPTS=
OPENTELEMETRY_DATA_VOLUME_PATH=
OPENTELEMETRY_DATA_VOLUME_DIR=/var/lib/otelcol
