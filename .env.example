# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name

# # default: 1000, echo $(id -u) to get the current user's UID
# USER_UID=
# # default: 1000, echo $(id -g) to get the current user's GID
# USER_GID=
# # default: jenkins, echo $(id -un) to get the current   user's name
# USER_NAME=
# # default: admin, echo $(id -un) to get the current user's name
# ADMIN_USER=

INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## SMTP RELAY
SMTP_RELAY_IMAGE=namshi/smtp:latest
SMTP_RELAY_PULL_POLICY=always
SMTP_RELAY_RESTART=unless-stopped
SMTP_RELAY_PRIVILEGED=false
SMTP_RELAY_REPLICAS=1
SMTP_RELAY_SWARM_MODE=replicated
SMTP_RELAY_MEMORY_LIMIT=512M
SMTP_RELAY_PLACEMENT_CONSTRAINTS=node.role==manager
SMTP_RELAY_NODEPORT=25
#
SMTP_RELAY_MAILNAME=smtp.example.com
SMTP_RELAY_NETWORKS=:192.168.31.0/16:10.16.0.0/8
# Smarthost (Workspace, custom): set HOST (+ PORT, USER, PASS, ALIASES)
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=
SMTP_RELAY_USER=
SMTP_RELAY_PASS=
SMTP_RELAY_ALIASES=
# Traefik TCP (uncomment labels in compose; add entryPoint in traefik.yml, e.g. smtp :25)
# SMTP_RELAY_TRAEFIK_ENTRYPOINTS=smtp
# SMTP_RELAY_DOMAIN=smtp.example.com
