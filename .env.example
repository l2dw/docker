# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dsh-network
DEFAULT_NETWORK_EXTERNAL=false
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name


## DSH — see dsh/.env.example

APP_NAME=dsh
DEFAULT_NETWORK_NAME=dsh-network
DEFAULT_NETWORK_EXTERNAL=false
DSH_IMAGE=ghcr.io/xidong-ai/deepseek-harness-web-docker:latest
DSH_RESTART=unless-stopped
DSH_PRIVILEGED=false
DSH_ENV_FILE=.env.example
DSH_HOME=/home/node
DSH_DEEPSEEK_API_KEY=ChangeMe
DSH_TRUSTED_HOSTS=localhost,127.0.0.1
DSH_PUBLIC_URL=http://dsh.example.com/
DSH_BASE_PATH=/
DSH_DOMAIN=dsh.example.com
DSH_APP_URL=http://dsh.example.com/
DSH_PORT=3080
DSH_PUBLISHED_PORT=3080
DSH_PORT_MODE=ingress
DSH_PORT_PROTOCOL=tcp
DSH_NETWORK_ALIAS=deepseek-harness
DSH_TRAEFIK_LABELS_SWARM_ENABLE=true
DSH_TRAEFIK_LABELS_DOCKER_ENABLE=true
DSH_ENTRYPOINTS=web
DSH_MIDDLEWARES=
DSH_TLS_ENABLED=false
DSH_TLS_CERTRESOLVER=letsencrypt
DSH_DEPLOY_MODE=replicated
DSH_DEPLOY_REPLICAS=1
DSH_PLACEMENT_CONSTRAINTS=node.platform.os==linux
DSH_MEMORY_LIMIT=1G
DSH_RESTART_POLICY_CONDITION=any
DSH_RESTART_POLICY_DELAY=5s
DSH_RESTART_POLICY_MAX_ATTEMPTS=3
DSH_DATA_VOLUME_NAME=dsh_data
DSH_DATA_VOLUME_EXTERNAL=false
DSH_DATA_VOLUME_DRIVER=local
DSH_DATA_VOLUME_TYPE=
DSH_DATA_VOLUME_OPTS=
DSH_DATA_VOLUME_PATH=
DSH_DATA_VOLUME_DIR=/home/node
DSH_HOMEPAGE_GROUP=AI
DSH_HOMEPAGE_NAME=DeepSeek Harness
DSH_HOMEPAGE_ICON=deepseek.png
DSH_HOMEPAGE_DESCRIPTION=DeepSeek Harness Web UI
DSH_HOMEPAGE_URL=
DSH_HOMEPAGE_SITEMONITOR=http://dsh:3080
