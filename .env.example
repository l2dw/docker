# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

# Redpanda — see redpanda/.env.example
APP_NAME=redpanda
DEFAULT_NETWORK_NAME=redpanda-network
DEFAULT_NETWORK_EXTERNAL=false

REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v25.2.1
REDPANDA_CONSOLE_IMAGE=docker.redpanda.com/redpandadata/console:v2.8.5
REDPANDA_HOSTNAME=redpanda
REDPANDA_ALIAS=redpanda
REDPANDA_RESTART=unless-stopped
REDPANDA_PRIVILEGED=false
REDPANDA_ENV_FILE=.env.example
REDPANDA_CONSOLE_ENV_FILE=.env.example

# Console UI (Traefik HTTP). Subpath unsupported — keep BASE_PATH=/
REDPANDA_DOMAIN=redpanda.example.com
REDPANDA_BASE_PATH=/
REDPANDA_APP_URL=http://redpanda.example.com/
REDPANDA_ENTRYPOINTS=web
REDPANDA_MIDDLEWARES=
REDPANDA_TLS_ENABLED=false
REDPANDA_TLS_CERTRESOLVER=letsencrypt
REDPANDA_TRAEFIK_LABELS_SWARM_ENABLE=true
REDPANDA_TRAEFIK_LABELS_DOCKER_ENABLE=true
REDPANDA_CONSOLE_PORT=8080

# Kafka TCP (published only in unlabeled compose.yml)
REDPANDA_KAFKA_PORT=9092
REDPANDA_KAFKA_PUBLISHED_PORT=9092
REDPANDA_KAFKA_PORT_MODE=ingress
REDPANDA_KAFKA_PORT_PROTOCOL=tcp

# Broker
REDPANDA_ADMIN_USER=superadmin
REDPANDA_ADMIN_PASSWORD=ChangeMe
REDPANDA_MODE=dev-container
REDPANDA_SMP=1
REDPANDA_LOG_LEVEL=info

# Console → broker
REDPANDA_CONSOLE_KAFKA_BROKERS=redpanda:9092
REDPANDA_CONSOLE_SCHEMA_ENABLED=true
REDPANDA_CONSOLE_SCHEMA_URL=http://redpanda:8081
REDPANDA_CONSOLE_ADMIN_ENABLED=true
REDPANDA_CONSOLE_ADMIN_URL=http://redpanda:9644

# Volume key `data` → /var/lib/redpanda/data
REDPANDA_DATA_VOLUME_NAME=redpanda_data
REDPANDA_DATA_VOLUME_EXTERNAL=false
REDPANDA_DATA_VOLUME_DRIVER=local
REDPANDA_DATA_VOLUME_TYPE=
REDPANDA_DATA_VOLUME_OPTS=
REDPANDA_DATA_VOLUME_PATH=
REDPANDA_DATA_VOLUME_DIR=/var/lib/redpanda/data

REDPANDA_DEPLOY_MODE=replicated
REDPANDA_DEPLOY_REPLICAS=1
REDPANDA_MEMORY_LIMIT=1G
REDPANDA_PLACEMENT_CONSTRAINTS=node.platform.os==linux
REDPANDA_RESTART_POLICY_CONDITION=any
REDPANDA_RESTART_POLICY_DELAY=5s
REDPANDA_RESTART_POLICY_MAX_ATTEMPTS=3

REDPANDA_CONSOLE_DEPLOY_MODE=replicated
REDPANDA_CONSOLE_DEPLOY_REPLICAS=1
REDPANDA_CONSOLE_MEMORY_LIMIT=512M
REDPANDA_CONSOLE_PLACEMENT_CONSTRAINTS=node.platform.os==linux
REDPANDA_CONSOLE_RESTART_POLICY_CONDITION=any
REDPANDA_CONSOLE_RESTART_POLICY_DELAY=5s
REDPANDA_CONSOLE_RESTART_POLICY_MAX_ATTEMPTS=3

REDPANDA_HOMEPAGE_GROUP=Infrastructure
REDPANDA_HOMEPAGE_NAME=Redpanda
REDPANDA_HOMEPAGE_ICON=si-apachekafka
REDPANDA_HOMEPAGE_DESCRIPTION=Kafka-compatible streaming
REDPANDA_HOMEPAGE_URL=
REDPANDA_HOMEPAGE_SITEMONITOR=http://console:8080
