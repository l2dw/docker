# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## SIYUAN — see siyuan/.env.example (local-first knowledge base, port 6806)

SIYUAN_IMAGE=docker.io/b3log/siyuan:latest
SIYUAN_RESTART=unless-stopped
SIYUAN_PRIVILEGED=false
SIYUAN_ENV_FILE=.env.example

SIYUAN_DOMAIN=siyuan.example.com
SIYUAN_BASE_PATH=/
SIYUAN_LANG=en
SIYUAN_ACCESS_AUTH_CODE=ChangeMe
SIYUAN_PUID=1000
SIYUAN_PGID=1000
SIYUAN_WORKSPACE_CONTAINER_PATH=/siyuan/workspace

SIYUAN_DATA_DIR=
SIYUAN_DATA_VOLUME_NAME=siyuan_data
SIYUAN_DATA_VOLUME_EXTERNAL=false

SIYUAN_TRAEFIK_LABELS_SWARM_ENABLE=true
SIYUAN_TRAEFIK_LABELS_DOCKER_ENABLE=true
SIYUAN_ENTRYPOINTS=web
SIYUAN_MIDDLEWARES=
SIYUAN_TLS_ENABLED=false

SIYUAN_DEPLOY_MODE=replicated
SIYUAN_DEPLOY_REPLICAS=1
SIYUAN_PLACEMENT_CONSTRAINTS=node.platform.os==linux
SIYUAN_MEMORY_LIMIT=1G

SIYUAN_HOMEPAGE_GROUP=Notes
SIYUAN_HOMEPAGE_NAME=SiYuan
SIYUAN_HOMEPAGE_ICON=siyuan.png
SIYUAN_HOMEPAGE_HREF=http://siyuan.example.com/
SIYUAN_HOMEPAGE_DESCRIPTION=Local-first knowledge base
SIYUAN_HOMEPAGE_SITEMONITOR=http://siyuan:6806

