# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock


## —— Generic APP template (root compose files) ——————————————————
# APP_TRAEFIK_MODE: homepage → docker-compose.yml | http → web.docker-compose.yml | tcp → tcp.docker-compose.yml
APP_NAME=app
APP_ALIAS=app
APP_TRAEFIK_MODE=homepage
APP_IMAGE=docker.io/library/alpine:latest
APP_RESTART=unless-stopped
APP_PRIVILEGED=false
APP_ENV_FILE=.env.example
APP_PORT=
APP_PUBLISHED_PORT=
APP_PORT_MODE=ingress
APP_PORT_PROTOCOL=tcp

APP_DOMAIN=app.example.com
APP_BASE_PATH=/
APP_APP_URL=http://app.example.com/
APP_ENTRYPOINTS=web
APP_MIDDLEWARES=
APP_TLS_ENABLED=false
APP_TLS_CERTRESOLVER=letsencrypt
APP_TRAEFIK_LABELS_SWARM_ENABLE=true
APP_TRAEFIK_LABELS_DOCKER_ENABLE=true

# Volume key `data` → container APP_DATA_VOLUME_DIR.
# Local named (default): leave TYPE/OPTS/PATH empty.
# Bind: TYPE=none OPTS=bind PATH=/appdata/app
# NFS: TYPE=nfs OPTS=addr=host,rw,nfsvers=4 PATH=:/exports/app
APP_DATA_VOLUME_NAME=app_data
APP_DATA_VOLUME_EXTERNAL=false
APP_DATA_VOLUME_DRIVER=local
APP_DATA_VOLUME_TYPE=
APP_DATA_VOLUME_OPTS=
APP_DATA_VOLUME_PATH=
APP_DATA_VOLUME_DIR=/data

APP_DEPLOY_MODE=replicated
APP_DEPLOY_REPLICAS=1
APP_PLACEMENT_CONSTRAINTS=node.platform.os==linux
APP_RESTART_POLICY_CONDITION=any
APP_RESTART_POLICY_DELAY=5s
APP_RESTART_POLICY_MAX_ATTEMPTS=3
APP_MEMORY_LIMIT=1G

APP_HOMEPAGE_ENABLED=true
APP_HOMEPAGE_GROUP=Infrastructure
APP_HOMEPAGE_NAME=App
APP_HOMEPAGE_ICON=app.png
APP_HOMEPAGE_DESCRIPTION=Application dashboard
APP_HOMEPAGE_SITEMONITOR=http://app:3000
APP_HOMEPAGE_PING=

