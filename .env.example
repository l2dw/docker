# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
http_proxy=
https_proxy=
no_proxy=
USER_UID= # default: 1000, echo $(id -u) to get the current user's UID
USER_GID= # default: 1000, echo $(id -g) to get the current user's GID
USER_NAME= # default: jenkins, echo $(id -un) to get the current user's name
TZ=America/Montreal
DEFAULT_NETWORK=dokploy-network
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

## —— 🐝 Dokploy ———————————————————————————————————
DOKPLOY_TRAEFIK_PORT_HTTP=4080
DOKPLOY_TRAEFIK_PORT_HTTPS=4443
DOKPLOY_PORT=4000
# Volumes
DOKPLOY_POSTGRES_DATA_VOLUME_NAME=dokploy-postgresql_data
DOKPLOY_POSTGRES_DATA_VOLUME_EXTERNAL=false
DOKPLOY_POSTGRES_LOGS_VOLUME_NAME=dokploy-postgresql_logs
DOKPLOY_POSTGRES_LOGS_VOLUME_EXTERNAL=false
DOKPLOY_TRAEFIK_LOGS_VOLUME_NAME=dokploy-traefik_logs
DOKPLOY_TRAEFIK_LOGS_VOLUME_EXTERNAL=true
DOKPLOY_REDIS_DATA_VOLUME_NAME=dokploy-redis_data
DOKPLOY_REDIS_DATA_VOLUME_EXTERNAL=false
DOKPLOY_REDIS_LOGS_VOLUME_NAME=dokploy-redis_logs
DOKPLOY_REDIS_LOGS_VOLUME_EXTERNAL=false
DOKPLOY_TRAEFIK_CONFIG_FILE_VOLUME_NAME=dokploy-traefik_config_file
DOKPLOY_TRAEFIK_CONFIG_FILE_VOLUME_EXTERNAL=false
DOKPLOY_TRAEFIK_CERTS_VOLUME_NAME=dokploy-traefik_certs
DOKPLOY_TRAEFIK_CERTS_VOLUME_EXTERNAL=false
DOKPLOY_TRAEFIK_RULES_VOLUME_NAME=dokploy-traefik_rules
DOKPLOY_TRAEFIK_RULES_VOLUME_EXTERNAL=false
# Data
DOKPLOY_POSTGRES_DATA_DIR=
DOKPLOY_POSTGRES_LOGS_DIR=
DOKPLOY_TRAEFIK_LOGS_DIR=
DOKPLOY_REDIS_DATA_DIR=
DOKPLOY_REDIS_LOGS_DIR=
DOKPLOY_DATA_DIR=
DOKPLOY_LOGS_DIR=
## Postgres
DOKPLOY_POSTGRES_PASSWORD=
DOKPLOY_POSTGRES_USER=
DOKPLOY_POSTGRES_DB=
## Redis
DOKPLOY_REDIS_PASSWORD=
DOKPLOY_REDIS_USER=
DOKPLOY_REDIS_DB=
## Dokploy
DOKPLOY_DATABASE_URL=postgres://dokploy:ChangeMe@dokploy-postgresql:5432/dokploy
# Traefik
DOKPLOY_TRAEFIK_DOMAIN=traefik.${INFRA_NAME}.${INFRA_DOMAIN}
# Subpath for the built-in Traefik dashboard routers (must match PathPrefix rule; use /traefik unless you mount at site root)
DOKPLOY_TRAEFIK_PATH_PREFIX=/traefik
# Basic auth for dashboard (optional). Hash from: htpasswd -nb user pass | sed 's/\$/$$/g'  (Compose needs $$ for each $ in the hash)
# DOKPLOY_TRAEFIK_BASIC_AUTH_CREDENTIALS=admin:$$apr1$$...
DOKPLOY_TRAEFIK_CONFIG_FILE_PATH=
DOKPLOY_TRAEFIK_CONFIG_DIR=
DOKPLOY_TRAEFIK_CERTS_DIR=
DOKPLOY_TRAEFIK_RULES_DIR=
DOKPLOY_TRAEFIK_CONFIG_FILE_PATH=
DOKPLOY_TRAEFIK_CONFIG_FILE_EXTERNAL=false

## HOMEPAGE
HOMEPAGE_HOST_DOMAIN=homepage.example.com
HOMEPAGE_HOST_URI=/
HOMEPAGE_HOST_PROTOCOL=http
HOMEPAGE_DATA_DIR=${APPDATA_DIR}/homepage/config
HOMEPAGE_ALLOWED_HOSTS=homepage.example.com

## MINIO-CLIENT
MINIO_CLIENT_DATA_DIR=
MINIO_CLIENT_CONFIG_DIR=
MINIO_CLIENT_HOMEPAGE_GROUP=
MINIO_CLIENT_HOMEPAGE_NAME=minio-client
MINIO_CLIENT_HOMEPAGE_ICON=minio.png
MINIO_CLIENT_HOMEPAGE_DESCRIPTION=Minio Client is a platform for cli tool for s3 management.

## RUSTFS
RUSTFS_DATA_DIR=${APPDATA_DIR}/rustfs/data
RUSTFS_LOGS_DIR=${APPDATA_DIR}/rustfs/logs
RUSTFS_DOMAIN=rustfs.example.com
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=ChangeMe.123
RUSTFS_IMAGE=
RUSTFS_PULL_POLICY=always # always, never, if-not-tagged
RUSTFS_RESTART=unless-stopped # always, unless-stopped, on-failure
RUSTFS_PRIVILEGED=true # true, false
## RUSTFS TRAEFIK CONFIGURATION
RUSTFS_TRAEFIK_ENTRYPOINT=web
RUSTFS_TRAEFIK_MIDDLEWARES=
RUSTFS_TRAEFIK_TLS_ENABLED=false
RUSTFS_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
## RUSTFS HOMEPAGE CONFIGURATION
RUSTFS_HOMEPAGE_GROUP=Infra
RUSTFS_HOMEPAGE_NAME=RustFS
RUSTFS_HOMEPAGE_ICON=rustfs.png
RUSTFS_HOMEPAGE_HREF=http://rustfs.example.com/rustfs
RUSTFS_HOMEPAGE_SITEMONITOR=
RUSTFS_HOMEPAGE_PING=
## SWARM CONFIGURATION
RUSTFS_REPLICAS=1
RUSTFS_SWARM_MODE=replicated # replicated, global
RUSTFS_PLACEMENT_NODE_ROLE=manager # manager, worker
RUSTFS_MEMORY_LIMIT=512M # 512M, 1G, 2G


## JENKINS-AGENT
JENKINS_AGENT_MOUNT_WORKDIR=${APPDATA_DIR}/jenkins-agent
JENKINS_AGENT_MOUNT_HOME=~/
JENKINS_AGENT_HOMEPAGE_GROUP=
JENKINS_AGENT_HOMEPAGE_NAME=Jenkins Agent
JENKINS_AGENT_HOMEPAGE_ICON=jenkins.png
JENKINS_AGENT_HOMEPAGE_DESCRIPTION=

## JENKINS
JENKINS_DOMAIN=example.com
JENKINS_PATH_PREFIX=/jenkins
JENKINS_OPTS=--prefix=/jenkins
JENKINS_MOUNT_DATA=${APPDATA_DIR}/jenkins/data
JENKINS_TRAEFIK_ENTRYPOINTS=web
JENKINS_TRAEFIK_MIDDLEWARES=
JENKINS_TRAEFIK_TLS_ENABLED=false
JENKINS_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
JENKINS_HOMEPAGE_GROUP=
JENKINS_HOMEPAGE_NAME=Jenkins
JENKINS_HOMEPAGE_ICON=jenkins.png
JENKINS_HOMEPAGE_HREF=http://${JENKINS_DOMAIN}/${JENKINS_PATH_PREFIX}
JENKINS_HOMEPAGE_SITEMONITOR=${JENKINS_HOMEPAGE_HREF}
JENKINS_HOMEPAGE_PING=

## BYTESTASH
BYTESTASH_DOMAIN=example.com
BYTESTASH_BASE_PATH=/bytestash
BYTESTASH_MOUNT_DATA=${APPDATA_DIR}/bytestash/data
BYTESTASH_TRAEFIK_ENTRYPOINTS=web
BYTESTASH_TRAEFIK_MIDDLEWARES=
BYTESTASH_TRAEFIK_TLS_ENABLED=false
BYTESTASH_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
BYTESTASH_HOMEPAGE_GROUP=
BYTESTASH_HOMEPAGE_NAME=ByteStash
BYTESTASH_HOMEPAGE_ICON=bytestash.png
BYTESTASH_HOMEPAGE_HREF=http://example.com/bytestash
BYTESTASH_HOMEPAGE_SITEMONITOR=http://bytestash:5000
BYTESTASH_HOMEPAGE_PING=
BYTESTASH_JWT_SECRET=your-secret
BYTESTASH_TOKEN_EXPIRY=24h
BYTESTASH_ALLOW_NEW_ACCOUNTS=true
BYTESTASH_DEBUG=false
BYTESTASH_DISABLE_ACCOUNTS=false
BYTESTASH_DISABLE_INTERNAL_ACCOUNTS=false
BYTESTASH_OIDC_ENABLED=false
BYTESTASH_OIDC_DISPLAY_NAME=
BYTESTASH_OIDC_ISSUER_URL=
BYTESTASH_OIDC_CLIENT_ID=
BYTESTASH_OIDC_CLIENT_SECRET=
BYTESTASH_OIDC_SCOPES=
BYTESTASH_PLACEMENT_CONSTRAINTS=
