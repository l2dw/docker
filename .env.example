# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=sonatype-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## SONATYPE — see sonatype/.env.example


APP_NAME=sonatype
DEFAULT_NETWORK_NAME=sonatype-network
DEFAULT_NETWORK_EXTERNAL=false
# Join Dokploy overlay: DEFAULT_NETWORK_NAME=dokploy-network (setup sets EXTERNAL=true).

SONATYPE_IMAGE=docker.io/sonatype/nexus3:3.96.4
SONATYPE_RESTART=unless-stopped
SONATYPE_PRIVILEGED=false
SONATYPE_STOP_GRACE_PERIOD=2m
SONATYPE_ENV_FILE=.env.example

SONATYPE_DOMAIN=sonatype.example.com
SONATYPE_BASE_PATH=/sonatype
SONATYPE_APP_URL=http://sonatype.example.com/sonatype
SONATYPE_PORT=8081
# Vendor NEXUS_CONTEXT: no leading slash. Empty for root subdomain (+ BASE_PATH=/).
SONATYPE_NEXUS_CONTEXT=sonatype

SONATYPE_TRAEFIK_LABELS_SWARM_ENABLE=true
SONATYPE_TRAEFIK_LABELS_DOCKER_ENABLE=true
SONATYPE_ENTRYPOINTS=web
SONATYPE_MIDDLEWARES=
SONATYPE_TLS_ENABLED=false
SONATYPE_TLS_CERTRESOLVER=letsencrypt

SONATYPE_DEPLOY_MODE=replicated
SONATYPE_DEPLOY_REPLICAS=1
SONATYPE_PLACEMENT_CONSTRAINTS=node.platform.os==linux
SONATYPE_RESTART_POLICY_CONDITION=any
SONATYPE_RESTART_POLICY_DELAY=5s
SONATYPE_RESTART_POLICY_MAX_ATTEMPTS=3
SONATYPE_MEMORY_LIMIT=2G
SONATYPE_INSTALL4J_ADD_VM_PARAMS=-Xms512m -Xmx1g -XX:MaxDirectMemorySize=1g -Djava.util.prefs.userRoot=/nexus-data/javaprefs

SONATYPE_DATA_VOLUME_NAME=sonatype_data
SONATYPE_DATA_VOLUME_EXTERNAL=false
SONATYPE_DATA_VOLUME_DRIVER=local
SONATYPE_DATA_VOLUME_TYPE=
SONATYPE_DATA_VOLUME_OPTS=
SONATYPE_DATA_VOLUME_PATH=
SONATYPE_DATA_VOLUME_DIR=/nexus-data

SONATYPE_HOMEPAGE_GROUP=CI
SONATYPE_HOMEPAGE_NAME=Nexus
SONATYPE_HOMEPAGE_ICON=sonatype.png
SONATYPE_HOMEPAGE_DESCRIPTION=Sonatype Nexus Repository
SONATYPE_HOMEPAGE_URL=
SONATYPE_HOMEPAGE_SITEMONITOR=http://sonatype:8081/sonatype
