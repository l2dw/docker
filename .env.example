# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=nextcloud-network
DEFAULT_NETWORK_EXTERNAL=false
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## NEXTCLOUD 27 + PostgreSQL 15 (external DB)
NEXTCLOUD_IMAGE=docker.io/library/nextcloud:27
NEXTCLOUD_RESTART=unless-stopped
NEXTCLOUD_PRIVILEGED=false
NEXTCLOUD_ENV_FILE=.env.example
NEXTCLOUD_DOMAIN=nextcloud.example.com
NEXTCLOUD_BASE_PATH=/nextcloud
NEXTCLOUD_APP_URL=http://nextcloud.example.com/nextcloud
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud.example.com
NEXTCLOUD_TRUSTED_PROXIES=172.16.0.0/12
NEXTCLOUD_APACHE_DISABLE_REWRITE_IP=1
NEXTCLOUD_OVERWRITEHOST=nextcloud.example.com
NEXTCLOUD_OVERWRITEPROTOCOL=http
NEXTCLOUD_OVERWRITEWEBROOT=/nextcloud
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_TRAEFIK_LABELS_SWARM_ENABLE=true
NEXTCLOUD_TRAEFIK_LABELS_DOCKER_ENABLE=true
NEXTCLOUD_ENTRYPOINTS=web
NEXTCLOUD_MIDDLEWARES=nextcloud-strip
NEXTCLOUD_TLS_ENABLED=false
NEXTCLOUD_TLS_CERTRESOLVER=letsencrypt
NEXTCLOUD_DEPLOY_MODE=replicated
NEXTCLOUD_DEPLOY_REPLICAS=1
NEXTCLOUD_PLACEMENT_CONSTRAINTS=node.platform.os==linux
NEXTCLOUD_MEMORY_LIMIT=1G
NEXTCLOUD_HTML_VOLUME_NAME=nextcloud-html
NEXTCLOUD_HTML_VOLUME_EXTERNAL=false
NEXTCLOUD_DATA_VOLUME_NAME=nextcloud-data
NEXTCLOUD_DATA_VOLUME_EXTERNAL=false
NEXTCLOUD_HTML_DIR=nextcloud-html
NEXTCLOUD_DATA_DIR=nextcloud-data
NEXTCLOUD_CUSTOM_CONFIG=./config/zzz-custom.config.php
NEXTCLOUD_HOMEPAGE_GROUP=Apps
NEXTCLOUD_HOMEPAGE_NAME=Nextcloud
NEXTCLOUD_HOMEPAGE_ICON=nextcloud.png
NEXTCLOUD_HOMEPAGE_DESCRIPTION=Nextcloud
NEXTCLOUD_HOMEPAGE_SITEMONITOR=http://nextcloud:80
NEXTCLOUD_DB_HOST=postgresql
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=

