# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=guacamole-network
DEFAULT_NETWORK_EXTERNAL=false
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

# --- guacamole ---
# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Docs: https://guacamole.apache.org/doc/gug/guacamole-docker.html
# Images: guacamole/guacamole + guacamole/guacd (HTTP 8080 / TCP 4822). Postgres is external.


GUACAMOLE_IMAGE=docker.io/guacamole/guacamole:1.6.0
GUACAMOLE_RESTART=unless-stopped
GUACAMOLE_PRIVILEGED=false
GUACAMOLE_ENV_FILE=.env.example

GUACAMOLE_GUACD_IMAGE=docker.io/guacamole/guacd:1.6.0
GUACAMOLE_GUACD_RESTART=unless-stopped
GUACAMOLE_GUACD_PRIVILEGED=false
GUACAMOLE_GUACD_ENV_FILE=.env.example
GUACAMOLE_GUACD_HOSTNAME=guacamole-guacd
GUACAMOLE_GUACD_PORT=4822
GUACAMOLE_GUACD_LOG_LEVEL=info

GUACAMOLE_DOMAIN=guacamole.example.com
# Vendor WEBAPP_CONTEXT: default context is guacamole → /guacamole. Host-only: BASE_PATH=/ and WEBAPP_CONTEXT=ROOT.
GUACAMOLE_BASE_PATH=/guacamole
GUACAMOLE_APP_URL=http://guacamole.example.com/guacamole
GUACAMOLE_WEBAPP_CONTEXT=guacamole
GUACAMOLE_REMOTE_IP_VALVE_ENABLED=true

# External PostgreSQL (same overlay). Schema must be initialized (see README).
# External PostgreSQL (same overlay). Defaults: guacamole_user / guacamole_db.
# make guacamole-db-init (also run by *-up) creates the role/DB and loads initdb schema.
GUACAMOLE_POSTGRESQL_ENABLED=true
GUACAMOLE_POSTGRESQL_HOSTNAME=postgresql
GUACAMOLE_POSTGRESQL_PORT=5432
GUACAMOLE_POSTGRESQL_DATABASE=guacamole_db
GUACAMOLE_POSTGRESQL_USERNAME=guacamole_user
GUACAMOLE_POSTGRESQL_PASSWORD=

GUACAMOLE_TRAEFIK_LABELS_SWARM_ENABLE=true
GUACAMOLE_TRAEFIK_LABELS_DOCKER_ENABLE=true
GUACAMOLE_ENTRYPOINTS=web
GUACAMOLE_MIDDLEWARES=
GUACAMOLE_TLS_ENABLED=false
GUACAMOLE_TLS_CERTRESOLVER=letsencrypt

GUACAMOLE_DEPLOY_MODE=replicated
GUACAMOLE_DEPLOY_REPLICAS=1
GUACAMOLE_PLACEMENT_CONSTRAINTS=node.platform.os==linux
GUACAMOLE_MEMORY_LIMIT=1G

GUACAMOLE_GUACD_DEPLOY_MODE=replicated
GUACAMOLE_GUACD_DEPLOY_REPLICAS=1
GUACAMOLE_GUACD_PLACEMENT_CONSTRAINTS=node.platform.os==linux
GUACAMOLE_GUACD_MEMORY_LIMIT=1G

GUACAMOLE_HOMEPAGE_GROUP=Apps
GUACAMOLE_HOMEPAGE_NAME=Guacamole
GUACAMOLE_HOMEPAGE_ICON=guacamole.png
GUACAMOLE_HOMEPAGE_DESCRIPTION=Apache Guacamole
GUACAMOLE_HOMEPAGE_SITEMONITOR=http://guacamole:8080/guacamole/
