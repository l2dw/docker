# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## LOGTO — see logto/.env.example (external Postgres)

LOGTO_IMAGE=ghcr.io/logto-io/logto:latest
LOGTO_RESTART=unless-stopped
LOGTO_PRIVILEGED=false
LOGTO_ENV_FILE=.env.example
LOGTO_BASE_PATH=/

LOGTO_DOMAIN=logto.example.com
LOGTO_ADMIN_DOMAIN=admin.logto.example.com
LOGTO_ENDPOINT=http://logto.example.com
LOGTO_ADMIN_ENDPOINT=http://admin.logto.example.com

LOGTO_DB_URL=postgres://logto:ChangeMe@dokploy-postgresql:5432/logto

LOGTO_TRUST_PROXY_HEADER=1
LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002

LOGTO_TRAEFIK_LABELS_SWARM_ENABLE=true
LOGTO_TRAEFIK_LABELS_DOCKER_ENABLE=true
LOGTO_ENTRYPOINTS=web
LOGTO_MIDDLEWARES=
LOGTO_TLS_ENABLED=false
LOGTO_TLS_CERTRESOLVER=letsencrypt

LOGTO_DEPLOY_MODE=replicated
LOGTO_DEPLOY_REPLICAS=1
LOGTO_PLACEMENT_CONSTRAINTS=node.platform.os==linux
LOGTO_MEMORY_LIMIT=1G

LOGTO_HOMEPAGE_GROUP=Identity
LOGTO_HOMEPAGE_NAME=Logto
LOGTO_HOMEPAGE_ICON=logto.png
LOGTO_HOMEPAGE_DESCRIPTION=OIDC identity (Admin Console)
LOGTO_HOMEPAGE_SITEMONITOR=http://logto:3002

