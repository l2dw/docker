# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=
DEFAULT_NETWORK_EXTERNAL=
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name

# # default: 1000, echo $(id -u) to get the current user's UID
# USER_UID=
# # default: 1000, echo $(id -g) to get the current user's GID
# USER_GID=
# # default: jenkins, echo $(id -un) to get the current   user's name
# USER_NAME=
# # default: admin, echo $(id -un) to get the current user's name
# ADMIN_USER=

INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

# ## JENKINS
# JENKINS Image:
JENKINS_REGISTRY=
JENKINS_IMAGE_PATH=
JENKINS_IMAGE_TAG=latest
JENKINS_PULL_POLICY=
JENKINS_RESTART=
JENKINS_PRIVILEGED=
# # JENKINS Volume:
JENKINS_HOME_VOLUME_NAME=jenkins-volume
JENKINS_HOME_VOLUME_EXTERNAL=false
#   persistent volume path: jenkins_home
JENKINS_HOME_MOUNT_VOLUME_PATH=
# ## JENKINS Traefik:
JENKINS_DOMAIN=example.com
JENKINS_BASE_PATH=/jenkins
JENKINS_TRAEFIK_ENABLED=
JENKINS_TRAEFIK_ENTRYPOINTS=web
JENKINS_TRAEFIK_MIDDLEWARES=
JENKINS_TRAEFIK_TLS_ENABLED=false
JENKINS_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
# ## JENKINS Environment Variables:
JENKINS_MEMORY_LIMIT=512M
JENKINS_OPTS=--prefix=/jenkins
JENKINS_HOMEPAGE_GROUP=
JENKINS_HOMEPAGE_NAME=Jenkins
JENKINS_HOMEPAGE_ICON=jenkins.png
JENKINS_HOMEPAGE_HREF=http://${JENKINS_DOMAIN}/${JENKINS_PATH_PREFIX}
JENKINS_HOMEPAGE_SITEMONITOR=${JENKINS_HOMEPAGE_HREF}
JENKINS_HOMEPAGE_PING=
# ## JENKINS Deploy:
JENKINS_DEPLOY_REPLICAS=1
JENKINS_DEPLOY_SWARM_MODE=replicated
JENKINS_DEPLOY_PLACEMENT_CONSTRAINTS=
# Placement (Swarm): leave empty → any eligible Linux node (scheduler picks).
# Pin when needed, e.g.:
#   JENKINS_DEPLOY_PLACEMENT_CONSTRAINTS=node.role==worker
#   JENKINS_DEPLOY_PLACEMENT_CONSTRAINTS=node.hostname==db-1
#   JENKINS_DEPLOY_PLACEMENT_CONSTRAINTS=node.labels.disk==ssd

