# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=teleport-network
DEFAULT_NETWORK_EXTERNAL=false
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

# --- teleport ---
# Docs: https://goteleport.com/docs/installation/docker/
APP_NAME=teleport

TELEPORT_IMAGE=public.ecr.aws/gravitational/teleport-distroless:18.10.0
TELEPORT_RESTART=unless-stopped
TELEPORT_PRIVILEGED=false
TELEPORT_ENV_FILE=.env.example
TELEPORT_HOSTNAME=teleport

TELEPORT_DOMAIN=teleport.example.com
# Subpath is unsupported — keep / (Host-only dedicated subdomain).
TELEPORT_BASE_PATH=/
TELEPORT_APP_URL=https://teleport.example.com
TELEPORT_CLUSTER_NAME=teleport.example.com
TELEPORT_PUBLIC_ADDR=teleport.example.com:443

# Optional: ./config/teleport.yaml after setup or generate-config.sh. Default compose: teleport.yaml.example

TELEPORT_TRAEFIK_LABELS_SWARM_ENABLE=true
TELEPORT_TRAEFIK_LABELS_DOCKER_ENABLE=true
# HTTPS UI (Secure cookies). HTTP → redirect-to-https (Dokploy Traefik middleware).
# *-br forces Accept-Encoding:br (Teleport app.js is Brotli-only — else blank page).
# Leave CERTRESOLVER empty for *.local (Traefik default cert); set letsencrypt for public DNS.
TELEPORT_ENTRYPOINTS=websecure
TELEPORT_MIDDLEWARES=
TELEPORT_HTTP_MIDDLEWARES=redirect-to-https@swarm
TELEPORT_TLS_ENABLED=true
TELEPORT_TLS_CERTRESOLVER=

TELEPORT_DEPLOY_MODE=replicated
TELEPORT_DEPLOY_REPLICAS=1
TELEPORT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
TELEPORT_MEMORY_LIMIT=1G

TELEPORT_DATA_VOLUME_NAME=teleport-data
TELEPORT_DATA_VOLUME_EXTERNAL=false
TELEPORT_DATA_DIR=teleport-data

TELEPORT_HOMEPAGE_GROUP=Apps
TELEPORT_HOMEPAGE_NAME=Teleport
TELEPORT_HOMEPAGE_ICON=teleport.png
TELEPORT_HOMEPAGE_DESCRIPTION=Teleport
TELEPORT_HOMEPAGE_SITEMONITOR=https://teleport:3080/webapi/ping
