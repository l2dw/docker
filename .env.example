# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
http_proxy=
https_proxy=
no_proxy=
USER_UID= # default: 1000, echo $(id -u) to get the current user's UID
USER_GID= # default: 1000, echo $(id -g) to get the current user's GID
USER_NAME= # default: jenkins, echo $(id -un) to get the current user's name
TZ=America/Montreal
DEFAULT_NETWORK=dokploy-network
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

## TPL
TPL_IMAGE=
TPL_PULL_POLICY=
TPL_RESTART=
TPL_PRIVILEGED=
TPL_DOMAIN=example.com
TPL_BASE_PATH=/
TPL_MOUNT_DATA=${APPDATA_DIR}/tpl/data
TPL_MOUNT_LOGS=${APPDATA_DIR}/tpl/logs
TPL_TRAEFIK_ENTRYPOINTS=web
TPL_TRAEFIK_MIDDLEWARES=
TPL_TRAEFIK_TLS_ENABLED=false
TPL_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
TPL_HOMEPAGE_GROUP=
TPL_HOMEPAGE_NAME=Tpl
TPL_HOMEPAGE_ICON=tpl.png
TPL_HOMEPAGE_HREF=http://tpl.example.com
TPL_HOMEPAGE_SITEMONITOR=
TPL_HOMEPAGE_PING=

