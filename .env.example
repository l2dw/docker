# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK=dokploy-network
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name

USER_UID= # default: 1000, echo $(id -u) to get the current user's UID
USER_GID= # default: 1000, echo $(id -g) to get the current user's GID
USER_NAME= # default: jenkins, echo $(id -un) to get the current user's name
ADMIN_USER=admin # default: ubuntu, echo $(id -un) to get the current user's name

INFRA_DIR=/infra
APPDATA_DIR=/appdata
CERTS_DIR=/appdata/certs
BACKUPS_DIR=/appdata/backups
LOGS_DIR=/appdata/logs

# Docker Registry
DOCKER_REGISTRY_HOST=registry.cloud-name
DOCKER_REGISTRY_USER=docker-username
DOCKER_REGISTRY_PASS=docker-password

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## MINIO_CLIENT — see minio-client/.env.example


APP_NAME=minio-client
DEFAULT_NETWORK_NAME=minio-client-network
DEFAULT_NETWORK_EXTERNAL=false

MINIO_CLIENT_IMAGE=docker.io/minio/mc:latest
MINIO_CLIENT_RESTART=unless-stopped
MINIO_CLIENT_PRIVILEGED=false
MINIO_CLIENT_ENV_FILE=.env.example

MINIO_CLIENT_DEPLOY_MODE=replicated
MINIO_CLIENT_DEPLOY_REPLICAS=1
MINIO_CLIENT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
MINIO_CLIENT_RESTART_POLICY_CONDITION=any
MINIO_CLIENT_RESTART_POLICY_DELAY=5s
MINIO_CLIENT_RESTART_POLICY_MAX_ATTEMPTS=3
MINIO_CLIENT_MEMORY_LIMIT=256M

MINIO_CLIENT_DATA_VOLUME_NAME=minio_client_data
MINIO_CLIENT_DATA_VOLUME_EXTERNAL=false
MINIO_CLIENT_DATA_VOLUME_DRIVER=local
MINIO_CLIENT_DATA_VOLUME_TYPE=
MINIO_CLIENT_DATA_VOLUME_OPTS=
MINIO_CLIENT_DATA_VOLUME_PATH=
MINIO_CLIENT_DATA_VOLUME_DIR=/data
MINIO_CLIENT_CONFIG_VOLUME_NAME=minio_client_config
MINIO_CLIENT_CONFIG_VOLUME_EXTERNAL=false
MINIO_CLIENT_CONFIG_VOLUME_DRIVER=local
MINIO_CLIENT_CONFIG_VOLUME_TYPE=
MINIO_CLIENT_CONFIG_VOLUME_OPTS=
MINIO_CLIENT_CONFIG_VOLUME_PATH=
MINIO_CLIENT_CONFIG_VOLUME_DIR=/root/.mc

MINIO_CLIENT_HOMEPAGE_GROUP=Storage
MINIO_CLIENT_HOMEPAGE_NAME=MinIO Client
MINIO_CLIENT_HOMEPAGE_ICON=minio-client.png
MINIO_CLIENT_HOMEPAGE_DESCRIPTION=MinIO mc CLI sidecar
MINIO_CLIENT_HOMEPAGE_URL=
MINIO_CLIENT_HOMEPAGE_SITEMONITOR=
