# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name


# —— tempo stack (see tempo/.env.example) ——



TEMPO_IMAGE=docker.io/grafana/tempo:3.1.1
TEMPO_RESTART=unless-stopped
TEMPO_PRIVILEGED=false
# Compose env_file (relative to tempo/); environment: overrides it. Production: .env
TEMPO_ENV_FILE=.env.example
# Swarm config name (immutable): bump _vN after editing config/tempo.yaml
TEMPO_CONFIG_NAME=tempo_config_v1
TEMPO_PORT=3200

# App configuration (expanded into the config file)
TEMPO_HTTP_PORT=3200
TEMPO_GRPC_PORT=9095
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_LOG_LEVEL=info
TEMPO_RETENTION=336h
TEMPO_STORAGE_BACKEND=local
TEMPO_DATA_DIR=/var/tempo
TEMPO_S3_ENDPOINT=s3:9000
TEMPO_S3_BUCKET=tempo
TEMPO_S3_REGION=us-east-1
TEMPO_S3_ACCESS_KEY=
TEMPO_S3_SECRET_KEY=
TEMPO_S3_INSECURE=true
TEMPO_S3_FORCE_PATH_STYLE=true

# Homepage
TEMPO_HOMEPAGE_GROUP=Observability
TEMPO_HOMEPAGE_NAME=Tempo
TEMPO_HOMEPAGE_ICON=tempo.png
TEMPO_HOMEPAGE_DESCRIPTION=Traces-(OTLP)-backend
TEMPO_HOMEPAGE_URL=
TEMPO_HOMEPAGE_SITEMONITOR=http://tempo:3200/ready

# Deploy
TEMPO_DEPLOY_MODE=replicated
TEMPO_DEPLOY_REPLICAS=1
TEMPO_MEMORY_LIMIT=1G
TEMPO_PLACEMENT_CONSTRAINTS=node.platform.os==linux
TEMPO_RESTART_POLICY_CONDITION=any
TEMPO_RESTART_POLICY_DELAY=5s
TEMPO_RESTART_POLICY_MAX_ATTEMPTS=3

# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/tempo
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/tempo
#   External:              EXTERNAL=true   (pre-create: docker volume create tempo_data)
TEMPO_DATA_VOLUME_NAME=tempo_data
TEMPO_DATA_VOLUME_EXTERNAL=false
TEMPO_DATA_VOLUME_DRIVER=local
TEMPO_DATA_VOLUME_TYPE=
TEMPO_DATA_VOLUME_OPTS=
TEMPO_DATA_VOLUME_PATH=
TEMPO_DATA_VOLUME_DIR=/var/tempo
