# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Permanent MinIO Client (mc) mirror: SRC/DST = s3 bucket or local path under /data.
# Official mc image is often scratch — this stack builds Alpine+mc (see Dockerfile).
# No HTTP UI — Traefik omitted (v1). Subpath N/A (S3_MIRROR_BASE_PATH=/).

APP_NAME=s3-mirror
TZ=America/Montreal

DEFAULT_NETWORK_NAME=s3-mirror-network
DEFAULT_NETWORK_EXTERNAL=false

S3_MIRROR_IMAGE=s3-mirror:local
S3_MIRROR_RESTART=unless-stopped
S3_MIRROR_PRIVILEGED=false
S3_MIRROR_ENV_FILE=.env.example
S3_MIRROR_BASE_PATH=/
S3_MIRROR_MEMORY_LIMIT=1G

S3_MIRROR_DEPLOY_MODE=replicated
S3_MIRROR_DEPLOY_REPLICAS=1
S3_MIRROR_PLACEMENT_CONSTRAINTS=node.platform.os==linux
S3_MIRROR_RESTART_POLICY_CONDITION=any
S3_MIRROR_RESTART_POLICY_DELAY=5s
S3_MIRROR_RESTART_POLICY_MAX_ATTEMPTS=3

# uni = one mc mirror --watch SRC→DST (default). bi = two crossed watches.
S3_MIRROR_MODE=uni
# Extra flags for mc mirror (e.g. --overwrite --exclude ".git/*"). Avoid --remove on both sides in bi.
S3_MIRROR_MC_OPTS=

# --- SRC (s3 | path) ---
S3_MIRROR_SRC_TYPE=s3
S3_MIRROR_SRC_ENDPOINT=https://minio.example.com
S3_MIRROR_SRC_ACCESS_KEY=ChangeMe
S3_MIRROR_SRC_SECRET_KEY=ChangeMe
S3_MIRROR_SRC_BUCKET=homepage-config
S3_MIRROR_SRC_PREFIX=
S3_MIRROR_SRC_PATH=
# Optional: e.g. --api S3v4
S3_MIRROR_SRC_MC_ALIAS_OPTS=

# --- DST (s3 | path) ---
# Default recipe: bucket → local bind (Homepage config dir).
S3_MIRROR_DST_TYPE=path
S3_MIRROR_DST_ENDPOINT=
S3_MIRROR_DST_ACCESS_KEY=
S3_MIRROR_DST_SECRET_KEY=
S3_MIRROR_DST_BUCKET=
S3_MIRROR_DST_PREFIX=
S3_MIRROR_DST_PATH=
S3_MIRROR_DST_MC_ALIAS_OPTS=

# Compose volume key `data` → container S3_MIRROR_DATA_VOLUME_DIR (/data).
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named: EXTERNAL=false DRIVER=local TYPE= OPTS= PATH=
#   Bind:        EXTERNAL=false DRIVER=local TYPE=none OPTS=bind PATH=/appdata/homepage/config
#   NFS:         EXTERNAL=false DRIVER=local TYPE=nfs OPTS=addr=nfs.example.com,rw,nfsvers=4 PATH=:/exports/s3-mirror
#   External:    EXTERNAL=true  NAME=existing_volume (create before deploy)
S3_MIRROR_DATA_VOLUME_NAME=s3-mirror_data
S3_MIRROR_DATA_VOLUME_EXTERNAL=false
S3_MIRROR_DATA_VOLUME_DRIVER=local
S3_MIRROR_DATA_VOLUME_TYPE=
S3_MIRROR_DATA_VOLUME_OPTS=
S3_MIRROR_DATA_VOLUME_PATH=
S3_MIRROR_DATA_VOLUME_DIR=/data
# Bind override example (Homepage):
# S3_MIRROR_DATA_VOLUME_TYPE=none
# S3_MIRROR_DATA_VOLUME_OPTS=bind
# S3_MIRROR_DATA_VOLUME_PATH=/appdata/homepage/config

# Homepage dashboard labels (no public URL by default)
S3_MIRROR_HOMEPAGE_GROUP=Infrastructure
S3_MIRROR_HOMEPAGE_NAME=s3-mirror
S3_MIRROR_HOMEPAGE_ICON=minio.png
S3_MIRROR_HOMEPAGE_DESCRIPTION=Permanent mc mirror (S3 path or bucket)
S3_MIRROR_HOMEPAGE_URL=
S3_MIRROR_HOMEPAGE_SITEMONITOR=http://s3-mirror:9000
