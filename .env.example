# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name


# Jaeger — see jaeger/.env.example
# Credentials are separate variables (JAEGER_ES_USERNAME / JAEGER_ES_PASSWORD) — never embed them in JAEGER_ES_SERVER_URLS.
APP_NAME=jaeger
DEFAULT_NETWORK_NAME=jaeger-network
DEFAULT_NETWORK_EXTERNAL=false
# Join Dokploy overlay: DEFAULT_NETWORK_NAME=dokploy-network (setup sets EXTERNAL=true).
JAEGER_IMAGE=docker.io/jaegertracing/all-in-one:1.76.0
JAEGER_HOSTNAME=jaeger
JAEGER_RESTART=unless-stopped
JAEGER_PRIVILEGED=false
JAEGER_ENV_FILE=.env.example
JAEGER_DOMAIN=jaeger.example.com
JAEGER_BASE_PATH=/jaeger
JAEGER_MIDDLEWARES=
JAEGER_OTLP_PATH=/otlp
JAEGER_APP_URL=http://jaeger.example.com/jaeger
JAEGER_ENTRYPOINTS=web
JAEGER_TLS_ENABLED=false
JAEGER_TLS_CERTRESOLVER=letsencrypt
JAEGER_TRAEFIK_LABELS_SWARM_ENABLE=true
JAEGER_TRAEFIK_LABELS_DOCKER_ENABLE=true
JAEGER_HTTP_PORT=16686
JAEGER_OTLP_PORT=4318
JAEGER_QUERY_BASE_PATH=/jaeger
JAEGER_ES_SERVER_URLS=http://elasticsearch:9200
JAEGER_ES_USERNAME=elastic
JAEGER_ES_PASSWORD=ChangeMe
# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Multi-instance / Dokploy: use a distinct NAME per app (jaeger_data_01, …).
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/jaeger
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/jaeger
#   External:              EXTERNAL=true   (pre-create: docker volume create jaeger_data)
#   # JAEGER_DATA_VOLUME_TYPE=none
#   # JAEGER_DATA_VOLUME_OPTS=bind
#   # JAEGER_DATA_VOLUME_PATH=/appdata/jaeger
JAEGER_DATA_VOLUME_NAME=jaeger_data
JAEGER_DATA_VOLUME_EXTERNAL=false
JAEGER_DATA_VOLUME_DRIVER=local
JAEGER_DATA_VOLUME_TYPE=
JAEGER_DATA_VOLUME_OPTS=
JAEGER_DATA_VOLUME_PATH=
JAEGER_DATA_VOLUME_DIR=/data
JAEGER_DEPLOY_MODE=replicated
JAEGER_DEPLOY_REPLICAS=1
JAEGER_MEMORY_LIMIT=1G
JAEGER_PLACEMENT_CONSTRAINTS=node.platform.os==linux
JAEGER_RESTART_POLICY_CONDITION=any
JAEGER_RESTART_POLICY_DELAY=5s
JAEGER_RESTART_POLICY_MAX_ATTEMPTS=3
JAEGER_HOMEPAGE_GROUP=Observability
JAEGER_HOMEPAGE_NAME=Jaeger
JAEGER_HOMEPAGE_ICON=jaeger.png
JAEGER_HOMEPAGE_DESCRIPTION=Jaeger tracing UI and OTLP collector
JAEGER_HOMEPAGE_URL=
JAEGER_HOMEPAGE_SITEMONITOR=http://jaeger:16686/jaeger
