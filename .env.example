# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Full Make / setup guide: docs/MAKE.md
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name


## INFISICAL — see infisical/.env.example (secrets management platform, port 8080)
## PostgreSQL and Redis are EXTERNAL (no db/redis service in this stack).

INFISICAL_IMAGE=docker.io/infisical/infisical:v0.165.10
INFISICAL_RESTART=unless-stopped
INFISICAL_PRIVILEGED=false
INFISICAL_HOST=0.0.0.0
INFISICAL_PORT=8080
INFISICAL_ENV_FILE=.env.example

INFISICAL_DOMAIN=infisical.example.com
INFISICAL_BASE_PATH=/
INFISICAL_SITE_URL=http://infisical.example.com

# Generated by `make infisical-setup` when empty (never commit real values).
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=

# External PostgreSQL — replace <DB_HOST> (see infisical/README.md § PostgreSQL externe).
INFISICAL_DB_HOST=<DB_HOST>
INFISICAL_DB_PORT=5432
INFISICAL_DB_USER=infisical
INFISICAL_DB_PASSWORD=
INFISICAL_DB_NAME=infisical
INFISICAL_DB_CONNECTION_URI=postgresql://infisical:ChangeMe@<DB_HOST>:5432/infisical

# External Redis — replace <REDIS_HOST> (see infisical/README.md § Redis externe).
INFISICAL_REDIS_HOST=<REDIS_HOST>
INFISICAL_REDIS_PORT=6379
INFISICAL_REDIS_PASSWORD=
INFISICAL_REDIS_URL=redis://<REDIS_HOST>:6379

INFISICAL_NODE_OPTIONS=--max-old-space-size=768
INFISICAL_TELEMETRY_ENABLED=true
INFISICAL_DISABLE_UPDATE_CHECK=false

INFISICAL_TRAEFIK_LABELS_SWARM_ENABLE=true
INFISICAL_TRAEFIK_LABELS_DOCKER_ENABLE=true
INFISICAL_ENTRYPOINTS=web
INFISICAL_MIDDLEWARES=
INFISICAL_TLS_ENABLED=false
INFISICAL_TLS_CERTRESOLVER=letsencrypt

INFISICAL_DEPLOY_MODE=replicated
INFISICAL_DEPLOY_REPLICAS=1
INFISICAL_PLACEMENT_CONSTRAINTS=node.platform.os==linux
INFISICAL_MEMORY_LIMIT=1G

INFISICAL_HOMEPAGE_GROUP=Security
INFISICAL_HOMEPAGE_NAME=Infisical
INFISICAL_HOMEPAGE_ICON=infisical.png
INFISICAL_HOMEPAGE_HREF=http://infisical.example.com
INFISICAL_HOMEPAGE_DESCRIPTION=Secrets management platform
INFISICAL_HOMEPAGE_SITEMONITOR=http://backend:8080
