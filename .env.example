# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=kitchenowl-network
DEFAULT_NETWORK_EXTERNAL=false
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=unix:///var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name
#
INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

# --- kitchenowl ---
# Docs: https://docs.kitchenowl.org/latest/self-hosting/
# All-in-one tombursch/kitchenowl (HTTP 8080). Default DB is SQLite under /data.

KITCHENOWL_IMAGE=docker.io/tombursch/kitchenowl:v0.7.10
KITCHENOWL_RESTART=unless-stopped
KITCHENOWL_PRIVILEGED=false
KITCHENOWL_ENV_FILE=.env.example

KITCHENOWL_DOMAIN=kitchenowl.example.com
# Traefik PathPrefix. Empty or / = Host-only (subdomain). Default scaffold uses /kitchenowl.
# Compose uses PathPrefix(${KITCHENOWL_BASE_PATH:-/}) so empty becomes /.
KITCHENOWL_BASE_PATH=/kitchenowl
# Vendor BASE_HREF: must begin and end with / when set; leave empty for Host-only.
# Compose uses ${KITCHENOWL_BASE_HREF:-} (empty default) so an empty value is kept.
KITCHENOWL_BASE_HREF=/kitchenowl/
KITCHENOWL_APP_URL=http://kitchenowl.example.com/kitchenowl
# CORS allow-origin — must match the public URL (schema + host + path).
KITCHENOWL_FRONT_URL=http://kitchenowl.example.com/kitchenowl

KITCHENOWL_JWT_SECRET_KEY=
KITCHENOWL_OPEN_REGISTRATION=false
KITCHENOWL_DISABLE_ONBOARDING=false
# Vendor supports only: sqlite | postgresql (MySQL/MariaDB are not supported).
KITCHENOWL_DB_DRIVER=sqlite
# SQLite: leave HOST/USER/PASSWORD empty; optional DB_NAME path (default STORAGE_PATH/database.db).
# PostgreSQL (external): set DRIVER=postgresql and the keys below. Create DB/role before first boot.
KITCHENOWL_DB_HOST=
KITCHENOWL_DB_PORT=
KITCHENOWL_DB_NAME=
KITCHENOWL_DB_USER=
KITCHENOWL_DB_PASSWORD=
KITCHENOWL_DB_SQLITE_SYNCHRONOUS=FULL
KITCHENOWL_STORAGE_PATH=/data

KITCHENOWL_TRAEFIK_LABELS_SWARM_ENABLE=true
KITCHENOWL_TRAEFIK_LABELS_DOCKER_ENABLE=true
KITCHENOWL_ENTRYPOINTS=web
# Leave empty — BASE_HREF handles the subpath (do not stripPrefix).
KITCHENOWL_MIDDLEWARES=
KITCHENOWL_TLS_ENABLED=false
KITCHENOWL_TLS_CERTRESOLVER=letsencrypt

KITCHENOWL_DEPLOY_MODE=replicated
KITCHENOWL_DEPLOY_REPLICAS=1
KITCHENOWL_PLACEMENT_CONSTRAINTS=node.platform.os==linux
KITCHENOWL_MEMORY_LIMIT=1G

KITCHENOWL_DATA_VOLUME_NAME=kitchenowl-data
KITCHENOWL_DATA_VOLUME_EXTERNAL=false
# Swarm: volume *name*, not a host path, unless you override with a bind.
KITCHENOWL_DATA_DIR=kitchenowl-data

KITCHENOWL_HOMEPAGE_GROUP=Apps
KITCHENOWL_HOMEPAGE_NAME=KitchenOwl
KITCHENOWL_HOMEPAGE_ICON=kitchenowl.png
KITCHENOWL_HOMEPAGE_DESCRIPTION=KitchenOwl
KITCHENOWL_HOMEPAGE_SITEMONITOR=http://kitchenowl:8080

