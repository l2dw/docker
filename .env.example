# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name

# # default: 1000, echo $(id -u) to get the current user's UID
# USER_UID=
# # default: 1000, echo $(id -g) to get the current user's GID
# USER_GID=
# # default: jenkins, echo $(id -un) to get the current   user's name
# USER_NAME=
# # default: admin, echo $(id -un) to get the current user's name
# ADMIN_USER=

INFRA_DIR=${INFRA_DIR:-/infra}
APPDATA_DIR=${APPDATA_DIR:-/appdata}
CERTS_DIR=${CERTS_DIR:-${APPDATA_DIR}/certs}
BACKUPS_DIR=${BACKUPS_DIR:-${APPDATA_DIR}/backups}
LOGS_DIR=${LOGS_DIR:-${APPDATA_DIR}/logs}

# Docker Registry
DOCKER_REGISTRY_HOST=${DOCKER_REGISTRY_HOST:-registry.cloud-name}
DOCKER_REGISTRY_USER=${DOCKER_REGISTRY_USER:-docker-username}
DOCKER_REGISTRY_PASS=${DOCKER_REGISTRY_PASS:-docker-password}

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## JENKINS-AGENT
# # Jenkins Agent Persistent Volumes:
JENKINS_AGENT_HOME_VOLUME_NAME=jenkins_agent_home
JENKINS_AGENT_HOME_VOLUME_EXTERNAL=false
JENKINS_AGENT_WORKDIR_VOLUME_NAME=jenkins_agent_workdir
JENKINS_AGENT_WORKDIR_VOLUME_EXTERNAL=false
JENKINS_AGENT_HOME_HOST_PATH=
JENKINS_AGENT_WORKDIR_HOST_PATH=
# # Jenkins Agent Container:
JENKINS_AGENT_IMAGE_REGISTRY=docker.io
JENKINS_AGENT_IMAGE_PATH=jenkins/agent
JENKINS_AGENT_IMAGE_TAG=latest
JENKINS_AGENT_PULL_POLICY=always
JENKINS_AGENT_RESTART=unless-stopped
JENKINS_AGENT_PRIVILEGED=true
JENKINS_AGENT_MEMORY_LIMIT=512M
JENKINS_AGENT_USER_UID=
JENKINS_AGENT_USER_GID=
JENKINS_AGENT_USER_NAME=
# # Jenkins server URL:
JENKINS_SERVER_URL=https://example.com/jenkins
JENKINS_AGENT_NODE_NAME=
JENKINS_AGENT_NODE_SECRET=
JENKINS_AGENT_NODE_WORKDIR=/var/jenkins_agent
# Jenkins web socket: true or false, default: true
JENKINS_AGENT_WEB_SOCKET=
# Memory limit:
JENKINS_AGENT_MEMORY_LIMIT=
## JENKINS-AGENT Deploy:
JENKINS_AGENT_DEPLOY_REPLICAS=1
JENKINS_AGENT_DEPLOY_MODE=replicated
JENKINS_AGENT_DEPLOY_PLACEMENT_CONSTRAINTS=
JENKINS_AGENT_PLACEMENT_CONSTRAINTS=
# JENKINS_AGENT_DEPLOY_PLACEMENT_CONSTRAINTS=node.role==worker
# JENKINS_AGENT_DEPLOY_PLACEMENT_CONSTRAINTS=node.hostname==db-1
# JENKINS_AGENT_DEPLOY_PLACEMENT_CONSTRAINTS=node.labels.name==jenkins-agent-1
# JENKINS_AGENT_HOMEPAGE_ENABLED=
# JENKINS_AGENT_HOMEPAGE_GROUP=
# JENKINS_AGENT_HOMEPAGE_NAME=
# JENKINS_AGENT_HOMEPAGE_ICON=
# JENKINS_AGENT_HOMEPAGE_DESCRIPTION=
