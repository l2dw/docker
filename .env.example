# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
DEFAULT_NETWORK=dokploy-network
# DOCKER_RUNTIME_SOCKET=unix:///run/podman/podman.sock
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

INSTANCE_NAME=server-alias
INFRA_NAME=project
INFRA_DOMAIN=cloud-name

USER_UID= # default: 1000, echo $(id -u) to get the current user's UID
USER_GID= # default: 1000, echo $(id -g) to get the current user's GID
USER_NAME= # default: jenkins, echo $(id -un) to get the current user's name
ADMIN_USER=admin # default: ubuntu, echo $(id -un) to get the current user's name

INFRA_DIR=/infra
APPDATA_DIR=/appdata
CERTS_DIR=/appdata/certs
BACKUPS_DIR=/appdata/backups
LOGS_DIR=/appdata/logs

# Docker Registry
DOCKER_REGISTRY_HOST=registry.cloud-name
DOCKER_REGISTRY_USER=docker-username
DOCKER_REGISTRY_PASS=docker-password

# DNS Resolvers
UPDATE_DNS_RESOLVERS=false
NAMESERVER1=192.168.x.x
NAMESERVER2=192.168.x.x
NAMESERVER3=192.168.x.x
SEARCH_DOMAIN=cloud-name

## S3_CLIENT — see s3-client/.env.example


APP_NAME=s3-client
DEFAULT_NETWORK_NAME=s3-client-network
DEFAULT_NETWORK_EXTERNAL=false

S3_CLIENT_IMAGE=docker.io/minio/mc:latest
S3_CLIENT_RESTART=unless-stopped
S3_CLIENT_PRIVILEGED=false
S3_CLIENT_ENV_FILE=.env.example

S3_CLIENT_DEPLOY_MODE=replicated
S3_CLIENT_DEPLOY_REPLICAS=1
S3_CLIENT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
S3_CLIENT_RESTART_POLICY_CONDITION=any
S3_CLIENT_RESTART_POLICY_DELAY=5s
S3_CLIENT_RESTART_POLICY_MAX_ATTEMPTS=3
S3_CLIENT_MEMORY_LIMIT=256M

S3_CLIENT_DATA_VOLUME_NAME=s3_client_data
S3_CLIENT_DATA_VOLUME_EXTERNAL=false
S3_CLIENT_DATA_VOLUME_DRIVER=local
S3_CLIENT_DATA_VOLUME_TYPE=
S3_CLIENT_DATA_VOLUME_OPTS=
S3_CLIENT_DATA_VOLUME_PATH=
S3_CLIENT_DATA_VOLUME_DIR=/data
S3_CLIENT_CONFIG_VOLUME_NAME=s3_client_config
S3_CLIENT_CONFIG_VOLUME_EXTERNAL=false
S3_CLIENT_CONFIG_VOLUME_DRIVER=local
S3_CLIENT_CONFIG_VOLUME_TYPE=
S3_CLIENT_CONFIG_VOLUME_OPTS=
S3_CLIENT_CONFIG_VOLUME_PATH=
S3_CLIENT_CONFIG_VOLUME_DIR=/root/.mc

S3_CLIENT_HOMEPAGE_GROUP=Storage
S3_CLIENT_HOMEPAGE_NAME=S3 Client
S3_CLIENT_HOMEPAGE_ICON=s3-client.png
S3_CLIENT_HOMEPAGE_DESCRIPTION=S3 mc CLI sidecar
S3_CLIENT_HOMEPAGE_URL=
S3_CLIENT_HOMEPAGE_SITEMONITOR=
