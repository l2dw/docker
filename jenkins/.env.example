# Jenkins — placeholders only. Production: JENKINS_ENV_FILE=.env
# Image: docker.io/jenkins/jenkins:lts
# Subpath via JENKINS_OPTS --prefix= and Traefik PathPrefix.

APP_NAME=jenkins
DEFAULT_NETWORK_NAME=jenkins-network
DEFAULT_NETWORK_EXTERNAL=false

JENKINS_IMAGE=docker.io/jenkins/jenkins:lts
JENKINS_RESTART=unless-stopped
JENKINS_PRIVILEGED=false
JENKINS_ENV_FILE=.env.example

JENKINS_DOMAIN=jenkins.example.com
JENKINS_BASE_PATH=/jenkins
JENKINS_PORT=8080
JENKINS_OPTS=--prefix=/jenkins

DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

JENKINS_TRAEFIK_LABELS_SWARM_ENABLE=true
JENKINS_TRAEFIK_LABELS_DOCKER_ENABLE=true
JENKINS_ENTRYPOINTS=web
JENKINS_MIDDLEWARES=
JENKINS_TLS_ENABLED=false
JENKINS_TLS_CERTRESOLVER=letsencrypt

JENKINS_DEPLOY_MODE=replicated
JENKINS_DEPLOY_REPLICAS=1
JENKINS_PLACEMENT_CONSTRAINTS=node.platform.os==linux
JENKINS_RESTART_POLICY_CONDITION=any
JENKINS_RESTART_POLICY_DELAY=5s
JENKINS_RESTART_POLICY_MAX_ATTEMPTS=3
JENKINS_MEMORY_LIMIT=1G

JENKINS_DATA_VOLUME_NAME=jenkins_home
JENKINS_DATA_VOLUME_EXTERNAL=false
JENKINS_DATA_VOLUME_DRIVER=local
JENKINS_DATA_VOLUME_TYPE=
JENKINS_DATA_VOLUME_OPTS=
JENKINS_DATA_VOLUME_PATH=
JENKINS_DATA_VOLUME_DIR=/var/jenkins_home

JENKINS_HOMEPAGE_GROUP=CI
JENKINS_HOMEPAGE_NAME=Jenkins
JENKINS_HOMEPAGE_ICON=jenkins.png
JENKINS_HOMEPAGE_DESCRIPTION=Jenkins CI
JENKINS_HOMEPAGE_URL=
JENKINS_HOMEPAGE_SITEMONITOR=http://jenkins:8080/jenkins/login
