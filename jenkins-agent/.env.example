# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.

# # Proxy:
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# # Timezone:
TZ=America/Montreal

# # Network:
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

# # User: default: 1000, echo $(id -u) to get the current user's UID
# # Group: default: 1000, echo $(id -g) to get the current user's GID
# # Name: default: jenkins, echo $(id -un) to get the current user's name

## JENKINS-AGENT
JENKINS_AGENT_IMAGE=atelier.cen.umontreal.ca/jenkins/agent:latest
# Jenkins agent user UID: default: 501, echo $(id -u) to get the current user's UID
JENKINS_AGENT_USER_UID=501
# Jenkins agent user GID: default: 100, echo $(id -g) to get the current user's GID
JENKINS_AGENT_USER_GID=100
# Jenkins agent user name: default: admin, echo $(id -un) to get the current user's name
JENKINS_AGENT_USER_NAME=admin
# Jenkins URL:
JENKINS_URL=https://jenkins.example.com
# Jenkins agent name:
JENKINS_AGENT_NAME=jenkins-agent
# Jenkins secret:
JENKINS_SECRET=jenkins-secret
# Jenkins web socket: true or false, default: true
JENKINS_WEB_SOCKET=
# Bind user home directory:
JENKINS_AGENT_MOUNT_HOME_DIR=
# Bind agent work directory:
JENKINS_AGENT_MOUNT_WORKDIR=
# Memory limit:
JENKINS_AGENT_MEMORY_LIMIT=
JENKINS_AGENT_REPLICAS=
JENKINS_AGENT_DEPLOY_MODE=
JENKINS_AGENT_PLACEMENT_CONSTRAINTS=
JENKINS_AGENT_HOMEPAGE_ENABLED=
JENKINS_AGENT_HOMEPAGE_GROUP=
JENKINS_AGENT_HOMEPAGE_NAME=
JENKINS_AGENT_HOMEPAGE_ICON=
JENKINS_AGENT_HOMEPAGE_DESCRIPTION=
