FROM jenkins/inbound-agent:latest

USER root

ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG USER_UID=501
ARG USER_GID=100
ARG JENKINS_AGENT_WORKDIR=/jenkins-workspace
ARG USER_NAME=jenkins

ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}
ENV no_proxy=${no_proxy}

RUN apt-get update && apt-get install -y \
    make \
    curl \
    sudo \
    ca-certificates \
    openssh-client \
    postgresql-client \
    mariadb-client \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI (use host socket via -v /var/run/docker.sock:/var/run/docker.sock)
ENV DOCKER_VERSION=27.3.1
RUN curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz \
    | tar xz -C /tmp && mv /tmp/docker/docker /usr/local/bin/docker && chmod +x /usr/local/bin/docker && rm -rf /tmp/docker

# MinIO client
RUN curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc \
    -o /usr/local/bin/mc && chmod +x /usr/local/bin/mc

# Create group if it doesn't exist
RUN groupadd -g ${USER_GID} ${USER_NAME} || true

# Create user if it doesn't exist
RUN useradd -m -u ${USER_UID} -g ${USER_GID} ${USER_NAME} || true

# Add user to root group
RUN usermod -aG root ${USER_NAME} || true
RUN echo "${USER_NAME} ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

RUN mkdir -p ${JENKINS_AGENT_WORKDIR} && chown -R ${USER_UID}:${USER_GID} ${JENKINS_AGENT_WORKDIR}

USER ${USER_NAME}
WORKDIR ${JENKINS_AGENT_WORKDIR}
