# S3 Client (minio/mc) — placeholders only. Production: S3_CLIENT_ENV_FILE=.env
# CLI sidecar — sleep infinity; exec into container for mc commands.
# Image tag :latest (MinIO publishes dated RELEASE.* tags optionally).

APP_NAME=s3-client
DEFAULT_NETWORK_NAME=s3-client-network
DEFAULT_NETWORK_EXTERNAL=false

S3_CLIENT_IMAGE=docker.io/minio/mc:latest
S3_CLIENT_RESTART=unless-stopped
S3_CLIENT_PRIVILEGED=false
S3_CLIENT_ENV_FILE=.env.example

S3_CLIENT_DEPLOY_MODE=replicated
S3_CLIENT_DEPLOY_REPLICAS=1
S3_CLIENT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
S3_CLIENT_RESTART_POLICY_CONDITION=any
S3_CLIENT_RESTART_POLICY_DELAY=5s
S3_CLIENT_RESTART_POLICY_MAX_ATTEMPTS=3
S3_CLIENT_MEMORY_LIMIT=256M

S3_CLIENT_DATA_VOLUME_NAME=s3_client_data
S3_CLIENT_DATA_VOLUME_EXTERNAL=false
S3_CLIENT_DATA_VOLUME_DRIVER=local
S3_CLIENT_DATA_VOLUME_TYPE=
S3_CLIENT_DATA_VOLUME_OPTS=
S3_CLIENT_DATA_VOLUME_PATH=
S3_CLIENT_DATA_VOLUME_DIR=/data
S3_CLIENT_CONFIG_VOLUME_NAME=s3_client_config
S3_CLIENT_CONFIG_VOLUME_EXTERNAL=false
S3_CLIENT_CONFIG_VOLUME_DRIVER=local
S3_CLIENT_CONFIG_VOLUME_TYPE=
S3_CLIENT_CONFIG_VOLUME_OPTS=
S3_CLIENT_CONFIG_VOLUME_PATH=
S3_CLIENT_CONFIG_VOLUME_DIR=/root/.mc

S3_CLIENT_HOMEPAGE_GROUP=Storage
S3_CLIENT_HOMEPAGE_NAME=S3 Client
S3_CLIENT_HOMEPAGE_ICON=s3-client.png
S3_CLIENT_HOMEPAGE_DESCRIPTION=S3 mc CLI sidecar
S3_CLIENT_HOMEPAGE_URL=
S3_CLIENT_HOMEPAGE_SITEMONITOR=
