# Infisical — placeholders only. Production: INFISICAL_ENV_FILE=.env
# Image: https://hub.docker.com/r/infisical/infisical
# Docs: https://infisical.com/docs/self-hosting/deployment-options/docker-compose
# PostgreSQL and Redis are EXTERNAL (no db/redis service). See README.
# Secrets: make infisical-setup fills ENCRYPTION_KEY (rand -hex 16) and AUTH_SECRET (rand -base64 32).
# Subpath unsupported — keep INFISICAL_BASE_PATH=/ (Host-only subdomain).

APP_NAME=infisical
DEFAULT_NETWORK_NAME=infisical-network
DEFAULT_NETWORK_EXTERNAL=false

INFISICAL_IMAGE=docker.io/infisical/infisical:v0.165.10
INFISICAL_HOSTNAME=infisical
INFISICAL_RESTART=unless-stopped
INFISICAL_PRIVILEGED=false
INFISICAL_ENV_FILE=.env.example

# Container listen (image vendor default is localhost — keep HOST=0.0.0.0)
INFISICAL_HOST=0.0.0.0
INFISICAL_PORT=8080

# Traefik HTTP. Subpath unsupported — keep BASE_PATH=/
INFISICAL_DOMAIN=infisical.example.com
INFISICAL_BASE_PATH=/
INFISICAL_APP_URL=http://infisical.example.com/
# Vendor SITE_URL — absolute URL, no trailing slash; must match public Traefik access
INFISICAL_SITE_URL=http://infisical.example.com
INFISICAL_ENTRYPOINTS=web
INFISICAL_MIDDLEWARES=
INFISICAL_TLS_ENABLED=false
INFISICAL_TLS_CERTRESOLVER=letsencrypt
INFISICAL_TRAEFIK_LABELS_SWARM_ENABLE=true
INFISICAL_TRAEFIK_LABELS_DOCKER_ENABLE=true

# Required secrets — generated by make infisical-setup when empty
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=

# External PostgreSQL — replace dbhost / ChangeMe (see README)
INFISICAL_DB_HOST=dbhost
INFISICAL_DB_PORT=5432
INFISICAL_DB_USER=infisical
INFISICAL_DB_PASSWORD=
INFISICAL_DB_NAME=infisical
INFISICAL_DB_CONNECTION_URI=postgresql://infisical:ChangeMe@dbhost:5432/infisical

# External Redis — replace redishost (see README)
INFISICAL_REDIS_HOST=redishost
INFISICAL_REDIS_PORT=6379
INFISICAL_REDIS_PASSWORD=
INFISICAL_REDIS_URL=redis://redishost:6379

INFISICAL_NODE_OPTIONS=--max-old-space-size=768
INFISICAL_TELEMETRY_ENABLED=true
INFISICAL_DISABLE_UPDATE_CHECK=false

INFISICAL_DEPLOY_MODE=replicated
INFISICAL_DEPLOY_REPLICAS=1
INFISICAL_MEMORY_LIMIT=1G
INFISICAL_PLACEMENT_CONSTRAINTS=node.platform.os==linux
INFISICAL_RESTART_POLICY_CONDITION=any
INFISICAL_RESTART_POLICY_DELAY=5s
INFISICAL_RESTART_POLICY_MAX_ATTEMPTS=3

INFISICAL_HOMEPAGE_GROUP=Security
INFISICAL_HOMEPAGE_NAME=Infisical
INFISICAL_HOMEPAGE_ICON=infisical.png
INFISICAL_HOMEPAGE_DESCRIPTION=Secrets management platform
INFISICAL_HOMEPAGE_URL=
INFISICAL_HOMEPAGE_SITEMONITOR=http://infisical:8080
