# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://hub.docker.com/r/infisical/infisical
# Docs: https://infisical.com/docs/self-hosting/deployment-options/docker-compose
# Self-hosted secrets platform. Embedded PostgreSQL + Redis on the stack-local network `infisical-network`.
# Secrets: `make infisical-setup` fills ENCRYPTION_KEY (openssl rand -hex 16) and AUTH_SECRET (openssl rand -base64 32).
# Subpath is NOT supported — keep INFISICAL_BASE_PATH=/ and use a subdomain (Host-only Traefik rule).

DEFAULT_NETWORK_NAME=infisical-network
DEFAULT_NETWORK_EXTERNAL=false

INFISICAL_IMAGE=docker.io/infisical/infisical:v0.165.10
INFISICAL_RESTART=unless-stopped
INFISICAL_PRIVILEGED=false
# The container listens on 0.0.0.0:8080 (image ENV HOST=0.0.0.0 / PORT=8080). Vendor default is localhost — keep HOST explicit.
INFISICAL_HOST=0.0.0.0
INFISICAL_PORT=8080

# Public URL — absolute URL including protocol, no trailing slash. Must match how Traefik serves the app.
INFISICAL_DOMAIN=infisical.example.com
INFISICAL_BASE_PATH=/
INFISICAL_SITE_URL=http://infisical.example.com

# Required secrets — generated by `make infisical-setup` when empty.
#   ENCRYPTION_KEY: 16 random bytes, hex   → openssl rand -hex 16    (encrypts every stored secret)
#   AUTH_SECRET:    32 random bytes, base64 → openssl rand -base64 32 (signs JWT tokens)
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=

# Embedded PostgreSQL (`infisical-db`).
INFISICAL_DB_IMAGE=docker.io/library/postgres:16-alpine
INFISICAL_DB_RESTART=unless-stopped
INFISICAL_DB_PRIVILEGED=false
INFISICAL_DB_USER=infisical
INFISICAL_DB_PASSWORD=ChangeMe
INFISICAL_DB_NAME=infisical
# Must stay in sync with the credentials above; `make infisical-setup` derives it while it still contains ChangeMe.
# Point it at an external/managed PostgreSQL to drop the `infisical-db` service.
INFISICAL_DB_CONNECTION_URI=postgresql://infisical:ChangeMe@infisical-db:5432/infisical

# Embedded Redis (`infisical-redis`) — cache + job queues. Infisical refuses to start without it.
# No password (vendor default): never publish this service, it is reachable only on `infisical-network`.
INFISICAL_REDIS_IMAGE=docker.io/library/redis:7-alpine
INFISICAL_REDIS_RESTART=unless-stopped
INFISICAL_REDIS_PRIVILEGED=false
INFISICAL_REDIS_URL=redis://infisical-redis:6379

# Runtime tuning
# Node heap kept below INFISICAL_BACKEND_MEMORY_LIMIT so V8 GCs instead of being OOM-killed
# (the image ships NODE_OPTIONS=--max-old-space-size=2048, larger than a 1G container limit).
INFISICAL_NODE_OPTIONS=--max-old-space-size=768
INFISICAL_TELEMETRY_ENABLED=true
INFISICAL_DISABLE_UPDATE_CHECK=false

# Compose env_file paths (relative to infisical/). environment: overrides the file.
INFISICAL_BACKEND_ENV_FILE=.env.example
INFISICAL_DB_ENV_FILE=.env.example
INFISICAL_REDIS_ENV_FILE=.env.example

# # Data volumes — named Docker volumes by default. Repoint to a bind mount or an NFS share via
# # driver_opts, without touching compose.yml/docker-compose.yml (see README § Volumes).
INFISICAL_PG_DATA_VOLUME_NAME=infisical_pg_data
INFISICAL_PG_DATA_VOLUME_EXTERNAL=false
INFISICAL_PG_DATA_VOLUME_DRIVER=local
INFISICAL_PG_DATA_VOLUME_DRIVER_TYPE=
INFISICAL_PG_DATA_VOLUME_DRIVER_O=
INFISICAL_PG_DATA_VOLUME_DRIVER_DEVICE=
INFISICAL_PG_DATA_HOST_PATH=infisical_pg_data
INFISICAL_PG_DATA_CONTAINER_PATH=/var/lib/postgresql/data

INFISICAL_REDIS_DATA_VOLUME_NAME=infisical_redis_data
INFISICAL_REDIS_DATA_VOLUME_EXTERNAL=false
INFISICAL_REDIS_DATA_VOLUME_DRIVER=local
INFISICAL_REDIS_DATA_VOLUME_DRIVER_TYPE=
INFISICAL_REDIS_DATA_VOLUME_DRIVER_O=
INFISICAL_REDIS_DATA_VOLUME_DRIVER_DEVICE=
INFISICAL_REDIS_DATA_HOST_PATH=infisical_redis_data
INFISICAL_REDIS_DATA_CONTAINER_PATH=/data

INFISICAL_TRAEFIK_LABELS_SWARM_ENABLE=true
INFISICAL_TRAEFIK_LABELS_DOCKER_ENABLE=true
INFISICAL_ENTRYPOINTS=web
INFISICAL_MIDDLEWARES=
INFISICAL_TLS_ENABLED=false
INFISICAL_TLS_CERTRESOLVER=letsencrypt

INFISICAL_DEPLOY_MODE=replicated
INFISICAL_BACKEND_REPLICAS=1
INFISICAL_DB_REPLICAS=1
INFISICAL_REDIS_REPLICAS=1
INFISICAL_PLACEMENT_CONSTRAINTS=node.platform.os==linux
INFISICAL_BACKEND_MEMORY_LIMIT=1G
INFISICAL_DB_MEMORY_LIMIT=1G
INFISICAL_REDIS_MEMORY_LIMIT=1G

INFISICAL_HOMEPAGE_GROUP=Security
INFISICAL_HOMEPAGE_NAME=Infisical
INFISICAL_HOMEPAGE_ICON=infisical.png
INFISICAL_HOMEPAGE_HREF=http://infisical.example.com
INFISICAL_HOMEPAGE_DESCRIPTION=Secrets management platform
INFISICAL_HOMEPAGE_SITEMONITOR=http://infisical-backend:8080
