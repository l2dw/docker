# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://hub.docker.com/r/infisical/infisical
# Docs: https://infisical.com/docs/self-hosting/deployment-options/docker-compose
# Self-hosted secrets platform. PostgreSQL and Redis are EXTERNAL (no db/redis service in this stack).
# Create the database/role and point DB_CONNECTION_URI / REDIS_URL at the existing servers — see README.
# Secrets: `make infisical-setup` fills ENCRYPTION_KEY (openssl rand -hex 16) and AUTH_SECRET (openssl rand -base64 32).
# Subpath is NOT supported — keep INFISICAL_BASE_PATH=/ and use a subdomain (Host-only Traefik rule).

DEFAULT_NETWORK_NAME=infisical-network
DEFAULT_NETWORK_EXTERNAL=false

INFISICAL_IMAGE=docker.io/infisical/infisical:v0.165.10
INFISICAL_RESTART=unless-stopped
INFISICAL_PRIVILEGED=false
# The container listens on 0.0.0.0:8080 (image ENV HOST=0.0.0.0 / PORT=8080). Vendor default is localhost — keep HOST explicit.
INFISICAL_HOST=0.0.0.0
INFISICAL_PORT=8080

# Public URL — absolute URL including protocol, no trailing slash. Must match how Traefik serves the app.
INFISICAL_DOMAIN=infisical.example.com
INFISICAL_BASE_PATH=/
INFISICAL_SITE_URL=http://infisical.example.com

# Required secrets — generated by `make infisical-setup` when empty.
#   ENCRYPTION_KEY: 16 random bytes, hex   → openssl rand -hex 16    (encrypts every stored secret)
#   AUTH_SECRET:    32 random bytes, base64 → openssl rand -base64 32 (signs JWT tokens)
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=

# External PostgreSQL. Replace <DB_HOST> with the IP/DNS of the Postgres VM (no nested interpolation).
# The role must own an `infisical` database WITH ALL PRIVILEGES (schema + DDL rights). See README § PostgreSQL externe.
INFISICAL_DB_HOST=<DB_HOST>
INFISICAL_DB_PORT=5432
INFISICAL_DB_USER=infisical
INFISICAL_DB_PASSWORD=
INFISICAL_DB_NAME=infisical
INFISICAL_DB_CONNECTION_URI=postgresql://infisical:ChangeMe@<DB_HOST>:5432/infisical

# External Redis. Infisical refuses to start without it. Replace <REDIS_HOST> with the IP/DNS of the Redis VM.
# No password: redis://<REDIS_HOST>:6379 — with password: redis://:<password>@<REDIS_HOST>:6379
# With TLS: rediss://... (see README § Redis externe).
INFISICAL_REDIS_HOST=<REDIS_HOST>
INFISICAL_REDIS_PORT=6379
INFISICAL_REDIS_PASSWORD=
INFISICAL_REDIS_URL=redis://<REDIS_HOST>:6379

# Runtime tuning
# Node heap kept below INFISICAL_MEMORY_LIMIT so V8 GCs instead of being OOM-killed
# (the image ships NODE_OPTIONS=--max-old-space-size=2048, larger than a 1G container limit).
INFISICAL_NODE_OPTIONS=--max-old-space-size=768
INFISICAL_TELEMETRY_ENABLED=true
INFISICAL_DISABLE_UPDATE_CHECK=false

# Compose env_file (path relative to infisical/). environment: overrides the file.
INFISICAL_ENV_FILE=.env.example

INFISICAL_TRAEFIK_LABELS_SWARM_ENABLE=true
INFISICAL_TRAEFIK_LABELS_DOCKER_ENABLE=true
INFISICAL_ENTRYPOINTS=web
INFISICAL_MIDDLEWARES=
INFISICAL_TLS_ENABLED=false
INFISICAL_TLS_CERTRESOLVER=letsencrypt

INFISICAL_DEPLOY_MODE=replicated
INFISICAL_DEPLOY_REPLICAS=1
INFISICAL_PLACEMENT_CONSTRAINTS=node.platform.os==linux
INFISICAL_MEMORY_LIMIT=1G

INFISICAL_HOMEPAGE_GROUP=Security
INFISICAL_HOMEPAGE_NAME=Infisical
INFISICAL_HOMEPAGE_ICON=infisical.png
INFISICAL_HOMEPAGE_HREF=http://infisical.example.com
INFISICAL_HOMEPAGE_DESCRIPTION=Secrets management platform
INFISICAL_HOMEPAGE_SITEMONITOR=http://backend:8080
