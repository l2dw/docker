# prometheus stack — Prometheus + node-exporter + cAdvisor + blackbox-exporter.
# Copy to prometheus/.env (make prometheus-setup) and to the root .env (Make exports it for `docker stack deploy`).
# Docs: https://prometheus.io/docs/prometheus/latest/command-line/prometheus/

APP_NAME=prometheus

# Network — default stack-local overlay. Shared Dokploy overlay: dokploy-network + EXTERNAL=true.
DEFAULT_NETWORK_NAME=prometheus-network
DEFAULT_NETWORK_EXTERNAL=false

# Images
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.16.0
PROMETHEUS_NODE_EXPORTER_IMAGE=docker.io/prom/node-exporter:v1.12.1
PROMETHEUS_CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.61.0
PROMETHEUS_BLACKBOX_EXPORTER_IMAGE=docker.io/prom/blackbox-exporter:v0.29.1
PROMETHEUS_RESTART=unless-stopped
PROMETHEUS_PRIVILEGED=false
PROMETHEUS_NODE_EXPORTER_PRIVILEGED=false
# cAdvisor docs recommend privileged=true (Compose only; Swarm ignores it).
PROMETHEUS_CADVISOR_PRIVILEGED=false
PROMETHEUS_BLACKBOX_EXPORTER_PRIVILEGED=false

# Compose env_file paths (relative to prometheus/). environment: overrides the file.
# Production: point them to .env.
PROMETHEUS_ENV_FILE=.env.example
PROMETHEUS_NODE_EXPORTER_ENV_FILE=.env.example
PROMETHEUS_CADVISOR_ENV_FILE=.env.example
PROMETHEUS_BLACKBOX_EXPORTER_ENV_FILE=.env.example

# Configs (Compose/Swarm configs). Swarm configs are immutable:
# after editing config/*.yml, bump the *_CONFIG_NAME suffix (_v2, _v3…) then redeploy.
PROMETHEUS_CONFIG_NAME=prometheus_config_v4
PROMETHEUS_CONFIG_FILE=./config/prometheus.yml
PROMETHEUS_DOCKER_SOCK=/var/run/docker.sock
PROMETHEUS_USER=root
PROMETHEUS_BLACKBOX_EXPORTER_CONFIG_NAME=prometheus_blackbox_config_v2
PROMETHEUS_BLACKBOX_EXPORTER_CONFIG_FILE=./config/blackbox.yml

# Prometheus server
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
# 0 = no size-based retention. Examples: 10GB, 512MB
PROMETHEUS_RETENTION_SIZE=0
# Lifecycle API (/-/reload, /-/quit) stays disabled: no --web.enable-lifecycle flag (no auth).

# Remote-write receiver (POST <APP_URL>/api/v1/write) for Prometheus agents that cannot be scraped.
# --web.enable-remote-write-receiver to accept pushes (protect the write path with its own auth).
PROMETHEUS_REMOTE_WRITE_RECEIVER_FLAG=--no-web.enable-remote-write-receiver

# Public URL + base path (Prometheus supports a subpath via --web.external-url / --web.route-prefix).
# Subdomain only: PROMETHEUS_BASE_PATH=/ and PROMETHEUS_APP_URL=http://prometheus.example.com
# then set metrics_path: /metrics for job "prometheus" in config/prometheus.yml.
PROMETHEUS_DOMAIN=prometheus.example.com
PROMETHEUS_BASE_PATH=/prometheus
PROMETHEUS_APP_URL=http://prometheus.example.com/prometheus

# Traefik (docker-compose.yml only)
PROMETHEUS_TRAEFIK_LABELS_SWARM_ENABLE=true
PROMETHEUS_TRAEFIK_LABELS_DOCKER_ENABLE=true
PROMETHEUS_ENTRYPOINTS=web
# Prometheus has no built-in auth: add an auth middleware (basicauth/forwardauth) before exposing it.
PROMETHEUS_MIDDLEWARES=
PROMETHEUS_TLS_ENABLED=false
PROMETHEUS_TLS_CERTRESOLVER=letsencrypt

# Homepage
PROMETHEUS_HOMEPAGE_GROUP=Observability
PROMETHEUS_HOMEPAGE_NAME=Prometheus
PROMETHEUS_HOMEPAGE_ICON=prometheus.png
PROMETHEUS_HOMEPAGE_DESCRIPTION=Monitoring
PROMETHEUS_HOMEPAGE_URL=
PROMETHEUS_HOMEPAGE_SITEMONITOR=http://prometheus:9090/prometheus/-/healthy

# Exporters (listen ports inside the overlay — not published)
# Exporter hostname is hard-coded as Swarm template "{{.Node.Hostname}}" in compose
# (Dokploy env interpolation strips {{}}). These vars are unused by compose hostname:.
PROMETHEUS_NODE_EXPORTER_HOSTNAME=
PROMETHEUS_CADVISOR_HOSTNAME=
PROMETHEUS_NODE_EXPORTER_PORT=9100
PROMETHEUS_CADVISOR_PORT=8080
PROMETHEUS_CADVISOR_HOUSEKEEPING_INTERVAL=30s
# Memory: per-container labels and disk (du) metrics OOM-kill cAdvisor on busy hosts.
# Only these Docker labels become Prometheus labels (store_container_labels=false).
PROMETHEUS_CADVISOR_LABELS_ALLOWLIST=com.docker.stack.namespace,com.docker.swarm.service.name,com.docker.compose.project,com.docker.compose.service
# Options: advtcp,app,cpu,cpuLoad,cpu_topology,cpuset,disk,diskIO,hugetlb,memory,memory_numa,network,oom_event,percpu,perf_event,pressure,process,referenced_memory,resctrl,sched,tcp,udp
PROMETHEUS_CADVISOR_ENABLE_METRICS=cpu,memory,network,diskIO,oom_event
# Docker data root on the hosts (docker info --format '{{.DockerRootDir}}')
PROMETHEUS_CADVISOR_DOCKER_DIR=/var/lib/docker
PROMETHEUS_BLACKBOX_EXPORTER_PORT=9115

# Deploy — Prometheus + blackbox: replicated/1. Exporters: global (one task per node) + dnsrr.
PROMETHEUS_DEPLOY_MODE=replicated
PROMETHEUS_DEPLOY_REPLICAS=1
PROMETHEUS_BLACKBOX_EXPORTER_DEPLOY_MODE=replicated
PROMETHEUS_BLACKBOX_EXPORTER_DEPLOY_REPLICAS=1
PROMETHEUS_NODE_EXPORTER_DEPLOY_MODE=global
PROMETHEUS_NODE_EXPORTER_ENDPOINT_MODE=dnsrr
PROMETHEUS_CADVISOR_DEPLOY_MODE=global
PROMETHEUS_CADVISOR_ENDPOINT_MODE=dnsrr
PROMETHEUS_MEMORY_LIMIT=1G
PROMETHEUS_NODE_EXPORTER_MEMORY_LIMIT=1G
PROMETHEUS_CADVISOR_MEMORY_LIMIT=1G
PROMETHEUS_BLACKBOX_EXPORTER_MEMORY_LIMIT=1G
PROMETHEUS_PLACEMENT_CONSTRAINTS=node.role==manager
PROMETHEUS_NODE_EXPORTER_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PROMETHEUS_CADVISOR_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PROMETHEUS_BLACKBOX_EXPORTER_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PROMETHEUS_RESTART_POLICY_CONDITION=any
PROMETHEUS_RESTART_POLICY_DELAY=5s
PROMETHEUS_RESTART_POLICY_MAX_ATTEMPTS=3

# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Multi-instance / Dokploy: use a distinct NAME per app when needed (prometheus_data_01, …).
# Prometheus runs as nobody (65534): a bind/NFS path must be writable by uid 65534.
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/prometheus
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/prometheus
#   External:              EXTERNAL=true   (pre-create: docker volume create prometheus_data)
#   # PROMETHEUS_DATA_VOLUME_TYPE=none
#   # PROMETHEUS_DATA_VOLUME_OPTS=bind
#   # PROMETHEUS_DATA_VOLUME_PATH=/appdata/prometheus
PROMETHEUS_DATA_VOLUME_NAME=prometheus_data
PROMETHEUS_DATA_VOLUME_EXTERNAL=false
PROMETHEUS_DATA_VOLUME_DRIVER=local
PROMETHEUS_DATA_VOLUME_TYPE=
PROMETHEUS_DATA_VOLUME_OPTS=
PROMETHEUS_DATA_VOLUME_PATH=
PROMETHEUS_DATA_VOLUME_DIR=/prometheus

# —— Agent mode (agent-compose.yml): scrape local exporters, remote_write to a central Prometheus ——
# Per-host config file (remote_write URL, username, cluster label). Bump the name after editing.
PROMETHEUS_AGENT_CONFIG_NAME=prometheus_agent_config_v1
PROMETHEUS_AGENT_CONFIG_FILE=./config/agent/example.yml
# External Docker secret holding the remote_write password (docker secret create … -).
PROMETHEUS_AGENT_REMOTE_WRITE_SECRET_NAME=prometheus_remote_write_password
PROMETHEUS_AGENT_ENV_FILE=.env.example
PROMETHEUS_AGENT_PRIVILEGED=false
PROMETHEUS_AGENT_DEPLOY_MODE=replicated
PROMETHEUS_AGENT_DEPLOY_REPLICAS=1
PROMETHEUS_AGENT_MEMORY_LIMIT=1G
PROMETHEUS_AGENT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
# Agent WAL volume (same recipes as PROMETHEUS_DATA_VOLUME_*).
PROMETHEUS_AGENT_DATA_VOLUME_NAME=prometheus_agent_data
PROMETHEUS_AGENT_DATA_VOLUME_EXTERNAL=false
PROMETHEUS_AGENT_DATA_VOLUME_DRIVER=local
PROMETHEUS_AGENT_DATA_VOLUME_TYPE=
PROMETHEUS_AGENT_DATA_VOLUME_OPTS=
PROMETHEUS_AGENT_DATA_VOLUME_PATH=
PROMETHEUS_AGENT_DATA_VOLUME_DIR=/prometheus
