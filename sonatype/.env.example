# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Docs: https://github.com/sonatype/docker-nexus3
# First-boot admin password: /nexus-data/admin.password (UID 200)

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=false

SONATYPE_IMAGE=docker.io/sonatype/nexus3:latest
SONATYPE_RESTART=unless-stopped
SONATYPE_PRIVILEGED=false
SONATYPE_STOP_GRACE_PERIOD=2m
SONATYPE_ENV_FILE=.env.example

# Public URL (no trailing slash). Must include BASE_PATH when not serving at /.
SONATYPE_DOMAIN=example.com
SONATYPE_BASE_PATH=/sonatype
SONATYPE_APP_URL=http://example.com/sonatype
# Vendor NEXUS_CONTEXT: no leading slash (image sets nexus-context-path=/${NEXUS_CONTEXT}).
# Empty for root on a dedicated subdomain (also set SONATYPE_BASE_PATH=/).
SONATYPE_NEXUS_CONTEXT=sonatype

SONATYPE_TRAEFIK_LABELS_SWARM_ENABLE=true
SONATYPE_TRAEFIK_LABELS_DOCKER_ENABLE=true
SONATYPE_ENTRYPOINTS=web
SONATYPE_MIDDLEWARES=
SONATYPE_TLS_ENABLED=false
SONATYPE_TLS_CERTRESOLVER=letsencrypt

SONATYPE_DEPLOY_MODE=replicated
SONATYPE_DEPLOY_REPLICAS=1
SONATYPE_PLACEMENT_CONSTRAINTS=node.platform.os==linux
# Heap + MaxDirectMemorySize must stay under this limit
SONATYPE_MEMORY_LIMIT=2G
SONATYPE_INSTALL4J_ADD_VM_PARAMS=-Xms512m -Xmx1g -XX:MaxDirectMemorySize=1g -Djava.util.prefs.userRoot=/nexus-data/javaprefs

SONATYPE_DATA_DIR=
SONATYPE_DATA_VOLUME_NAME=sonatype_data
SONATYPE_DATA_VOLUME_EXTERNAL=false

SONATYPE_HOMEPAGE_GROUP=CI
SONATYPE_HOMEPAGE_NAME=Nexus
SONATYPE_HOMEPAGE_ICON=sonatype.png
SONATYPE_HOMEPAGE_DESCRIPTION=Sonatype Nexus Repository
SONATYPE_HOMEPAGE_SITEMONITOR=http://sonatype:8081/sonatype
