# Copied into `.env` (or project env) and loaded by make / compose.

# # Proxy:
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# # Timezone:
TZ=America/Montreal

# # Network:
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

## SONATYPE (Nexus Repository Manager 3)
SONATYPE_IMAGE=docker.io/sonatype/nexus3:latest
SONATYPE_DATA_VOLUME_NAME=sonatype_data
SONATYPE_DATA_VOLUME_EXTERNAL=false
# Bind-mount alternative (optional):
# SONATYPE_DATA_DIR=/appdata/sonatype/nexus-data
SONATYPE_DATA_DIR=
SONATYPE_REPLICAS=1
SONATYPE_DEPLOY_MODE=replicated
SONATYPE_PLACEMENT_CONSTRAINTS=node.role==worker
# Heap + direct memory must stay under SONATYPE_MEMORY_LIMIT
SONATYPE_MEMORY_LIMIT=2G
SONATYPE_INSTALL4J_ADD_VM_PARAMS=-Xms512m -Xmx1g -XX:MaxDirectMemorySize=1g -Djava.util.prefs.userRoot=/nexus-data/javaprefs

