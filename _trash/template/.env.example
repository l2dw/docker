# # Proxy:
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# # Timezone:
TZ=America/Montreal

# # Network:
DEFAULT_NETWORK_NAME=
DEFAULT_NETWORK_EXTERNAL=

# # TPL Volume:
TPL_VOLUME_NAME=
TPL_VOLUME_EXTERNAL=
#   persistent volume path: tpl-volume
TPL_HOST_VOLUME_PATH=
#   container volume path: /volumes/tp
TPL_CONTAINER_VOLUME_PATH=
## TPL Image:
TPL_IMAGE_REGISTRY=docker.io
TPL_IMAGE_PATH=tpl/tpl
TPL_IMAGE_TAG=latest
TPL_PULL_POLICY=
TPL_RESTART=
TPL_PRIVILEGED=
TPL_MEMORY_LIMIT=512M
## TPL Traefik:
TPL_DOMAIN=example.com
TPL_BASE_PATH=/tpl
TPL_TRAEFIK_ENABLE=true
TPL_TRAEFIK_ENTRYPOINTS=web
TPL_TRAEFIK_MIDDLEWARES=
TPL_TRAEFIK_TLS_ENABLE=false
TPL_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
## TPL Container:
TPL_CONTAINER_PORT=
TPL_CONTAINER_HOST_PORT=
TPL_CONTAINER_PORT_MODE=host
TPL_MEMORY_LIMIT=512M
## TPL Deploy:
TPL_DEPLOY_REPLICAS=1
TPL_DEPLOY_MODE=replicated
TPL_DEPLOY_PLACEMENT_CONSTRAINTS=
# ## TPL Deploy Placement (Swarm): leave empty → any eligible Linux node (scheduler picks). Pin when needed, e.g.:
# TPL_DEPLOY_PLACEMENT_CONSTRAINTS=node.role==worker
# TPL_DEPLOY_PLACEMENT_CONSTRAINTS=node.hostname==db-1
# TPL_DEPLOY_PLACEMENT_CONSTRAINTS=node.labels.name==tpl-1

