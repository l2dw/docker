# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Official image: https://hub.docker.com/_/memcached
# TCP 11211 — not an HTTP app. No Traefik/Homepage labels.

DEFAULT_NETWORK_NAME=memcached-network
DEFAULT_NETWORK_EXTERNAL=false

MEMCACHED_IMAGE=docker.io/library/memcached:1.6.45-alpine
MEMCACHED_RESTART=unless-stopped
MEMCACHED_PRIVILEGED=false
MEMCACHED_ENV_FILE=.env.example

# Unused (TCP only); kept for convention parity.
MEMCACHED_BASE_PATH=/
MEMCACHED_TRAEFIK_LABELS_SWARM_ENABLE=false
MEMCACHED_TRAEFIK_LABELS_DOCKER_ENABLE=false

# Process args (MB / connections / threads) — not the Swarm container memory limit.
MEMCACHED_CACHE_MEMORY=64
MEMCACHED_CONN_LIMIT=1024
MEMCACHED_THREADS=4

MEMCACHED_DEPLOY_MODE=replicated
MEMCACHED_DEPLOY_REPLICAS=1
MEMCACHED_PLACEMENT_CONSTRAINTS=node.platform.os==linux
MEMCACHED_MEMORY_LIMIT=1G
