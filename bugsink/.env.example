# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value
# - Generate SECRET_KEY: openssl rand -base64 50

# # Proxy:
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# # Timezone:
TZ=America/Montreal

# # Network:
DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

## BUGSINK
BUGSINK_IMAGE=bugsink/bugsink:2
BUGSINK_RESTART=unless-stopped
BUGSINK_PORT=8000
# Required — ≥50 chars (openssl rand -base64 50)
BUGSINK_SECRET_KEY=
# Initial admin only when DB has no users: email:password
BUGSINK_CREATE_SUPERUSER=admin@example.org:changeme
# Public URL (match Traefik host / TLS)
BUGSINK_BASE_URL=http://bugsink.example.com
BUGSINK_DOMAIN=bugsink.example.com
BUGSINK_BASE_PATH=/
# Empty = image SQLite at /data (dev only; WAL on Docker volumes unsupported).
# Production:
# BUGSINK_DATABASE_URL=postgresql://bugsink:CHANGE_ME@postgresql-server:5432/bugsink
BUGSINK_DATABASE_URL=
# Behind Traefik/HTTPS: set true / tune forwarded headers
BUGSINK_BEHIND_HTTPS_PROXY=false
BUGSINK_USE_X_FORWARDED_HOST=false
BUGSINK_USE_X_REAL_IP=true
BUGSINK_USE_X_FORWARDED_FOR=false
BUGSINK_X_FORWARDED_FOR_PROXY_COUNT=1
# Leave empty to use named volume bugsink_data → /data
BUGSINK_DATA=
BUGSINK_DATA_VOLUME_NAME=bugsink_data
BUGSINK_DATA_VOLUME_EXTERNAL=false
BUGSINK_REPLICAS=1
BUGSINK_SWARM_MODE=replicated
BUGSINK_MEMORY_LIMIT=512M

BUGSINK_TRAEFIK_ENTRYPOINTS=web
BUGSINK_TRAEFIK_MIDDLEWARES=
BUGSINK_TRAEFIK_TLS_ENABLED=false
BUGSINK_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
BUGSINK_HOMEPAGE_GROUP=
BUGSINK_HOMEPAGE_NAME=Bugsink
BUGSINK_HOMEPAGE_ICON=bugsink.png
BUGSINK_HOMEPAGE_HREF=http://bugsink.example.com
BUGSINK_HOMEPAGE_DESCRIPTION=
BUGSINK_HOMEPAGE_SITEMONITOR=http://bugsink.example.com
BUGSINK_HOMEPAGE_PING=
# Placement (Swarm): leave empty → any eligible Linux node (scheduler picks).
# Pin when needed, e.g.:
#   BUGSINK_PLACEMENT_CONSTRAINTS=node.role==worker
#   BUGSINK_PLACEMENT_CONSTRAINTS=node.hostname==db-1
#   BUGSINK_PLACEMENT_CONSTRAINTS=node.labels.disk==ssd
BUGSINK_PLACEMENT_CONSTRAINTS=
