# Bugsink — placeholders only. Production: BUGSINK_ENV_FILE=.env
# Docs: https://github.com/bugsink/bugsink
# Subpath via BASE_URL + Traefik strip (BUGSINK_MIDDLEWARES=bugsink-strip when BASE_PATH!=/).

APP_NAME=bugsink
DEFAULT_NETWORK_NAME=bugsink-network
DEFAULT_NETWORK_EXTERNAL=false
# Join Dokploy overlay: DEFAULT_NETWORK_NAME=dokploy-network (setup sets EXTERNAL=true).

BUGSINK_IMAGE=docker.io/bugsink/bugsink:2.6.1
BUGSINK_RESTART=unless-stopped
BUGSINK_PRIVILEGED=false
BUGSINK_ENV_FILE=.env.example

BUGSINK_DOMAIN=bugsink.example.com
BUGSINK_BASE_PATH=/bugsink
BUGSINK_BASE_URL=http://bugsink.example.com/bugsink
BUGSINK_PORT=8000
BUGSINK_ALLOWED_HOSTS=localhost,127.0.0.1,bugsink.example.com

# Required — ≥50 chars (openssl rand -base64 50). Generated by bugsink-setup if empty.
BUGSINK_SECRET_KEY=
BUGSINK_CREATE_SUPERUSER=admin@example.org:changeme
# Empty = image SQLite at /data (dev). Production: postgresql://...
BUGSINK_DATABASE_URL=

BUGSINK_BEHIND_HTTPS_PROXY=false
BUGSINK_USE_X_FORWARDED_HOST=false
BUGSINK_USE_X_FORWARDED_FOR=false
BUGSINK_X_FORWARDED_FOR_PROXY_COUNT=1

BUGSINK_TRAEFIK_LABELS_SWARM_ENABLE=true
BUGSINK_TRAEFIK_LABELS_DOCKER_ENABLE=true
BUGSINK_ENTRYPOINTS=web
# Host-only (/): leave empty. Subpath: bugsink-strip
BUGSINK_MIDDLEWARES=bugsink-strip
BUGSINK_TLS_ENABLED=false
BUGSINK_TLS_CERTRESOLVER=letsencrypt

BUGSINK_DEPLOY_MODE=replicated
BUGSINK_DEPLOY_REPLICAS=1
BUGSINK_PLACEMENT_CONSTRAINTS=node.platform.os==linux
BUGSINK_RESTART_POLICY_CONDITION=any
BUGSINK_RESTART_POLICY_DELAY=5s
BUGSINK_RESTART_POLICY_MAX_ATTEMPTS=3
BUGSINK_MEMORY_LIMIT=512M

BUGSINK_DATA_VOLUME_NAME=bugsink_data
BUGSINK_DATA_VOLUME_EXTERNAL=false
BUGSINK_DATA_VOLUME_DRIVER=local
BUGSINK_DATA_VOLUME_TYPE=
BUGSINK_DATA_VOLUME_OPTS=
BUGSINK_DATA_VOLUME_PATH=
BUGSINK_DATA_VOLUME_DIR=/data

BUGSINK_HOMEPAGE_GROUP=Observability
BUGSINK_HOMEPAGE_NAME=Bugsink
BUGSINK_HOMEPAGE_ICON=bugsink.png
BUGSINK_HOMEPAGE_DESCRIPTION=Self-hosted error tracking
BUGSINK_HOMEPAGE_URL=
BUGSINK_HOMEPAGE_SITEMONITOR=http://bugsink:8000/health/ready
