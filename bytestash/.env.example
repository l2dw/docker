# ByteStash — placeholders only. Production: BYTESTASH_ENV_FILE=.env
# Docs: https://github.com/jordan-dalby/ByteStash/wiki/FAQ#environment-variables
# Image publishes mainly :latest on ghcr.io/jordan-dalby/bytestash

APP_NAME=bytestash
DEFAULT_NETWORK_NAME=bytestash-network
DEFAULT_NETWORK_EXTERNAL=false

BYTESTASH_IMAGE=ghcr.io/jordan-dalby/bytestash:latest
BYTESTASH_RESTART=unless-stopped
BYTESTASH_PRIVILEGED=false
BYTESTASH_ENV_FILE=.env.example

BYTESTASH_DOMAIN=bytestash.example.com
BYTESTASH_BASE_PATH=/bytestash
BYTESTASH_PORT=5000
BYTESTASH_ALLOWED_HOSTS=localhost,127.0.0.1,bytestash.example.com

BYTESTASH_JWT_SECRET=
BYTESTASH_TOKEN_EXPIRY=24h
BYTESTASH_ALLOW_NEW_ACCOUNTS=true
BYTESTASH_DEBUG=false
BYTESTASH_DISABLE_ACCOUNTS=false
BYTESTASH_DISABLE_INTERNAL_ACCOUNTS=false
BYTESTASH_OIDC_ENABLED=false
BYTESTASH_OIDC_DISPLAY_NAME=
BYTESTASH_OIDC_ISSUER_URL=
BYTESTASH_OIDC_CLIENT_ID=
BYTESTASH_OIDC_CLIENT_SECRET=
BYTESTASH_OIDC_SCOPES=

BYTESTASH_TRAEFIK_LABELS_SWARM_ENABLE=true
BYTESTASH_TRAEFIK_LABELS_DOCKER_ENABLE=true
BYTESTASH_ENTRYPOINTS=web
BYTESTASH_MIDDLEWARES=
BYTESTASH_TLS_ENABLED=false
BYTESTASH_TLS_CERTRESOLVER=letsencrypt

BYTESTASH_DEPLOY_MODE=replicated
BYTESTASH_DEPLOY_REPLICAS=1
BYTESTASH_PLACEMENT_CONSTRAINTS=node.platform.os==linux
BYTESTASH_RESTART_POLICY_CONDITION=any
BYTESTASH_RESTART_POLICY_DELAY=5s
BYTESTASH_RESTART_POLICY_MAX_ATTEMPTS=3
BYTESTASH_MEMORY_LIMIT=512M

BYTESTASH_DATA_VOLUME_NAME=bytestash_data
BYTESTASH_DATA_VOLUME_EXTERNAL=false
BYTESTASH_DATA_VOLUME_DRIVER=local
BYTESTASH_DATA_VOLUME_TYPE=
BYTESTASH_DATA_VOLUME_OPTS=
BYTESTASH_DATA_VOLUME_PATH=
BYTESTASH_DATA_VOLUME_DIR=/data/snippets

BYTESTASH_HOMEPAGE_GROUP=Productivity
BYTESTASH_HOMEPAGE_NAME=ByteStash
BYTESTASH_HOMEPAGE_ICON=bytestash.png
BYTESTASH_HOMEPAGE_DESCRIPTION=Code snippet manager
BYTESTASH_HOMEPAGE_URL=
BYTESTASH_HOMEPAGE_SITEMONITOR=http://bytestash:5000
