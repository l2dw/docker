# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Periodic one-way rclone copy/sync between two targets. Each side (SRC / DST) is an
# s3 bucket or a local path. No build: official rclone image, entrypoint delivered as a config.
# No HTTP UI — Traefik omitted. Subpath N/A (S3_MIRROR_BASE_PATH=/).
# Values must stay shell-safe (no spaces or parentheses): this file is sourced by Make/Dokploy.

APP_NAME=s3-mirror
TZ=America/Montreal

DEFAULT_NETWORK_NAME=s3-mirror-network
DEFAULT_NETWORK_EXTERNAL=false

S3_MIRROR_IMAGE=docker.io/rclone/rclone:1.68.2
S3_MIRROR_RESTART=unless-stopped
S3_MIRROR_PRIVILEGED=false
S3_MIRROR_ENV_FILE=.env.example
S3_MIRROR_BASE_PATH=/
S3_MIRROR_ENTRYPOINT_CONFIG_NAME=s3_mirror_entrypoint_v1

# sync (default) = DST becomes identical to SRC (deletions propagate,
# capped by MAX_DELETE per pass; enable bucket versioning to keep deleted files) ; copy = never delete on DST.
# Container user (uid:gid) and umask: use e.g. 977:1001 and 002 when DST is a shared host directory so that
# written files keep the owner/group of the existing ones instead of root.
S3_MIRROR_USER=0:0
S3_MIRROR_UMASK=022
S3_MIRROR_MODE=sync
S3_MIRROR_INTERVAL=3600
# Comma-separated rclone patterns, e.g. logs/**,*.tmp
S3_MIRROR_EXCLUDE=
S3_MIRROR_MAX_DELETE=10
# false = compare size + modification time ; true = compare hashes (needs hashes on both sides: some S3
# backends return none for streamed uploads and rclone then compares sizes only)
S3_MIRROR_CHECKSUM=false
# Extra rclone flags (space-separated, no quotes)
S3_MIRROR_RCLONE_OPTS=
S3_MIRROR_S3_PROVIDER=Other
S3_MIRROR_S3_FORCE_PATH_STYLE=true

# SRC / DST: TYPE=s3 (ENDPOINT, ACCESS_KEY, SECRET_KEY, BUCKET, optional PREFIX) or TYPE=path
# (PATH relative to the side volume, empty = the volume root).
S3_MIRROR_SRC_TYPE=path
S3_MIRROR_SRC_ENDPOINT=
S3_MIRROR_SRC_ACCESS_KEY=
S3_MIRROR_SRC_SECRET_KEY=
S3_MIRROR_SRC_BUCKET=
S3_MIRROR_SRC_PREFIX=
S3_MIRROR_SRC_PATH=
S3_MIRROR_DST_TYPE=s3
S3_MIRROR_DST_ENDPOINT=http://rustfs:9000
S3_MIRROR_DST_ACCESS_KEY=
S3_MIRROR_DST_SECRET_KEY=
S3_MIRROR_DST_BUCKET=appdata
S3_MIRROR_DST_PREFIX=homepage/config
S3_MIRROR_DST_PATH=

# global = 1 task per Ready node (compose omits replicas — Swarm rejects replicas+global).
# replicated = default 1 replica; scale with `docker service scale` if needed.
S3_MIRROR_DEPLOY_MODE=replicated
S3_MIRROR_DEPLOY_REPLICAS=1
S3_MIRROR_PLACEMENT_CONSTRAINTS=node.platform.os==linux
S3_MIRROR_RESTART_POLICY_CONDITION=any
S3_MIRROR_RESTART_POLICY_DELAY=5s
S3_MIRROR_RESTART_POLICY_MAX_ATTEMPTS=0
S3_MIRROR_MEMORY_LIMIT=256M

# Volumes — NAME is a short Docker volume name. SRC is mounted read-only at /src, DST at /dst.
# Recipes (TYPE / OPTS / PATH):
#   Local named (default): TYPE=  OPTS=  PATH=
#   Bind:                  TYPE=none  OPTS=bind  PATH=/appdata/homepage/config
#   NFS:                   TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/s3-mirror
# An existing volume with the same NAME is reused as-is (no `external:` key).
S3_MIRROR_SRC_VOLUME_NAME=s3-mirror_src
S3_MIRROR_SRC_VOLUME_DRIVER=local
S3_MIRROR_SRC_VOLUME_TYPE=
S3_MIRROR_SRC_VOLUME_OPTS=
S3_MIRROR_SRC_VOLUME_PATH=
S3_MIRROR_SRC_VOLUME_DIR=/src
S3_MIRROR_DST_VOLUME_NAME=s3-mirror_dst
S3_MIRROR_DST_VOLUME_DRIVER=local
S3_MIRROR_DST_VOLUME_TYPE=
S3_MIRROR_DST_VOLUME_OPTS=
S3_MIRROR_DST_VOLUME_PATH=
S3_MIRROR_DST_VOLUME_DIR=/dst

# Homepage
S3_MIRROR_HOMEPAGE_GROUP=Infra
S3_MIRROR_HOMEPAGE_NAME=s3-mirror
S3_MIRROR_HOMEPAGE_ICON=s3.png
S3_MIRROR_HOMEPAGE_DESCRIPTION=Periodic-rclone-mirror
S3_MIRROR_HOMEPAGE_URL=
S3_MIRROR_HOMEPAGE_SITEMONITOR=
