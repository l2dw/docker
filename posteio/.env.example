# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Docs: https://poste.io/doc  Image: docker.io/analogic/poste.io (free Hub).
# Subpath is NOT supported. HTTPS=OFF: Traefik terminates TLS (do not publish 80/443 on the host).

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=false

POSTEIO_IMAGE=docker.io/analogic/poste.io:latest
POSTEIO_RESTART=unless-stopped
POSTEIO_PRIVILEGED=false
POSTEIO_ENV_FILE=.env.example

# FQDN of the MX host (container hostname). Align A/AAAA + PTR with this name.
POSTEIO_HOSTNAME=mail.example.com
POSTEIO_DOMAIN=mail.example.com
POSTEIO_BASE_PATH=/
POSTEIO_APP_URL=http://mail.example.com

# OFF = no redirect to container HTTPS (required behind Traefik).
POSTEIO_HTTPS=OFF
POSTEIO_DISABLE_CLAMAV=
POSTEIO_DISABLE_RSPAMD=

POSTEIO_TRAEFIK_LABELS_SWARM_ENABLE=true
POSTEIO_TRAEFIK_LABELS_DOCKER_ENABLE=true
POSTEIO_ENTRYPOINTS=web
POSTEIO_MIDDLEWARES=
POSTEIO_TLS_ENABLED=false
POSTEIO_TLS_CERTRESOLVER=letsencrypt

POSTEIO_DEPLOY_MODE=replicated
POSTEIO_DEPLOY_REPLICAS=1
POSTEIO_PLACEMENT_CONSTRAINTS=node.role==manager
POSTEIO_MEMORY_LIMIT=2G

# Mail ports (host mode — pin on a manager). Do not publish 80/443.
POSTEIO_PORT_MODE=host
POSTEIO_PORT_SMTP=25
POSTEIO_PORT_SMTPS=465
POSTEIO_PORT_SUBMISSION=587
POSTEIO_PORT_IMAPS=993
POSTEIO_PORT_POP3S=995
POSTEIO_PORT_SIEVE=4190

POSTEIO_DATA_DIR=
POSTEIO_DATA_VOLUME_NAME=posteio-data
POSTEIO_DATA_VOLUME_EXTERNAL=false

POSTEIO_HOMEPAGE_GROUP=Mail
POSTEIO_HOMEPAGE_NAME=Poste.io
POSTEIO_HOMEPAGE_ICON=mail.png
POSTEIO_HOMEPAGE_DESCRIPTION=Mail server admin and webmail
POSTEIO_HOMEPAGE_SITEMONITOR=http://posteio:80
