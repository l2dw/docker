# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Official image: https://hub.docker.com/_/redis
# Not an HTTP app — no Traefik PathPrefix. REDIS_BASE_PATH=/ is unused.
# Official redis does not read REDIS_ARGS / REDIS_PASSWORD as server config;
# compose interpolates REDIS_PASSWORD onto `redis-server --requirepass`.

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

REDIS_IMAGE=docker.io/library/redis:7-alpine
REDIS_RESTART=unless-stopped
REDIS_PRIVILEGED=false
REDIS_ENV_FILE=.env.example
REDIS_BASE_PATH=/
REDIS_TRAEFIK_LABELS_SWARM_ENABLE=false
REDIS_TRAEFIK_LABELS_DOCKER_ENABLE=false

# Generated by `make redis-setup` if empty. Placeholder only — never commit real secrets.
REDIS_PASSWORD=

REDIS_DATA_VOLUME_NAME=redis-data
REDIS_DATA_VOLUME_EXTERNAL=false
REDIS_DATA_DIR=redis-data
REDIS_DATA_CONTAINER_PATH=/data

# Overlay DNS alias for other stacks (e.g. AUTHENTIK_REDIS__HOST=dokploy-redis). Service name `redis` still works.
REDIS_NETWORK_ALIAS=dokploy-redis

REDIS_DEPLOY_MODE=replicated
REDIS_DEPLOY_REPLICAS=1
REDIS_PLACEMENT_CONSTRAINTS=node.platform.os==linux
REDIS_MEMORY_LIMIT=256M
