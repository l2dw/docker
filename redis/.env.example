# Redis — placeholders only. Production: REDIS_ENV_FILE=.env
# Official image: https://hub.docker.com/_/redis
# TCP only — no Traefik. REDIS_BASE_PATH=/ unused.
# Compose interpolates REDIS_PASSWORD onto `redis-server --requirepass`.

APP_NAME=redis
DEFAULT_NETWORK_NAME=redis-network
DEFAULT_NETWORK_EXTERNAL=false

REDIS_IMAGE=docker.io/library/redis:7-alpine
REDIS_RESTART=unless-stopped
REDIS_PRIVILEGED=false
REDIS_ENV_FILE=.env.example
REDIS_BASE_PATH=/
REDIS_TRAEFIK_LABELS_SWARM_ENABLE=false
REDIS_TRAEFIK_LABELS_DOCKER_ENABLE=false

# Generated by `make redis-setup` if empty.
REDIS_PASSWORD=

# Volume key `data` → /data
# Local named (default): leave TYPE/OPTS/PATH empty.
# Bind: TYPE=none OPTS=bind PATH=/appdata/redis
# NFS: TYPE=nfs OPTS=addr=host,rw,nfsvers=4 PATH=:/exports/redis
REDIS_DATA_VOLUME_NAME=redis_data
REDIS_DATA_VOLUME_EXTERNAL=false
REDIS_DATA_VOLUME_DRIVER=local
REDIS_DATA_VOLUME_TYPE=
REDIS_DATA_VOLUME_OPTS=
REDIS_DATA_VOLUME_PATH=
REDIS_DATA_VOLUME_DIR=/data


REDIS_DEPLOY_MODE=replicated
REDIS_DEPLOY_REPLICAS=1
REDIS_PLACEMENT_CONSTRAINTS=node.platform.os==linux
REDIS_RESTART_POLICY_CONDITION=any
REDIS_RESTART_POLICY_DELAY=5s
REDIS_RESTART_POLICY_MAX_ATTEMPTS=3
REDIS_MEMORY_LIMIT=1G

REDIS_HOMEPAGE_GROUP=Infrastructure
REDIS_HOMEPAGE_NAME=Redis
REDIS_HOMEPAGE_ICON=redis.png
REDIS_HOMEPAGE_DESCRIPTION=In-memory data store
REDIS_HOMEPAGE_URL=
REDIS_HOMEPAGE_SITEMONITOR=
