# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://www.meilisearch.com/docs/learn/self_hosted/install_meilisearch_locally
# Overlay-only (7700 not published). DNS alias: MEILISEARCH_NETWORK_ALIAS (default meilisearch).
# MEILISEARCH_BASE_PATH=/ is unused (no Traefik).

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

MEILISEARCH_IMAGE=docker.io/getmeili/meilisearch:v1.37
MEILISEARCH_RESTART=unless-stopped
MEILISEARCH_PRIVILEGED=false
MEILISEARCH_ENV_FILE=.env.example
MEILISEARCH_BASE_PATH=/

# Generated by make meilisearch-setup if empty (openssl, alphanumeric).
MEILISEARCH_MASTER_KEY=

MEILISEARCH_ENV=production
MEILISEARCH_NO_ANALYTICS=true
MEILISEARCH_HTTP_ADDR=0.0.0.0:7700
MEILISEARCH_NETWORK_ALIAS=meilisearch

MEILISEARCH_DEPLOY_MODE=replicated
MEILISEARCH_DEPLOY_REPLICAS=1
MEILISEARCH_PLACEMENT_CONSTRAINTS=node.platform.os==linux
MEILISEARCH_MEMORY_LIMIT=512M

MEILISEARCH_DATA_DIR=
MEILISEARCH_DATA_VOLUME_NAME=meilisearch-data
MEILISEARCH_DATA_VOLUME_EXTERNAL=false
