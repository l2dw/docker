# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://www.meilisearch.com/docs/learn/self_hosted/install_meilisearch_locally
# No vendor BASE_PATH — default Host-only (BASE_PATH=/). Optional subpath: see README.
# Overlay alias: MEILISEARCH_NETWORK_ALIAS (e.g. Karakeep → http://meilisearch:7700).

APP_NAME=meilisearch
DEFAULT_NETWORK_NAME=meilisearch-network
DEFAULT_NETWORK_EXTERNAL=false

MEILISEARCH_IMAGE=docker.io/getmeili/meilisearch:v1.37
MEILISEARCH_RESTART=unless-stopped
MEILISEARCH_PRIVILEGED=false
MEILISEARCH_ENV_FILE=.env.example
MEILISEARCH_PORT=7700

# Public hostname (DNS → Traefik). Default Host-only (no PathPrefix strip).
MEILISEARCH_DOMAIN=meilisearch.example.com
MEILISEARCH_BASE_PATH=/
MEILISEARCH_APP_URL=http://meilisearch.example.com/
# Subpath example (API via Traefik strip; mini-dashboard may break):
# MEILISEARCH_BASE_PATH=/meilisearch
# MEILISEARCH_APP_URL=http://meilisearch.example.com/meilisearch
# MEILISEARCH_MIDDLEWARES=meilisearch-strip

# Generated by make meilisearch-setup if empty (openssl, alphanumeric).
MEILISEARCH_MASTER_KEY=

MEILISEARCH_ENV=production
MEILISEARCH_NO_ANALYTICS=true
MEILISEARCH_HTTP_ADDR=0.0.0.0:7700
MEILISEARCH_NETWORK_ALIAS=meilisearch

MEILISEARCH_TRAEFIK_LABELS_SWARM_ENABLE=true
MEILISEARCH_TRAEFIK_LABELS_DOCKER_ENABLE=true
MEILISEARCH_ENTRYPOINTS=web
MEILISEARCH_MIDDLEWARES=
MEILISEARCH_TLS_ENABLED=false
MEILISEARCH_TLS_CERTRESOLVER=letsencrypt

MEILISEARCH_DEPLOY_MODE=replicated
MEILISEARCH_DEPLOY_REPLICAS=1
MEILISEARCH_PLACEMENT_CONSTRAINTS=node.platform.os==linux
MEILISEARCH_MEMORY_LIMIT=512M
MEILISEARCH_RESTART_POLICY_CONDITION=any
MEILISEARCH_RESTART_POLICY_DELAY=5s
MEILISEARCH_RESTART_POLICY_MAX_ATTEMPTS=3

# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Multi-instance / Dokploy: use a distinct NAME per app when needed (meilisearch_data_01, …).
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/meilisearch
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/meilisearch
#   External:              EXTERNAL=true   (pre-create: docker volume create meilisearch_data)
#   # MEILISEARCH_DATA_VOLUME_TYPE=none
#   # MEILISEARCH_DATA_VOLUME_OPTS=bind
#   # MEILISEARCH_DATA_VOLUME_PATH=/appdata/meilisearch
MEILISEARCH_DATA_VOLUME_NAME=meilisearch_data
MEILISEARCH_DATA_VOLUME_EXTERNAL=false
MEILISEARCH_DATA_VOLUME_DRIVER=local
MEILISEARCH_DATA_VOLUME_TYPE=
MEILISEARCH_DATA_VOLUME_OPTS=
MEILISEARCH_DATA_VOLUME_PATH=
MEILISEARCH_DATA_VOLUME_DIR=/meili_data

MEILISEARCH_HOMEPAGE_GROUP=Search
MEILISEARCH_HOMEPAGE_NAME=Meilisearch
MEILISEARCH_HOMEPAGE_ICON=meilisearch.png
MEILISEARCH_HOMEPAGE_DESCRIPTION=Search engine
MEILISEARCH_HOMEPAGE_URL=
MEILISEARCH_HOMEPAGE_SITEMONITOR=http://meilisearch:7700/health
