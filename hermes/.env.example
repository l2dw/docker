# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Docs: https://hermes-agent.nousresearch.com/docs/getting-started/installation
# WebUI: https://github.com/nesquena/hermes-webui

DEFAULT_NETWORK_NAME=hermes-network
DEFAULT_NETWORK_EXTERNAL=false

HERMES_ENV_FILE=.env.example

HERMES_AGENT_IMAGE=nousresearch/hermes-agent:latest
HERMES_DASHBOARD_IMAGE=nousresearch/hermes-agent:latest
HERMES_WEBUI_IMAGE=ghcr.io/nesquena/hermes-webui:latest

HERMES_AGENT_RESTART=unless-stopped
HERMES_DASHBOARD_RESTART=unless-stopped
HERMES_WEBUI_RESTART=unless-stopped
HERMES_AGENT_PRIVILEGED=false
HERMES_DASHBOARD_PRIVILEGED=false
HERMES_WEBUI_PRIVILEGED=false

# Shared state (~/.hermes). Named volumes by default (Dokploy-friendly).
HERMES_HOME_VOLUME_NAME=hermes-home
HERMES_HOME_VOLUME_EXTERNAL=false
HERMES_HOME_DIR=hermes-home
HERMES_AGENT_SRC_VOLUME_NAME=hermes-agent-src
HERMES_AGENT_SRC_VOLUME_EXTERNAL=false
HERMES_AGENT_SRC_DIR=hermes-agent-src
HERMES_WORKSPACE_VOLUME_NAME=hermes-workspace
HERMES_WORKSPACE_VOLUME_EXTERNAL=false
HERMES_WORKSPACE_DIR=hermes-workspace

# Align UID/GID across agent / dashboard / webui (default 1000).
HERMES_UID=1000
HERMES_GID=1000

# Gateway API (port 8642, internal). Generated by hermes-setup if empty (<16 chars).
HERMES_API_SERVER_KEY=
HERMES_GATEWAY_URL=http://agent:8642

# Web UI — set a password before exposing via Traefik.
HERMES_WEBUI_PASSWORD=ChangeMe

# Dashboard auth (required for --host 0.0.0.0; --insecure no longer bypasses the gate).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=ChangeMe
# Session signing key — generated by hermes-setup if empty (sessions survive restarts).
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

HERMES_DOMAIN=hermes.example.com
HERMES_BASE_PATH=/
HERMES_APP_URL=https://hermes.example.com

HERMES_DASHBOARD_DOMAIN=hermes-dashboard.example.com
HERMES_DASHBOARD_BASE_PATH=/
HERMES_DASHBOARD_APP_URL=https://hermes-dashboard.example.com

HERMES_TRAEFIK_LABELS_SWARM_ENABLE=true
HERMES_TRAEFIK_LABELS_DOCKER_ENABLE=true
HERMES_ENTRYPOINTS=websecure
HERMES_MIDDLEWARES=
HERMES_HTTP_MIDDLEWARES=redirect-to-https@swarm
HERMES_TLS_ENABLED=true
HERMES_TLS_CERTRESOLVER=

HERMES_DASHBOARD_ENTRYPOINTS=websecure
HERMES_DASHBOARD_MIDDLEWARES=
HERMES_DASHBOARD_HTTP_MIDDLEWARES=redirect-to-https@swarm
HERMES_DASHBOARD_TLS_ENABLED=true
HERMES_DASHBOARD_TLS_CERTRESOLVER=

HERMES_AGENT_DEPLOY_MODE=replicated
HERMES_DASHBOARD_DEPLOY_MODE=replicated
HERMES_WEBUI_DEPLOY_MODE=replicated
HERMES_AGENT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HERMES_DASHBOARD_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HERMES_WEBUI_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HERMES_AGENT_MEMORY_LIMIT=2G
HERMES_DASHBOARD_MEMORY_LIMIT=512M
HERMES_WEBUI_MEMORY_LIMIT=1G

HERMES_HOMEPAGE_GROUP=Apps
HERMES_HOMEPAGE_NAME=Hermes
HERMES_HOMEPAGE_ICON=hermes.png
HERMES_HOMEPAGE_DESCRIPTION=Hermes Agent Web UI
HERMES_HOMEPAGE_SITEMONITOR=http://webui:8787
HERMES_DASHBOARD_HOMEPAGE_NAME=Hermes Dashboard
HERMES_DASHBOARD_HOMEPAGE_ICON=hermes.png
HERMES_DASHBOARD_HOMEPAGE_DESCRIPTION=Hermes monitoring dashboard
HERMES_DASHBOARD_HOMEPAGE_SITEMONITOR=http://dashboard:9119
