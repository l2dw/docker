# OpenBao — placeholders only. Production: OPENBAO_ENV_FILE=.env
# Image: https://hub.docker.com/r/openbao/openbao
# Docs: https://openbao.org/docs/
# File storage at /openbao/file (not -dev). After first boot: bao operator init + unseal.
# TLS disabled on listener — terminate TLS at Traefik. disable_mlock required in containers.
# Subpath unsupported — keep OPENBAO_BASE_PATH=/ (Host-only subdomain). UI at /ui.

APP_NAME=openbao
DEFAULT_NETWORK_NAME=openbao-network
DEFAULT_NETWORK_EXTERNAL=false

OPENBAO_IMAGE=docker.io/openbao/openbao:2.7.1
OPENBAO_HOSTNAME=openbao
OPENBAO_RESTART=unless-stopped
OPENBAO_PRIVILEGED=false
OPENBAO_ENV_FILE=.env.example

# Traefik HTTP :8200. Subpath unsupported — keep BASE_PATH=/
OPENBAO_DOMAIN=openbao.example.com
OPENBAO_BASE_PATH=/
OPENBAO_APP_URL=http://openbao.example.com/
OPENBAO_API_ADDR=http://openbao.example.com
OPENBAO_ENTRYPOINTS=web
OPENBAO_MIDDLEWARES=
OPENBAO_TLS_ENABLED=false
OPENBAO_TLS_CERTRESOLVER=letsencrypt
OPENBAO_TRAEFIK_LABELS_SWARM_ENABLE=true
OPENBAO_TRAEFIK_LABELS_DOCKER_ENABLE=true
OPENBAO_HTTP_PORT=8200

# Inline JSON config (loaded by the image via BAO_LOCAL_CONFIG). Override for raft/TLS/etc.
OPENBAO_LOCAL_CONFIG={"ui":true,"disable_mlock":true,"listener":[{"tcp":{"address":"0.0.0.0:8200","tls_disable":true}}],"storage":{"file":{"path":"/openbao/file"}}}

# Volumes
OPENBAO_DATA_VOLUME_NAME=openbao_data
OPENBAO_DATA_VOLUME_EXTERNAL=false
OPENBAO_DATA_VOLUME_DRIVER=local
OPENBAO_DATA_VOLUME_TYPE=
OPENBAO_DATA_VOLUME_OPTS=
OPENBAO_DATA_VOLUME_PATH=
OPENBAO_DATA_VOLUME_DIR=/openbao/file

OPENBAO_DEPLOY_MODE=replicated
OPENBAO_DEPLOY_REPLICAS=1
OPENBAO_MEMORY_LIMIT=1G
OPENBAO_PLACEMENT_CONSTRAINTS=node.platform.os==linux
OPENBAO_RESTART_POLICY_CONDITION=any
OPENBAO_RESTART_POLICY_DELAY=5s
OPENBAO_RESTART_POLICY_MAX_ATTEMPTS=3

OPENBAO_HOMEPAGE_GROUP=Security
OPENBAO_HOMEPAGE_NAME=OpenBao
OPENBAO_HOMEPAGE_ICON=vault.png
OPENBAO_HOMEPAGE_DESCRIPTION=Secrets management
OPENBAO_HOMEPAGE_SITEMONITOR=http://openbao:8200/v1/sys/health
