# loki stack — see loki/README.md. Copy to loki/.env (make loki-setup) and to the root .env.
# App config (loki/config/loki.yaml) only contains ${VAR} placeholders: every value below is an env
# override (Dokploy environment / Vault Provider references). Secrets: leave empty here.

APP_NAME=loki

# Network — default stack-local overlay. Shared Dokploy overlay: dokploy-network + EXTERNAL=true.
DEFAULT_NETWORK_NAME=loki-network
DEFAULT_NETWORK_EXTERNAL=false

LOKI_IMAGE=docker.io/grafana/loki:3.7.10
LOKI_RESTART=unless-stopped
LOKI_PRIVILEGED=false
# Compose env_file (relative to loki/); environment: overrides it. Production: .env
LOKI_ENV_FILE=.env.example
# Swarm config name (immutable): bump _vN after editing config/loki.yaml
LOKI_CONFIG_NAME=loki_config_v1
LOKI_PORT=3100

# App configuration (expanded into the config file)
LOKI_HTTP_PORT=3100
LOKI_GRPC_PORT=9096
LOKI_LOG_LEVEL=info
LOKI_RETENTION=720h
LOKI_STORAGE_BACKEND=filesystem
LOKI_SCHEMA_FROM=2026-01-01
LOKI_DATA_DIR=/loki
LOKI_S3_ENDPOINT=s3:9000
LOKI_S3_BUCKET=loki
LOKI_S3_REGION=us-east-1
LOKI_S3_ACCESS_KEY=
LOKI_S3_SECRET_KEY=
LOKI_S3_INSECURE=true
LOKI_S3_FORCE_PATH_STYLE=true

# Homepage
LOKI_HOMEPAGE_GROUP=Observability
LOKI_HOMEPAGE_NAME=Loki
LOKI_HOMEPAGE_ICON=loki.png
LOKI_HOMEPAGE_DESCRIPTION=Logs-backend-OTLP
LOKI_HOMEPAGE_URL=
LOKI_HOMEPAGE_SITEMONITOR=http://loki:3100/ready

# Deploy
LOKI_DEPLOY_MODE=replicated
LOKI_DEPLOY_REPLICAS=1
LOKI_MEMORY_LIMIT=1G
LOKI_PLACEMENT_CONSTRAINTS=node.platform.os==linux
LOKI_RESTART_POLICY_CONDITION=any
LOKI_RESTART_POLICY_DELAY=5s
LOKI_RESTART_POLICY_MAX_ATTEMPTS=3

# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/loki
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/loki
#   External:              EXTERNAL=true   (pre-create: docker volume create loki_data)
LOKI_DATA_VOLUME_NAME=loki_data
LOKI_DATA_VOLUME_EXTERNAL=false
LOKI_DATA_VOLUME_DRIVER=local
LOKI_DATA_VOLUME_TYPE=
LOKI_DATA_VOLUME_OPTS=
LOKI_DATA_VOLUME_PATH=
LOKI_DATA_VOLUME_DIR=/loki
