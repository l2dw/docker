# elastic-agent stack — Elastic Agent enrolled in Fleet (node metrics: System + Docker integrations).
# Copy to elastic-agent/.env (make elastic-agent-setup). Never commit values.
# Secret: FLEET_ENROLLMENT_TOKEN goes ONLY in the file referenced by ELASTIC_AGENT_ENV_FILE (e.g. /etc/dokploy/secrets/<app>.env, 0600).

APP_NAME=elastic-agent
TZ=America/Toronto

DEFAULT_NETWORK_NAME=elastic-agent-network
DEFAULT_NETWORK_EXTERNAL=false

ELASTIC_AGENT_IMAGE=docker.elastic.co/beats/elastic-agent:8.17.0
# Set to the node name so host.name is meaningful in Elasticsearch.
ELASTIC_AGENT_HOSTNAME=elastic-agent
ELASTIC_AGENT_RESTART=unless-stopped
ELASTIC_AGENT_PRIVILEGED=false
ELASTIC_AGENT_ENV_FILE=.env.example

# Fleet Server URL as seen from this node, and enrollment settings.
ELASTIC_AGENT_FLEET_URL=https://fleet.example.com/fleet
ELASTIC_AGENT_ENROLL=1
ELASTIC_AGENT_INSECURE=1
ELASTIC_AGENT_TAGS=
# FLEET_ENROLLMENT_TOKEN=   (env_file only)

# Host path mounted read-only as /hostfs (System integration) and runtime socket (Docker integration).
ELASTIC_AGENT_HOSTFS=/
ELASTIC_AGENT_DOCKER_SOCK=/var/run/docker.sock

# Data volume (agent state). Recipes: local named (default) / bind / NFS / external.
#   bind:     TYPE=none  OPTS=bind  PATH=/srv/elastic-agent/data
#   NFS:      TYPE=nfs   OPTS=addr=<nfs-host>,rw,nfsvers=4  PATH=:/export/elastic-agent
#   external: EXTERNAL=true (create the volume beforehand)
ELASTIC_AGENT_DATA_VOLUME_NAME=elastic_agent_data
ELASTIC_AGENT_DATA_VOLUME_EXTERNAL=false
ELASTIC_AGENT_DATA_VOLUME_DRIVER=local
ELASTIC_AGENT_DATA_VOLUME_TYPE=
ELASTIC_AGENT_DATA_VOLUME_OPTS=
ELASTIC_AGENT_DATA_VOLUME_PATH=
ELASTIC_AGENT_DATA_VOLUME_DIR=/usr/share/elastic-agent/state

ELASTIC_AGENT_DEPLOY_MODE=global
ELASTIC_AGENT_MEMORY_LIMIT=1G
ELASTIC_AGENT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
ELASTIC_AGENT_RESTART_POLICY_CONDITION=any
ELASTIC_AGENT_RESTART_POLICY_DELAY=5s
ELASTIC_AGENT_RESTART_POLICY_MAX_ATTEMPTS=3

ELASTIC_AGENT_HOMEPAGE_GROUP=Search
ELASTIC_AGENT_HOMEPAGE_NAME=Elastic Agent
ELASTIC_AGENT_HOMEPAGE_ICON=elasticsearch.png
ELASTIC_AGENT_HOMEPAGE_DESCRIPTION=Elastic Agent (node metrics via Fleet)
ELASTIC_AGENT_HOMEPAGE_URL=
ELASTIC_AGENT_HOMEPAGE_SITEMONITOR=
