# DeepSeek Harness Web UI — placeholders only.
# Production: DSH_ENV_FILE=.env
# Upstream: https://github.com/deepseek-ai/deepseek-harness
# Image: ghcr.io/xidong-ai/deepseek-harness-web-docker

APP_NAME=dsh
DEFAULT_NETWORK_NAME=dsh-network
DEFAULT_NETWORK_EXTERNAL=false

DSH_IMAGE=ghcr.io/xidong-ai/deepseek-harness-web-docker:latest
DSH_RESTART=unless-stopped
DSH_PRIVILEGED=false
DSH_ENV_FILE=.env.example
DSH_HOME=/home/node
DSH_DEEPSEEK_API_KEY=ChangeMe
DSH_TRUSTED_HOSTS=localhost,127.0.0.1
DSH_PUBLIC_URL=http://dsh.example.com/

# Subpath unsupported by vendor (root-absolute assets/API). Prefer Host-only / subdomain.
DSH_BASE_PATH=/
DSH_DOMAIN=dsh.example.com
DSH_APP_URL=http://dsh.example.com/

DSH_PORT=3080
DSH_PUBLISHED_PORT=3080
DSH_PORT_MODE=ingress
DSH_PORT_PROTOCOL=tcp
DSH_NETWORK_ALIAS=deepseek-harness
DSH_TRAEFIK_LABELS_SWARM_ENABLE=true
DSH_TRAEFIK_LABELS_DOCKER_ENABLE=true
DSH_ENTRYPOINTS=web
DSH_MIDDLEWARES=
DSH_TLS_ENABLED=false
DSH_TLS_CERTRESOLVER=letsencrypt

DSH_DEPLOY_MODE=replicated
DSH_DEPLOY_REPLICAS=1
DSH_PLACEMENT_CONSTRAINTS=node.platform.os==linux
DSH_MEMORY_LIMIT=1G
DSH_RESTART_POLICY_CONDITION=any
DSH_RESTART_POLICY_DELAY=5s
DSH_RESTART_POLICY_MAX_ATTEMPTS=3

# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# Multi-instance / Dokploy: use a distinct NAME per app when needed (dsh_data_01, …).
# Recipes (TYPE / OPTS / PATH / EXTERNAL):
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/dsh
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/dsh
#   External:              EXTERNAL=true   (pre-create: docker volume create dsh_data)
#   # DSH_DATA_VOLUME_TYPE=none
#   # DSH_DATA_VOLUME_OPTS=bind
#   # DSH_DATA_VOLUME_PATH=/appdata/dsh
DSH_DATA_VOLUME_NAME=dsh_data
DSH_DATA_VOLUME_EXTERNAL=false
DSH_DATA_VOLUME_DRIVER=local
DSH_DATA_VOLUME_TYPE=
DSH_DATA_VOLUME_OPTS=
DSH_DATA_VOLUME_PATH=
DSH_DATA_VOLUME_DIR=/home/node

DSH_HOMEPAGE_GROUP=AI
DSH_HOMEPAGE_NAME=DeepSeek Harness
DSH_HOMEPAGE_ICON=deepseek.png
DSH_HOMEPAGE_DESCRIPTION=DeepSeek Harness Web UI
DSH_HOMEPAGE_URL=
DSH_HOMEPAGE_SITEMONITOR=http://dsh:3080
