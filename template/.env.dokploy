http_proxy=${{project.http_proxy}}
https_proxy=${{project.https_proxy}}
no_proxy=${{project.no_proxy}}
TZ=America/Montreal

DEFAULT_NETWORK=${{project.DEFAULT_NETWORK}}

## Dokploy projects environment variables
APP=tpl
APPDATA_DIR=${{project.APPDATA_DIR}}/${APP}
CONFIG_DIR=${{project.CONFIG_DIR}}/${APP}

## TPL
TPL_DOMAIN=tpl.example.com
TPL_ACCESS_KEY=tpl
TPL_SECRET_KEY=tpl1234
TPL_S3_DOMAIN=tpl.example.com
TPL_DATA_DIR=${APPDATA_DIR}/data

## Homepage
TPL_HOMEPAGE_GROUP=Templates
TPL_HOMEPAGE_NAME=TPL
TPL_HOMEPAGE_ICON=tpl.png
TPL_HOMEPAGE_HREF=http://${TPL_DOMAIN}

