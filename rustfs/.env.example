# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://docs.rustfs.com/en/installation/container/docker
# S3 API stays Host-only (SigV4). Console is hardcoded at /rustfs/console (not /console).
# RUSTFS_BASE_PATH=/ is unused.

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

RUSTFS_IMAGE=docker.io/rustfs/rustfs:latest
RUSTFS_RESTART=unless-stopped
RUSTFS_PRIVILEGED=false
RUSTFS_ENV_FILE=.env.example
RUSTFS_BASE_PATH=/

# One DNS name. S3 = Host-only. Console = PathPrefix /rustfs/console (do not stripPrefix).
RUSTFS_S3_DOMAIN=s3.example.com
RUSTFS_CONSOLE_DOMAIN=s3.example.com
RUSTFS_CONSOLE_PATH=/rustfs/console
RUSTFS_S3_URL=http://s3.example.com
RUSTFS_CONSOLE_URL=http://s3.example.com/rustfs/console

# Generated by make rustfs-setup if empty. Do not use rustfsadmin.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

RUSTFS_ADDRESS=:9000
RUSTFS_CONSOLE_ADDRESS=:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_OBS_LOGGER_LEVEL=error
RUSTFS_OBS_LOG_DIRECTORY=/var/log/rustfs/

RUSTFS_TRAEFIK_LABELS_SWARM_ENABLE=true
RUSTFS_TRAEFIK_LABELS_DOCKER_ENABLE=true
RUSTFS_ENTRYPOINTS=web
RUSTFS_MIDDLEWARES=
RUSTFS_TLS_ENABLED=false
RUSTFS_TLS_CERTRESOLVER=letsencrypt

RUSTFS_DEPLOY_MODE=replicated
RUSTFS_DEPLOY_REPLICAS=1
RUSTFS_PLACEMENT_CONSTRAINTS=node.platform.os==linux
RUSTFS_MEMORY_LIMIT=1G

# SNSD: one path (compose command /data). SNMD / extra NFS: gitignored override — see rustfs/README.md.
RUSTFS_DATA_DIR=
RUSTFS_DATA_VOLUME_NAME=rustfs-data
RUSTFS_DATA_VOLUME_EXTERNAL=false
RUSTFS_DATA_CONTAINER_PATH=/data

RUSTFS_LOGS_DIR=
RUSTFS_LOGS_VOLUME_NAME=rustfs-logs
RUSTFS_LOGS_VOLUME_EXTERNAL=false
RUSTFS_LOGS_CONTAINER_PATH=/var/log/rustfs

RUSTFS_HOMEPAGE_GROUP=Storage
RUSTFS_HOMEPAGE_NAME=RustFS
RUSTFS_HOMEPAGE_ICON=rustfs.png
RUSTFS_HOMEPAGE_DESCRIPTION=S3-compatible object storage
RUSTFS_HOMEPAGE_SITEMONITOR=http://rustfs:9001/rustfs/console/health
