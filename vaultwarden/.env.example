# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Docs: https://github.com/dani-garcia/vaultwarden/wiki
# Alternate base dir: include the path in DOMAIN (VAULTWARDEN_APP_URL). Do not stripPrefix.

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=false

VAULTWARDEN_IMAGE=docker.io/vaultwarden/server:latest
VAULTWARDEN_RESTART=unless-stopped
VAULTWARDEN_PRIVILEGED=false
VAULTWARDEN_ENV_FILE=.env.example

# Public URL (no trailing slash). Must include BASE_PATH when not serving at /.
# Example: https://example.com/vaultwarden
VAULTWARDEN_APP_URL=http://example.com/vaultwarden
VAULTWARDEN_DOMAIN=example.com
VAULTWARDEN_BASE_PATH=/vaultwarden

# Empty = SQLite at /data/db.sqlite3. Postgres example:
# VAULTWARDEN_DATABASE_URL=postgresql://vaultwarden:ChangeMe@postgres:5432/vaultwarden
VAULTWARDEN_DATABASE_URL=sqlite:///data/db.sqlite3
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=true
# Generated by make vaultwarden-setup (openssl rand -hex 32). Prefer argon2 PHC later.
VAULTWARDEN_ADMIN_TOKEN=
VAULTWARDEN_SHOW_PASSWORD_HINT=false
VAULTWARDEN_LOG_LEVEL=info
VAULTWARDEN_IP_HEADER=X-Forwarded-For

VAULTWARDEN_SMTP_HOST=
VAULTWARDEN_SMTP_FROM=
VAULTWARDEN_SMTP_PORT=587
VAULTWARDEN_SMTP_SECURITY=starttls
VAULTWARDEN_SMTP_USERNAME=
VAULTWARDEN_SMTP_PASSWORD=

VAULTWARDEN_TRAEFIK_LABELS_SWARM_ENABLE=true
VAULTWARDEN_TRAEFIK_LABELS_DOCKER_ENABLE=true
VAULTWARDEN_ENTRYPOINTS=web
VAULTWARDEN_MIDDLEWARES=
VAULTWARDEN_TLS_ENABLED=false
VAULTWARDEN_TLS_CERTRESOLVER=letsencrypt

VAULTWARDEN_DEPLOY_MODE=replicated
VAULTWARDEN_DEPLOY_REPLICAS=1
VAULTWARDEN_PLACEMENT_CONSTRAINTS=node.platform.os==linux
VAULTWARDEN_MEMORY_LIMIT=512M

VAULTWARDEN_DATA_DIR=
VAULTWARDEN_DATA_VOLUME_NAME=vaultwarden-data
VAULTWARDEN_DATA_VOLUME_EXTERNAL=false

VAULTWARDEN_HOMEPAGE_GROUP=Security
VAULTWARDEN_HOMEPAGE_NAME=Vaultwarden
VAULTWARDEN_HOMEPAGE_ICON=vaultwarden.png
VAULTWARDEN_HOMEPAGE_DESCRIPTION=Bitwarden-compatible password manager
VAULTWARDEN_HOMEPAGE_SITEMONITOR=http://vaultwarden:80/vaultwarden/alive
