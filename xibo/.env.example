# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Docs: https://github.com/xibosignage/xibo-docker
# Images: xibo-cms (HTTP 80), xibo-xmr (TCP 9505), quickchart. MySQL + memcached are external.

DEFAULT_NETWORK_NAME=xibo-network
DEFAULT_NETWORK_EXTERNAL=false

XIBO_IMAGE=ghcr.io/xibosignage/xibo-cms:release-4.5.1
XIBO_RESTART=unless-stopped
XIBO_PRIVILEGED=false
XIBO_ENV_FILE=.env.example

XIBO_XMR_IMAGE=ghcr.io/xibosignage/xibo-xmr:1.3
XIBO_XMR_RESTART=unless-stopped
XIBO_XMR_PRIVILEGED=false
XIBO_XMR_ENV_FILE=.env.example

XIBO_QUICKCHART_IMAGE=docker.io/ianw/quickchart:latest
XIBO_QUICKCHART_RESTART=unless-stopped
XIBO_QUICKCHART_PRIVILEGED=false
XIBO_QUICKCHART_ENV_FILE=.env.example

XIBO_DOMAIN=xibo.example.com
# Subpath supported via vendor CMS_ALIAS (default /xibo). Empty or / = Host-only.
XIBO_BASE_PATH=/xibo
XIBO_APP_URL=http://xibo.example.com/xibo
# Synced by xibo-setup from BASE_PATH (empty when Host-only).
XIBO_CMS_ALIAS=/xibo
XIBO_CMS_SERVER_NAME=xibo.example.com

# External MySQL (alphanumeric password only — Xibo docs). Same network as the stack.
XIBO_MYSQL_HOST=mysql
XIBO_MYSQL_PORT=3306
XIBO_MYSQL_DATABASE=cms
XIBO_MYSQL_USER=cms
XIBO_MYSQL_PASSWORD=

XIBO_XMR_HOST=xibo-xmr
# External memcached (or set XIBO_CMS_USE_MEMCACHED=false for file cache).
XIBO_CMS_USE_MEMCACHED=true
XIBO_MEMCACHED_HOST=memcached
XIBO_MEMCACHED_PORT=11211
XIBO_CMS_QUICK_CHART_URL=http://xibo-quickchart:3400

# Optional SMTP (placeholders — configure for mail features)
XIBO_CMS_SMTP_SERVER=
XIBO_CMS_SMTP_USERNAME=
XIBO_CMS_SMTP_PASSWORD=
XIBO_CMS_SMTP_USE_TLS=YES
XIBO_CMS_SMTP_USE_STARTTLS=YES
XIBO_CMS_SMTP_REWRITE_DOMAIN=
XIBO_CMS_SMTP_HOSTNAME=
XIBO_CMS_SMTP_FROM_LINE_OVERRIDE=YES
XIBO_CMS_PHP_POST_MAX_SIZE=4G
XIBO_CMS_PHP_UPLOAD_MAX_FILESIZE=4G

XIBO_TRAEFIK_LABELS_SWARM_ENABLE=true
XIBO_TRAEFIK_LABELS_DOCKER_ENABLE=true
XIBO_ENTRYPOINTS=web
XIBO_MIDDLEWARES=
XIBO_TLS_ENABLED=false
XIBO_TLS_CERTRESOLVER=letsencrypt

XIBO_DEPLOY_MODE=replicated
XIBO_DEPLOY_REPLICAS=1
XIBO_PLACEMENT_CONSTRAINTS=node.platform.os==linux
XIBO_MEMORY_LIMIT=1G

XIBO_XMR_DEPLOY_MODE=replicated
XIBO_XMR_DEPLOY_REPLICAS=1
XIBO_XMR_PLACEMENT_CONSTRAINTS=node.platform.os==linux
XIBO_XMR_MEMORY_LIMIT=1G

XIBO_QUICKCHART_DEPLOY_MODE=replicated
XIBO_QUICKCHART_DEPLOY_REPLICAS=1
XIBO_QUICKCHART_PLACEMENT_CONSTRAINTS=node.platform.os==linux
XIBO_QUICKCHART_MEMORY_LIMIT=1G

XIBO_CUSTOM_VOLUME_NAME=xibo-custom
XIBO_CUSTOM_VOLUME_EXTERNAL=false
XIBO_CUSTOM_DIR=xibo-custom
XIBO_BACKUP_VOLUME_NAME=xibo-backup
XIBO_BACKUP_VOLUME_EXTERNAL=false
XIBO_BACKUP_DIR=xibo-backup
XIBO_LIBRARY_VOLUME_NAME=xibo-library
XIBO_LIBRARY_VOLUME_EXTERNAL=false
XIBO_LIBRARY_DIR=xibo-library
XIBO_USERSCRIPT_VOLUME_NAME=xibo-userscripts
XIBO_USERSCRIPT_VOLUME_EXTERNAL=false
XIBO_USERSCRIPT_DIR=xibo-userscripts
XIBO_CA_CERTS_VOLUME_NAME=xibo-ca-certs
XIBO_CA_CERTS_VOLUME_EXTERNAL=false
XIBO_CA_CERTS_DIR=xibo-ca-certs

XIBO_HOMEPAGE_GROUP=Apps
XIBO_HOMEPAGE_NAME=Xibo
XIBO_HOMEPAGE_ICON=xibo.png
XIBO_HOMEPAGE_DESCRIPTION=Xibo CMS
XIBO_HOMEPAGE_SITEMONITOR=http://xibo:80
