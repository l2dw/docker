# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Docs: https://github.com/ellite/Wallos#installation
# Image bellamy/wallos (HTTP 80). SQLite + logos on volumes.

# Stack-local default. To join a shared overlay (Traefik), set NAME + EXTERNAL=true explicitly.
DEFAULT_NETWORK_NAME=wallos-network
DEFAULT_NETWORK_EXTERNAL=false

WALLOS_IMAGE=docker.io/bellamy/wallos:5.4.2
WALLOS_RESTART=unless-stopped
WALLOS_PRIVILEGED=false
WALLOS_ENV_FILE=.env.example

WALLOS_DOMAIN=wallos.example.com
# Subpath is unsupported — keep / (Host-only / dedicated subdomain).
WALLOS_BASE_PATH=/
WALLOS_APP_URL=http://wallos.example.com

WALLOS_TRAEFIK_LABELS_SWARM_ENABLE=true
WALLOS_TRAEFIK_LABELS_DOCKER_ENABLE=true
WALLOS_ENTRYPOINTS=web
WALLOS_MIDDLEWARES=
WALLOS_TLS_ENABLED=false
WALLOS_TLS_CERTRESOLVER=letsencrypt

WALLOS_DEPLOY_MODE=replicated
WALLOS_DEPLOY_REPLICAS=1
WALLOS_PLACEMENT_CONSTRAINTS=node.platform.os==linux
WALLOS_MEMORY_LIMIT=1G

WALLOS_DB_VOLUME_NAME=wallos-db
WALLOS_DB_VOLUME_EXTERNAL=false
WALLOS_LOGOS_VOLUME_NAME=wallos-logos
WALLOS_LOGOS_VOLUME_EXTERNAL=false
# Swarm: volume *names*, not host paths, unless you override with a bind.
WALLOS_DB_DIR=wallos-db
WALLOS_LOGOS_DIR=wallos-logos

WALLOS_HOMEPAGE_GROUP=Apps
WALLOS_HOMEPAGE_NAME=Wallos
WALLOS_HOMEPAGE_ICON=wallos.png
WALLOS_HOMEPAGE_DESCRIPTION=Wallos
WALLOS_HOMEPAGE_SITEMONITOR=http://wallos:80

# Optional OIDC (overrides Admin UI when set). See https://github.com/ellite/Wallos#oidc
WALLOS_OIDC_ENABLED=false
WALLOS_OIDC_PROVIDER_NAME=
WALLOS_OIDC_CLIENT_ID=
WALLOS_OIDC_CLIENT_SECRET=
WALLOS_OIDC_ISSUER=
WALLOS_OIDC_REDIRECT_URL=
WALLOS_OIDC_AUTO_CREATE_USER=false
WALLOS_OIDC_DISABLE_PASSWORD_LOGIN=false
WALLOS_SSRF_ALLOWLIST=
