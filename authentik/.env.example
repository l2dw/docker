# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://docs.goauthentik.io/install-config/install/docker-compose/
# External Postgres only (no DB / Redis in this stack). HTTP 9000 via Traefik; 9443 not published.
# Do not set TZ inside authentik containers (vendor: OAuth/SAML time skew).
# AUTHENTIK_WEB__PATH must have leading and trailing slashes when not `/`.

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:2025.10.4
AUTHENTIK_RESTART=unless-stopped
AUTHENTIK_PRIVILEGED=false
AUTHENTIK_SERVER_ENV_FILE=.env.example
AUTHENTIK_WORKER_ENV_FILE=.env.example
AUTHENTIK_WORKER_USER=root

AUTHENTIK_BASE_PATH=/authentik
AUTHENTIK_WEB__PATH=/authentik/
AUTHENTIK_WEB__BASE_URL=http://authentik.example.com
AUTHENTIK_DOMAIN=authentik.example.com

AUTHENTIK_SECRET_KEY=ChangeMe
AUTHENTIK_POSTGRESQL__HOST=dokploy-postgresql
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=ChangeMe

AUTHENTIK_MEDIA_DIR=
AUTHENTIK_TEMPLATES_DIR=
AUTHENTIK_CERTS_DIR=
AUTHENTIK_MEDIA_VOLUME_NAME=authentik_media
AUTHENTIK_MEDIA_VOLUME_EXTERNAL=false
AUTHENTIK_TEMPLATES_VOLUME_NAME=authentik_templates
AUTHENTIK_TEMPLATES_VOLUME_EXTERNAL=false
AUTHENTIK_CERTS_VOLUME_NAME=authentik_certs
AUTHENTIK_CERTS_VOLUME_EXTERNAL=false

AUTHENTIK_TRAEFIK_LABELS_SWARM_ENABLE=true
AUTHENTIK_TRAEFIK_LABELS_DOCKER_ENABLE=true
AUTHENTIK_ENTRYPOINTS=web
AUTHENTIK_MIDDLEWARES=
AUTHENTIK_TLS_ENABLED=false
AUTHENTIK_TLS_CERTRESOLVER=letsencrypt

AUTHENTIK_DEPLOY_MODE=replicated
AUTHENTIK_SERVER_REPLICAS=1
AUTHENTIK_WORKER_REPLICAS=1
AUTHENTIK_PLACEMENT_CONSTRAINTS=node.platform.os==linux
AUTHENTIK_SERVER_MEMORY_LIMIT=1G
AUTHENTIK_WORKER_MEMORY_LIMIT=1G

AUTHENTIK_HOMEPAGE_GROUP=Identity
AUTHENTIK_HOMEPAGE_NAME=Authentik
AUTHENTIK_HOMEPAGE_ICON=authentik.png
AUTHENTIK_HOMEPAGE_HREF=http://authentik.example.com/authentik
AUTHENTIK_HOMEPAGE_DESCRIPTION=Identity provider
AUTHENTIK_HOMEPAGE_SITEMONITOR=http://authentik-server:9000/authentik/-/health/live/
