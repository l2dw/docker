# SIEM — Elasticsearch + Kibana (8.19). Placeholders only.
# Transport SSL certs via cert-utils (run once). Set real passwords before production.
# Host: vm.max_map_count >= 262144

APP_NAME=siem
DEFAULT_NETWORK_NAME=siem-network
DEFAULT_NETWORK_EXTERNAL=false

TZ=America/Montreal
SIEM_ENV_FILE=.env.example
SIEM_INSTANCES_FILE=./instances.yml
SIEM_PLACEMENT_CONSTRAINTS=node.platform.os==linux

# Images (pinned)
SIEM_ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.14
SIEM_KB_IMAGE=docker.elastic.co/kibana/kibana:8.19.14

# Secrets (siem-setup generates empty ones)
SIEM_ELASTIC_PASSWORD=
SIEM_KB_ELASTICSEARCH_PASSWORD=
SIEM_KB_ENCRYPTED_SAVED_OBJECTS_ENCRYPTION_KEY=
SIEM_KB_REPORTING_ENCRYPTION_KEY=

# Elasticsearch
SIEM_ES_HOSTNAME=elasticsearch
SIEM_ES_NODE_NAME=elasticsearch
SIEM_ES_CLUSTER_NAME=es-docker-cluster
SIEM_ES_DISCOVERY_TYPE=single-node
SIEM_ES_BOOTSTRAP_MEMORY_LOCK=false
SIEM_ES_JAVA_OPTS=-Xms1024m -Xmx1024m
SIEM_ES_XPACK_SECURITY_ENABLED=true
SIEM_ES_XPACK_TRANSPORT_SSL_ENABLED=true
SIEM_ES_XPACK_TRANSPORT_SSL_VERIFICATION_MODE=certificate
SIEM_ES_TRANSPORT_SSL_CERTIFICATE=/usr/share/elasticsearch/config/certs/elasticsearch/elasticsearch.crt
SIEM_ES_TRANSPORT_SSL_KEY=/usr/share/elasticsearch/config/certs/elasticsearch/elasticsearch.key
SIEM_ES_TRANSPORT_SSL_CA=/usr/share/elasticsearch/config/certs/ca/ca.crt
SIEM_ES_RESTART=unless-stopped
SIEM_ES_PRIVILEGED=false
SIEM_ES_HTTP_PORT=9200
SIEM_ES_HTTP_PUBLISHED_PORT=9200
SIEM_ES_HTTP_PORT_MODE=ingress
SIEM_ES_HTTP_PORT_PROTOCOL=tcp
SIEM_ES_DOMAIN=siem.example.com
SIEM_ES_BASE_PATH=/elasticsearch
SIEM_ES_ENTRYPOINTS=web
SIEM_ES_MIDDLEWARES=siem-es-strip
SIEM_ES_TLS_ENABLED=false
SIEM_ES_TLS_CERTRESOLVER=letsencrypt
SIEM_ES_TRAEFIK_LABELS_SWARM_ENABLE=true
SIEM_ES_TRAEFIK_LABELS_DOCKER_ENABLE=true
SIEM_ES_DATA_VOLUME_NAME=siem_es_data
SIEM_ES_DATA_VOLUME_EXTERNAL=false
SIEM_ES_DATA_VOLUME_DRIVER=local
SIEM_ES_DATA_VOLUME_TYPE=
SIEM_ES_DATA_VOLUME_OPTS=
SIEM_ES_DATA_VOLUME_PATH=
SIEM_ES_DATA_VOLUME_DIR=/usr/share/elasticsearch/data
SIEM_ES_CERTS_VOLUME_DIR=/usr/share/elasticsearch/config/certs
SIEM_ES_DEPLOY_MODE=replicated
SIEM_ES_DEPLOY_REPLICAS=1
SIEM_ES_MEMORY_LIMIT=2G
SIEM_ES_RESTART_POLICY_CONDITION=any
SIEM_ES_RESTART_POLICY_DELAY=5s
SIEM_ES_RESTART_POLICY_MAX_ATTEMPTS=3
SIEM_ES_MEMLOCK_SOFT=-1
SIEM_ES_MEMLOCK_HARD=-1
SIEM_ES_NOFILE_SOFT=65536
SIEM_ES_NOFILE_HARD=65536
SIEM_ES_HOMEPAGE_GROUP=SIEM
SIEM_ES_HOMEPAGE_NAME=Elasticsearch
SIEM_ES_HOMEPAGE_ICON=elasticsearch.png
SIEM_ES_HOMEPAGE_DESCRIPTION=SIEM Elasticsearch
SIEM_ES_HOMEPAGE_URL=
SIEM_ES_HOMEPAGE_SITEMONITOR=http://elasticsearch:9200

# Certs volume + one-shot generator
SIEM_CERTS_VOLUME_NAME=siem_certs
SIEM_CERTS_VOLUME_EXTERNAL=false
SIEM_CERTS_VOLUME_DRIVER=local
SIEM_CERTS_VOLUME_TYPE=
SIEM_CERTS_VOLUME_OPTS=
SIEM_CERTS_VOLUME_PATH=
SIEM_CERTS_VOLUME_DIR=/certs
SIEM_CERT_UTILS_DEPLOY_MODE=replicated
SIEM_CERT_UTILS_DEPLOY_REPLICAS=1
SIEM_CERT_UTILS_RESTART_POLICY_CONDITION=none
SIEM_CERT_UTILS_HOMEPAGE_NAME=SIEM certs
SIEM_CERT_UTILS_HOMEPAGE_DESCRIPTION=One-shot cert generation

# Kibana
SIEM_KB_HOSTNAME=kibana
SIEM_KB_SERVER_NAME=kibana
SIEM_KB_SERVER_HOST=0.0.0.0
SIEM_KB_HTTP_PORT=5601
SIEM_KB_HTTP_PUBLISHED_PORT=5601
SIEM_KB_HTTP_PORT_MODE=ingress
SIEM_KB_HTTP_PORT_PROTOCOL=tcp
SIEM_KB_PUBLIC_BASE_URL=
SIEM_KB_BASE_PATH=/kibana
SIEM_KB_REWRITE_BASE_PATH=true
SIEM_KB_ELASTICSEARCH_HOSTS=http://elasticsearch:9200
SIEM_KB_ELASTICSEARCH_USERNAME=kibana_system
SIEM_KB_XPACK_SECURITY_ENABLED=true
SIEM_KB_RESTART=unless-stopped
SIEM_KB_PRIVILEGED=false
SIEM_KB_DOMAIN=siem.example.com
SIEM_KB_ENTRYPOINTS=web
SIEM_KB_MIDDLEWARES=
SIEM_KB_TLS_ENABLED=false
SIEM_KB_TLS_CERTRESOLVER=letsencrypt
SIEM_KB_TRAEFIK_LABELS_SWARM_ENABLE=true
SIEM_KB_TRAEFIK_LABELS_DOCKER_ENABLE=true
SIEM_KB_DATA_VOLUME_NAME=siem_kb_data
SIEM_KB_DATA_VOLUME_EXTERNAL=false
SIEM_KB_DATA_VOLUME_DRIVER=local
SIEM_KB_DATA_VOLUME_TYPE=
SIEM_KB_DATA_VOLUME_OPTS=
SIEM_KB_DATA_VOLUME_PATH=
SIEM_KB_DATA_VOLUME_DIR=/usr/share/kibana/data
SIEM_KB_CERTS_VOLUME_DIR=/usr/share/kibana/config/certs
SIEM_KB_DEPLOY_MODE=replicated
SIEM_KB_DEPLOY_REPLICAS=1
SIEM_KB_MEMORY_LIMIT=1G
SIEM_KB_RESTART_POLICY_CONDITION=any
SIEM_KB_RESTART_POLICY_DELAY=5s
SIEM_KB_RESTART_POLICY_MAX_ATTEMPTS=3
SIEM_KB_HOMEPAGE_GROUP=SIEM
SIEM_KB_HOMEPAGE_NAME=Kibana
SIEM_KB_HOMEPAGE_ICON=kibana.png
SIEM_KB_HOMEPAGE_DESCRIPTION=SIEM Kibana
SIEM_KB_HOMEPAGE_URL=
SIEM_KB_HOMEPAGE_SITEMONITOR=http://kibana:5601
