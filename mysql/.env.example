# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Official image: https://hub.docker.com/_/mysql
# Not an HTTP app — no Traefik. MYSQL_BASE_PATH=/ is unused.
# Overlay: mysql-server:3306. Optional host publish: 23306→3306.

DEFAULT_NETWORK_NAME=mysql-network
DEFAULT_NETWORK_EXTERNAL=false

MYSQL_IMAGE=docker.io/library/mysql:8.0
MYSQL_RESTART=unless-stopped
MYSQL_PRIVILEGED=false
MYSQL_ENV_FILE=.env.example
MYSQL_BASE_PATH=/
MYSQL_TRAEFIK_LABELS_SWARM_ENABLE=false
MYSQL_TRAEFIK_LABELS_DOCKER_ENABLE=false

# Generated by `make mysql-setup` if empty. Placeholders only — never commit real secrets.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=mysql
MYSQL_USER=mysql
MYSQL_PASSWORD=

MYSQL_DATA_VOLUME_NAME=mysql-data
MYSQL_DATA_VOLUME_EXTERNAL=false
MYSQL_DATA_VOLUME_DRIVER=local
MYSQL_DATA_VOLUME_DRIVER_TYPE=
MYSQL_DATA_VOLUME_DRIVER_O=
MYSQL_DATA_VOLUME_DRIVER_DEVICE=
MYSQL_DATA_HOST_PATH=mysql-data
MYSQL_DATA_CONTAINER_PATH=/var/lib/mysql

# Overlay DNS alias for other stacks (Compose service name `server` still works).
MYSQL_NETWORK_ALIAS=mysql-server

# Long-syntax publish: host:container. MYSQL_PORT is the container listen port (3306).
# Swarm mode is ingress|host. Protocol is tcp (hardcoded in compose). Overlay still uses :3306.
MYSQL_PUBLISHED_PORT=23306
MYSQL_PORT=3306
MYSQL_PORT_MODE=ingress

MYSQL_HEALTHCHECK_INTERVAL=10s
MYSQL_HEALTHCHECK_TIMEOUT=5s
MYSQL_HEALTHCHECK_RETRIES=5
MYSQL_HEALTHCHECK_START_PERIOD=30s

MYSQL_DEPLOY_MODE=replicated
MYSQL_DEPLOY_REPLICAS=1
MYSQL_PLACEMENT_CONSTRAINTS=node.platform.os==linux
MYSQL_MEMORY_LIMIT=512M
