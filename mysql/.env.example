# MySQL — placeholders only. Production: MYSQL_ENV_FILE=.env
# Official image: https://hub.docker.com/_/mysql
# TCP only — no Traefik. MYSQL_BASE_PATH=/ unused.

APP_NAME=mysql
DEFAULT_NETWORK_NAME=mysql-network
DEFAULT_NETWORK_EXTERNAL=false
# Join Dokploy overlay: DEFAULT_NETWORK_NAME=dokploy-network (setup sets EXTERNAL=true).

MYSQL_IMAGE=docker.io/library/mysql:8.0
MYSQL_RESTART=unless-stopped
MYSQL_PRIVILEGED=false
MYSQL_ENV_FILE=.env.example
MYSQL_BASE_PATH=/
MYSQL_TRAEFIK_LABELS_SWARM_ENABLE=false
MYSQL_TRAEFIK_LABELS_DOCKER_ENABLE=false

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=mysql
MYSQL_USER=mysql
MYSQL_PASSWORD=

MYSQL_DATA_VOLUME_NAME=mysql_data
MYSQL_DATA_VOLUME_EXTERNAL=false
MYSQL_DATA_VOLUME_DRIVER=local
MYSQL_DATA_VOLUME_TYPE=
MYSQL_DATA_VOLUME_OPTS=
MYSQL_DATA_VOLUME_PATH=
MYSQL_DATA_VOLUME_DIR=/var/lib/mysql

MYSQL_PUBLISHED_PORT=23306
MYSQL_PORT=3306
MYSQL_PORT_PROTOCOL=tcp
MYSQL_PORT_MODE=ingress

MYSQL_HEALTHCHECK_INTERVAL=10s
MYSQL_HEALTHCHECK_TIMEOUT=5s
MYSQL_HEALTHCHECK_RETRIES=5
MYSQL_HEALTHCHECK_START_PERIOD=30s

MYSQL_DEPLOY_MODE=replicated
MYSQL_DEPLOY_REPLICAS=1
MYSQL_PLACEMENT_CONSTRAINTS=node.platform.os==linux
MYSQL_RESTART_POLICY_CONDITION=any
MYSQL_RESTART_POLICY_DELAY=5s
MYSQL_RESTART_POLICY_MAX_ATTEMPTS=3
MYSQL_MEMORY_LIMIT=512M

MYSQL_HOMEPAGE_GROUP=Database
MYSQL_HOMEPAGE_NAME=MySQL
MYSQL_HOMEPAGE_ICON=mysql.png
MYSQL_HOMEPAGE_DESCRIPTION=MySQL server
MYSQL_HOMEPAGE_URL=
MYSQL_HOMEPAGE_SITEMONITOR=
