http_proxy=${{project.http_proxy}}
https_proxy=${{project.https_proxy}}
no_proxy=${{project.no_proxy}}
TZ=America/Montreal

DEFAULT_NETWORK=${{project.DEFAULT_NETWORK}}

## Dokploy projects environment variables
APPDATA_DIR=${{project.APPDATA_DIR}}/adguard/data
CONFIG_DIR=${{project.CONFIG_DIR}}/adguard

## AdGuard
ADGUARD_DOMAIN=adguard.example.com
ADGUARD_CERTIFICATE_RESOLVER=default
ADGUARD_CONFIG_DIR=${{project.CONFIG_DIR}}/adguard/config
ADGUARD_WORK_DIR=${{project.APPDATA_DIR}}/adguard/work

## Homepage
ADGUARD_HOMEPAGE_GROUP=Dashboard
ADGUARD_HOMEPAGE_NAME=AdGuard
ADGUARD_HOMEPAGE_ICON=adguard.png
ADGUARD_HOMEPAGE_HREF=http://adguard.example.com/

