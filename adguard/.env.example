# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.

## ADGUARD
ADGUARD_PORT_TCP=53
ADGUARD_PORT_UDP=53
ADGUARD_PORT_NODEJS=34070
ADGUARD_IMAGE=
ADGUARD_PULL_POLICY=
ADGUARD_RESTART=
ADGUARD_PRIVILEGED=
ADGUARD_DOMAIN=adguard.example.com
ADGUARD_BASE_PATH=/
ADGUARD_MOUNT_CONF=
ADGUARD_MOUNT_WORK=
ADGUARD_DEPLOY_REPLICAS=1
ADGUARD_DEPLOY_CONSTRAINTS=node.role==manager
ADGUARD_TRAEFIK_LABELS_SWARM_ENABLE=true
ADGUARD_TRAEFIK_LABELS_DOCKER_ENABLE=false
ADGUARD_TRAEFIK_ENTRYPOINTS=web
ADGUARD_TRAEFIK_MIDDLEWARES=
ADGUARD_TRAEFIK_TLS_ENABLED=false
ADGUARD_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
ADGUARD_HOMEPAGE_GROUP=
ADGUARD_HOMEPAGE_NAME=Adguard
ADGUARD_HOMEPAGE_ICON=adguard.png
ADGUARD_HOMEPAGE_HREF=http://adguard.example.com
ADGUARD_HOMEPAGE_SITEMONITOR=http://adguard.example.com
ADGUARD_HOMEPAGE_PING=http://adguard.example.com
