# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Docs: https://github.com/AdguardTeam/AdGuardHome/wiki/Docker

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=false

ADGUARD_IMAGE=docker.io/adguard/adguardhome:latest
ADGUARD_RESTART=unless-stopped
ADGUARD_PRIVILEGED=false
ADGUARD_ENV_FILE=.env.example

# Dedicated subdomain (subpath deploy is NOT supported — Host-only Traefik rule).
ADGUARD_DOMAIN=adguard.example.com
ADGUARD_BASE_PATH=/
ADGUARD_APP_URL=http://adguard.example.com

ADGUARD_TRAEFIK_LABELS_SWARM_ENABLE=true
ADGUARD_TRAEFIK_LABELS_DOCKER_ENABLE=true
ADGUARD_ENTRYPOINTS=web
ADGUARD_MIDDLEWARES=
ADGUARD_TLS_ENABLED=false
ADGUARD_TLS_CERTRESOLVER=letsencrypt

ADGUARD_DEPLOY_MODE=replicated
ADGUARD_DEPLOY_REPLICAS=1
ADGUARD_PLACEMENT_CONSTRAINTS=node.role==manager
ADGUARD_MEMORY_LIMIT=512M

# DNS + first-run wizard (host mode — pin on a manager node).
ADGUARD_PORT_DNS_TCP=53
ADGUARD_PORT_DNS_UDP=53
ADGUARD_PORT_DNS_MODE=host
ADGUARD_PORT_SETUP=3053
ADGUARD_PORT_SETUP_MODE=host

ADGUARD_CONF_DIR=
ADGUARD_CONF_VOLUME_NAME=adguard-conf
ADGUARD_CONF_VOLUME_EXTERNAL=false
ADGUARD_WORK_DIR=
ADGUARD_WORK_VOLUME_NAME=adguard-work
ADGUARD_WORK_VOLUME_EXTERNAL=false

ADGUARD_HOMEPAGE_GROUP=Infra
ADGUARD_HOMEPAGE_NAME=AdGuard Home
ADGUARD_HOMEPAGE_ICON=adguard.png
ADGUARD_HOMEPAGE_DESCRIPTION=Network-wide ad blocking DNS
ADGUARD_HOMEPAGE_SITEMONITOR=http://adguard:80
