# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

## ADGUARD
ADGUARD_IMAGE=
ADGUARD_PULL_POLICY=
ADGUARD_RESTART=
ADGUARD_PRIVILEGED=
ADGUARD_DOMAIN=example.com
ADGUARD_BASE_PATH=/
ADGUARD_MOUNT_CONF=${APPDATA_DIR}/adguard/conf
ADGUARD_MOUNT_WORK=${APPDATA_DIR}/adguard/work
ADGUARD_TRAEFIK_ENTRYPOINTS=web
ADGUARD_TRAEFIK_MIDDLEWARES=
ADGUARD_TRAEFIK_TLS_ENABLED=false
ADGUARD_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
ADGUARD_HOMEPAGE_GROUP=
ADGUARD_HOMEPAGE_NAME=Adguard
ADGUARD_HOMEPAGE_ICON=adguard.png
ADGUARD_HOMEPAGE_HREF=http://example.com
ADGUARD_HOMEPAGE_SITEMONITOR=
ADGUARD_HOMEPAGE_PING=
