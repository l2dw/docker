# AdGuard Home — placeholders only. Production: ADGUARD_ENV_FILE=.env
# Docs: https://github.com/AdguardTeam/AdGuardHome/wiki/Docker
# Subpath not supported — Host-only Traefik (ADGUARD_BASE_PATH=/).

APP_NAME=adguard
DEFAULT_NETWORK_NAME=adguard-network
DEFAULT_NETWORK_EXTERNAL=false
# Join Dokploy overlay: DEFAULT_NETWORK_NAME=dokploy-network (setup sets EXTERNAL=true).

ADGUARD_IMAGE=docker.io/adguard/adguardhome:v0.107.79
ADGUARD_RESTART=unless-stopped
ADGUARD_PRIVILEGED=false
ADGUARD_ENV_FILE=.env.example

ADGUARD_DOMAIN=adguard.example.com
ADGUARD_BASE_PATH=/
ADGUARD_APP_URL=http://adguard.example.com
ADGUARD_PORT=80

ADGUARD_TRAEFIK_LABELS_SWARM_ENABLE=true
ADGUARD_TRAEFIK_LABELS_DOCKER_ENABLE=true
ADGUARD_ENTRYPOINTS=web
ADGUARD_MIDDLEWARES=
ADGUARD_TLS_ENABLED=false
ADGUARD_TLS_CERTRESOLVER=letsencrypt

ADGUARD_DEPLOY_MODE=replicated
ADGUARD_DEPLOY_REPLICAS=1
# Host-mode DNS ports — pin on a manager (or a dedicated node).
ADGUARD_PLACEMENT_CONSTRAINTS=node.role==manager
ADGUARD_RESTART_POLICY_CONDITION=any
ADGUARD_RESTART_POLICY_DELAY=5s
ADGUARD_RESTART_POLICY_MAX_ATTEMPTS=3
ADGUARD_MEMORY_LIMIT=512M

# DNS + first-run wizard (host mode).
ADGUARD_PORT_DNS_TCP=53
ADGUARD_PORT_DNS_UDP=53
ADGUARD_PORT_DNS_MODE=host
ADGUARD_PORT_SETUP=3053
ADGUARD_PORT_SETUP_MODE=host

# Volume keys `conf` / `work`. Local named: leave TYPE/OPTS/PATH empty.
# Bind: TYPE=none OPTS=bind PATH=/appdata/adguard/conf (or work)
ADGUARD_CONF_VOLUME_NAME=adguard_conf
ADGUARD_CONF_VOLUME_EXTERNAL=false
ADGUARD_CONF_VOLUME_DRIVER=local
ADGUARD_CONF_VOLUME_TYPE=
ADGUARD_CONF_VOLUME_OPTS=
ADGUARD_CONF_VOLUME_PATH=
ADGUARD_CONF_VOLUME_DIR=/opt/adguardhome/conf
ADGUARD_WORK_VOLUME_NAME=adguard_work
ADGUARD_WORK_VOLUME_EXTERNAL=false
ADGUARD_WORK_VOLUME_DRIVER=local
ADGUARD_WORK_VOLUME_TYPE=
ADGUARD_WORK_VOLUME_OPTS=
ADGUARD_WORK_VOLUME_PATH=
ADGUARD_WORK_VOLUME_DIR=/opt/adguardhome/work

ADGUARD_HOMEPAGE_GROUP=Infra
ADGUARD_HOMEPAGE_NAME=AdGuard Home
ADGUARD_HOMEPAGE_ICON=adguard.png
ADGUARD_HOMEPAGE_DESCRIPTION=Network-wide ad blocking DNS
ADGUARD_HOMEPAGE_URL=
ADGUARD_HOMEPAGE_SITEMONITOR=http://adguard:80
