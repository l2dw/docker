# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
http_proxy=
https_proxy=
no_proxy=
USER_UID= # default: 1000, echo $(id -u) to get the current user's UID
USER_GID= # default: 1000, echo $(id -g) to get the current user's GID
USER_NAME= # default: jenkins, echo $(id -un) to get the current user's name
TZ=America/Montreal
DEFAULT_NETWORK=dokploy-network
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

## REGISTRY
REGISTRY_IMAGE=
REGISTRY_PULL_POLICY=
REGISTRY_RESTART=
REGISTRY_PRIVILEGED=
REGISTRY_DOMAIN=registry.example.com
REGISTRY_BASE_PATH=/

REGISTRY_STORAGE_DELETE_ENABLED=true
REGISTRY_HEALTH_STORAGEDRIVER_ENABLED=true
REGISTRY_HTTP_SECRET=
REGISTRY_AUTH=htpasswd
REGISTRY_AUTH_HTPASSWD_REALM=Registry Realm
REGISTRY_AUTH_HTPASSWD_PATH=/auth/registry.password

REGISTRY_DATA=${APPDATA_DIR}/registry/data
REGISTRY_PASSWORD_FILE=
REGISTRY_MOUNT_LOGS=${APPDATA_DIR}/registry/logs
REGISTRY_TRAEFIK_ENTRYPOINTS=web
REGISTRY_TRAEFIK_MIDDLEWARES=
REGISTRY_TRAEFIK_TLS_ENABLED=false
REGISTRY_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
REGISTRY_HOMEPAGE_GROUP=
REGISTRY_HOMEPAGE_NAME=Registry
REGISTRY_HOMEPAGE_ICON=registry.png
REGISTRY_HOMEPAGE_HREF=http://registry.example.com
REGISTRY_HOMEPAGE_SITEMONITOR=
REGISTRY_HOMEPAGE_PING=
