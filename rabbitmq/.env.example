# RabbitMQ — placeholders only. Production: RABBITMQ_ENV_FILE=.env
APP_NAME=rabbitmq
RABBITMQ_ALIAS=rabbitmq
DEFAULT_NETWORK_NAME=rabbitmq-network
DEFAULT_NETWORK_EXTERNAL=false

RABBITMQ_IMAGE=docker.io/library/rabbitmq:4-management-alpine
RABBITMQ_HOSTNAME=rabbitmq
RABBITMQ_RESTART=unless-stopped
RABBITMQ_PRIVILEGED=false
RABBITMQ_ENV_FILE=.env.example

# Management UI (Traefik HTTP). Subpath unsupported — keep BASE_PATH=/
RABBITMQ_DOMAIN=rabbitmq.example.com
RABBITMQ_BASE_PATH=/
RABBITMQ_APP_URL=http://rabbitmq.example.com/
RABBITMQ_ENTRYPOINTS=web
RABBITMQ_MIDDLEWARES=
RABBITMQ_TLS_ENABLED=false
RABBITMQ_TLS_CERTRESOLVER=letsencrypt
RABBITMQ_TRAEFIK_LABELS_SWARM_ENABLE=true
RABBITMQ_TRAEFIK_LABELS_DOCKER_ENABLE=true
RABBITMQ_PORT=15672

# AMQP (published TCP)
RABBITMQ_AMQP_PORT=5672
RABBITMQ_AMQP_PUBLISHED_PORT=5672
RABBITMQ_AMQP_PORT_MODE=ingress
RABBITMQ_AMQP_PORT_PROTOCOL=tcp

# Broker defaults (official image env)
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=ChangeMe
RABBITMQ_DEFAULT_VHOST=/

# Volume key `data` → /var/lib/rabbitmq
RABBITMQ_DATA_VOLUME_NAME=rabbitmq_data
RABBITMQ_DATA_VOLUME_EXTERNAL=false
RABBITMQ_DATA_VOLUME_DRIVER=local
RABBITMQ_DATA_VOLUME_TYPE=
RABBITMQ_DATA_VOLUME_OPTS=
RABBITMQ_DATA_VOLUME_PATH=
RABBITMQ_DATA_VOLUME_DIR=/var/lib/rabbitmq

RABBITMQ_DEPLOY_MODE=replicated
RABBITMQ_DEPLOY_REPLICAS=1
RABBITMQ_MEMORY_LIMIT=1G
RABBITMQ_PLACEMENT_CONSTRAINTS=node.platform.os==linux
RABBITMQ_RESTART_POLICY_CONDITION=any
RABBITMQ_RESTART_POLICY_DELAY=5s
RABBITMQ_RESTART_POLICY_MAX_ATTEMPTS=3

RABBITMQ_HOMEPAGE_GROUP=Infrastructure
RABBITMQ_HOMEPAGE_NAME=RabbitMQ
RABBITMQ_HOMEPAGE_ICON=rabbitmq.png
RABBITMQ_HOMEPAGE_DESCRIPTION=Message broker
RABBITMQ_HOMEPAGE_SITEMONITOR=http://rabbitmq:15672
