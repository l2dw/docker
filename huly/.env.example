# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# Placeholders only. Production: HULY_*_ENV_FILE=.env
# Upstream: https://github.com/hcengineering/huly-selfhost (v0.7.x)

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

TZ=America/Montreal
APP_NAME=huly
DEFAULT_NETWORK_NAME=huly-network
DEFAULT_NETWORK_EXTERNAL=false

HULY_RESTART=unless-stopped
HULY_PRIVILEGED=false
HULY_VERSION=v0.7.426
HULY_DESKTOP_CHANNEL=0.7.426

# Public URL (Host-only — subpath is not supported)
HULY_DOMAIN=huly.example.com
HULY_BASE_PATH=/
HULY_HTTP_SCHEME=https
HULY_WS_SCHEME=wss
HULY_PUBLIC_URL=https://huly.example.com
HULY_ENTRYPOINTS=web
HULY_MIDDLEWARES=
HULY_TLS_ENABLED=false
HULY_TLS_CERTRESOLVER=letsencrypt
HULY_TRAEFIK_LABELS_SWARM_ENABLE=true
HULY_TRAEFIK_LABELS_DOCKER_ENABLE=true

HULY_HOMEPAGE_GROUP=Productivity
HULY_HOMEPAGE_NAME=Huly
HULY_HOMEPAGE_ICON=si-linear
HULY_HOMEPAGE_DESCRIPTION=All-in-one project management
HULY_HOMEPAGE_URL=
HULY_HOMEPAGE_SITEMONITOR=http://front:8080

HULY_TITLE=Huly Self Host
HULY_DEFAULT_LANGUAGE=en
HULY_LAST_NAME_FIRST=true
HULY_MODEL_ENABLED=*
HULY_DISABLED_FEATURES=auto-translate,mailboxes
HULY_UPLOAD_URL=/files
# Set to /no-init-scripts to skip default workspace content
HULY_INIT_REPO_DIR=

# Shared secret (make huly-setup generates if ChangeMe)
HULY_SECRET=ChangeMe

# External CockroachDB / Postgres-compatible (required)
# Example: postgres://user:pass@postgresql:26257/huly
HULY_CR_DB_URL=postgres://huly:ChangeMe@postgresql:26257/huly

# External Kafka / Redpanda (host:port, no scheme)
HULY_QUEUE_CONFIG=kafka:9092

# External S3 / MinIO — STORAGE_CONFIG format: type|endpoint?accessKey=…&secretKey=…
# Endpoint host must resolve on the stack network (e.g. minio:9000, s3.example.com)
HULY_STORAGE_CONFIG=minio|minio:9000?accessKey=ChangeMe&secretKey=ChangeMe

# External Elasticsearch 7.x (ingest-attachment plugin required for fulltext)
HULY_ELASTIC_URL=http://elasticsearch:9200
HULY_FULLTEXT_DB_URL=http://elasticsearch:9200
HULY_ELASTIC_INDEX_NAME=huly_storage_index

# Application images (bump with HULY_VERSION)
HULY_FRONT_IMAGE=docker.io/hardcoreeng/front:v0.7.426
HULY_ACCOUNT_IMAGE=docker.io/hardcoreeng/account:v0.7.426
HULY_TRANSACTOR_IMAGE=docker.io/hardcoreeng/transactor:v0.7.426
HULY_COLLABORATOR_IMAGE=docker.io/hardcoreeng/collaborator:v0.7.426
HULY_WORKSPACE_IMAGE=docker.io/hardcoreeng/workspace:v0.7.426
HULY_FULLTEXT_IMAGE=docker.io/hardcoreeng/fulltext:v0.7.426
HULY_STATS_IMAGE=docker.io/hardcoreeng/stats:v0.7.426
HULY_REKONI_IMAGE=docker.io/hardcoreeng/rekoni-service:v0.7.426
HULY_KVS_IMAGE=docker.io/hardcoreeng/hulykvs:v0.7.426

HULY_FRONT_PORT=8080
HULY_ACCOUNT_PORT=3000
HULY_TRANSACTOR_PORT=3333
HULY_COLLABORATOR_PORT=3078
HULY_STATS_PORT=4900
HULY_REKONI_PORT=4004

# env_file per role (default .env.example; prod → .env)
HULY_FRONT_ENV_FILE=.env.example
HULY_ACCOUNT_ENV_FILE=.env.example
HULY_TRANSACTOR_ENV_FILE=.env.example
HULY_COLLABORATOR_ENV_FILE=.env.example
HULY_WORKSPACE_ENV_FILE=.env.example
HULY_FULLTEXT_ENV_FILE=.env.example
HULY_STATS_ENV_FILE=.env.example
HULY_REKONI_ENV_FILE=.env.example
HULY_KVS_ENV_FILE=.env.example

# Memory limits
HULY_FRONT_MEMORY_LIMIT=1G
HULY_ACCOUNT_MEMORY_LIMIT=1G
HULY_TRANSACTOR_MEMORY_LIMIT=1G
HULY_COLLABORATOR_MEMORY_LIMIT=1G
HULY_WORKSPACE_MEMORY_LIMIT=1G
HULY_FULLTEXT_MEMORY_LIMIT=1G
HULY_STATS_MEMORY_LIMIT=512M
HULY_REKONI_MEMORY_LIMIT=512M
HULY_KVS_MEMORY_LIMIT=512M

# Deploy (Swarm) — per role
# Placement examples: node.role==worker | node.hostname==db-1 | node.labels.name==huly-1
HULY_FRONT_DEPLOY_MODE=replicated
HULY_FRONT_DEPLOY_REPLICAS=1
HULY_FRONT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HULY_FRONT_RESTART_POLICY_CONDITION=any
HULY_FRONT_RESTART_POLICY_DELAY=5s
HULY_FRONT_RESTART_POLICY_MAX_ATTEMPTS=3

HULY_ACCOUNT_DEPLOY_MODE=replicated
HULY_ACCOUNT_DEPLOY_REPLICAS=1
HULY_ACCOUNT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HULY_ACCOUNT_RESTART_POLICY_CONDITION=any
HULY_ACCOUNT_RESTART_POLICY_DELAY=5s
HULY_ACCOUNT_RESTART_POLICY_MAX_ATTEMPTS=3

HULY_TRANSACTOR_DEPLOY_MODE=replicated
HULY_TRANSACTOR_DEPLOY_REPLICAS=1
HULY_TRANSACTOR_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HULY_TRANSACTOR_RESTART_POLICY_CONDITION=any
HULY_TRANSACTOR_RESTART_POLICY_DELAY=5s
HULY_TRANSACTOR_RESTART_POLICY_MAX_ATTEMPTS=3

HULY_COLLABORATOR_DEPLOY_MODE=replicated
HULY_COLLABORATOR_DEPLOY_REPLICAS=1
HULY_COLLABORATOR_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HULY_COLLABORATOR_RESTART_POLICY_CONDITION=any
HULY_COLLABORATOR_RESTART_POLICY_DELAY=5s
HULY_COLLABORATOR_RESTART_POLICY_MAX_ATTEMPTS=3

HULY_WORKSPACE_DEPLOY_MODE=replicated
HULY_WORKSPACE_DEPLOY_REPLICAS=1
HULY_WORKSPACE_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HULY_WORKSPACE_RESTART_POLICY_CONDITION=any
HULY_WORKSPACE_RESTART_POLICY_DELAY=5s
HULY_WORKSPACE_RESTART_POLICY_MAX_ATTEMPTS=3

HULY_FULLTEXT_DEPLOY_MODE=replicated
HULY_FULLTEXT_DEPLOY_REPLICAS=1
HULY_FULLTEXT_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HULY_FULLTEXT_RESTART_POLICY_CONDITION=any
HULY_FULLTEXT_RESTART_POLICY_DELAY=5s
HULY_FULLTEXT_RESTART_POLICY_MAX_ATTEMPTS=3

HULY_STATS_DEPLOY_MODE=replicated
HULY_STATS_DEPLOY_REPLICAS=1
HULY_STATS_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HULY_STATS_RESTART_POLICY_CONDITION=any
HULY_STATS_RESTART_POLICY_DELAY=5s
HULY_STATS_RESTART_POLICY_MAX_ATTEMPTS=3

HULY_REKONI_DEPLOY_MODE=replicated
HULY_REKONI_DEPLOY_REPLICAS=1
HULY_REKONI_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HULY_REKONI_RESTART_POLICY_CONDITION=any
HULY_REKONI_RESTART_POLICY_DELAY=5s
HULY_REKONI_RESTART_POLICY_MAX_ATTEMPTS=3

HULY_KVS_DEPLOY_MODE=replicated
HULY_KVS_DEPLOY_REPLICAS=1
HULY_KVS_PLACEMENT_CONSTRAINTS=node.platform.os==linux
HULY_KVS_RESTART_POLICY_CONDITION=any
HULY_KVS_RESTART_POLICY_DELAY=5s
HULY_KVS_RESTART_POLICY_MAX_ATTEMPTS=3
