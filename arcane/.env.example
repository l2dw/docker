# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Generate secrets: openssl rand -hex 32
# ENCRYPTION_KEY must be 32 bytes (raw, base64, or hex).

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=false

ARCANE_IMAGE=ghcr.io/getarcaneapp/manager:latest
ARCANE_RESTART=unless-stopped
ARCANE_PRIVILEGED=false
ARCANE_PUID=1000
ARCANE_PGID=1000
ARCANE_DOMAIN=arcane.example.com
ARCANE_BASE_PATH=/
ARCANE_APP_URL=http://arcane.example.com
ARCANE_TRAEFIK_LABELS_SWARM_ENABLE=true
ARCANE_TRAEFIK_LABELS_DOCKER_ENABLE=true
ARCANE_ENTRYPOINTS=web
ARCANE_MIDDLEWARES=
ARCANE_TLS_ENABLED=false
ARCANE_TLS_CERTRESOLVER=letsencrypt
ARCANE_ENCRYPTION_KEY=
ARCANE_JWT_SECRET=
ARCANE_DEPLOY_MODE=replicated
ARCANE_DEPLOY_REPLICAS=1
ARCANE_PLACEMENT_CONSTRAINTS=node.role==manager
ARCANE_MEMORY_LIMIT=512M
ARCANE_DATA_DIR=
ARCANE_DATA_VOLUME_NAME=arcane-data
ARCANE_DATA_VOLUME_EXTERNAL=false
ARCANE_BUILDS_DIR=
ARCANE_BUILDS_VOLUME_NAME=arcane-builds
ARCANE_BUILDS_VOLUME_EXTERNAL=false
ARCANE_BACKUPS_DIR=
ARCANE_BACKUPS_VOLUME_NAME=arcane-backups
ARCANE_BACKUPS_VOLUME_EXTERNAL=false
ARCANE_HOMEPAGE_GROUP=Infra
ARCANE_HOMEPAGE_NAME=Arcane
ARCANE_HOMEPAGE_ICON=arcane.png
ARCANE_HOMEPAGE_HREF=http://arcane.example.com
ARCANE_HOMEPAGE_DESCRIPTION=Modern Docker management UI
ARCANE_HOMEPAGE_SITEMONITOR=http://arcane:3552
