# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Docs: https://woodpecker-ci.org/docs/administration/installation/docker-compose
# Agent secret: openssl rand -hex 32

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=false

WOODPECKER_SERVER_IMAGE=docker.io/woodpeckerci/woodpecker-server:v3
WOODPECKER_AGENT_IMAGE=docker.io/woodpeckerci/woodpecker-agent:v3
WOODPECKER_RESTART=unless-stopped
WOODPECKER_PRIVILEGED=false
WOODPECKER_AGENT_PRIVILEGED=false

# Public URL (no trailing slash). Must include BASE_PATH when not serving at /.
# Example: https://example.com/woodpecker
WOODPECKER_HOST=http://example.com/woodpecker
WOODPECKER_DOMAIN=example.com
WOODPECKER_BASE_PATH=/woodpecker
WOODPECKER_OPEN=true
# Comma-separated forge usernames
WOODPECKER_ADMIN=
WOODPECKER_AGENT_SECRET=

# Compose env_file paths (relative to woodpecker/). environment: overrides the file.
WOODPECKER_SERVER_ENV_FILE=.env.example
WOODPECKER_AGENT_ENV_FILE=.env.example

WOODPECKER_SERVER_ADDR=:8000
WOODPECKER_GRPC_ADDR=:9000
WOODPECKER_AGENT_SERVER=woodpecker-server:9000
WOODPECKER_AGENT_GRPC_SECURE=false
WOODPECKER_AGENT_GRPC_VERIFY=true
WOODPECKER_AGENT_MAX_WORKFLOWS=1

# Forge — enable one: GitHub (default) or Gitea/Forgejo
WOODPECKER_GITHUB=true
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=
WOODPECKER_GITHUB_PUBLIC_ONLY=false
WOODPECKER_GITEA=false
WOODPECKER_GITEA_URL=
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=

WOODPECKER_TRAEFIK_LABELS_SWARM_ENABLE=true
WOODPECKER_TRAEFIK_LABELS_DOCKER_ENABLE=true
WOODPECKER_ENTRYPOINTS=web
WOODPECKER_MIDDLEWARES=
WOODPECKER_TLS_ENABLED=false
WOODPECKER_TLS_CERTRESOLVER=letsencrypt

WOODPECKER_SERVER_DEPLOY_MODE=replicated
WOODPECKER_SERVER_DEPLOY_REPLICAS=1
WOODPECKER_SERVER_PLACEMENT_CONSTRAINTS=node.platform.os==linux
WOODPECKER_SERVER_MEMORY_LIMIT=512M
WOODPECKER_AGENT_DEPLOY_MODE=replicated
WOODPECKER_AGENT_DEPLOY_REPLICAS=1
WOODPECKER_AGENT_PLACEMENT_CONSTRAINTS=node.role==manager
WOODPECKER_AGENT_MEMORY_LIMIT=512M

WOODPECKER_SERVER_DATA_DIR=
WOODPECKER_SERVER_DATA_VOLUME_NAME=woodpecker-server-data
WOODPECKER_SERVER_DATA_VOLUME_EXTERNAL=false
WOODPECKER_AGENT_CONFIG_DIR=
WOODPECKER_AGENT_CONFIG_VOLUME_NAME=woodpecker-agent-config
WOODPECKER_AGENT_CONFIG_VOLUME_EXTERNAL=false

WOODPECKER_HOMEPAGE_GROUP=CI
WOODPECKER_HOMEPAGE_NAME=Woodpecker
WOODPECKER_HOMEPAGE_ICON=woodpecker.png
WOODPECKER_HOMEPAGE_DESCRIPTION=Woodpecker CI
WOODPECKER_HOMEPAGE_SITEMONITOR=http://woodpecker-server:8000
