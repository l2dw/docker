# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Default: nginx:alpine serving a folder (bind or named volume). Git = clone on the host, then bind that path.
# npm: `npm run build` then bind the `dist/` directory (see README). SPA fallback is nginx/default.conf via Swarm configs.
# S3 is not a filesystem mount. To expose a bucket/prefix, switch IMAGE to nginx-s3-gateway (see README).

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

NGINX_IMAGE=docker.io/library/nginx:alpine
# S3 mode (MinIO / RustFS / AWS), not a local folder:
# NGINX_IMAGE=ghcr.io/nginxinc/nginx-s3-gateway/nginx-oss-s3-gateway:latest
NGINX_RESTART=unless-stopped
NGINX_PRIVILEGED=false
NGINX_ENV_FILE=.env.example

NGINX_BASE_PATH=/
NGINX_DOMAIN=nginx.example.com

# Absolute host path to bind (folder, git clone, or npm dist/). Omit to use the named volume.
# NGINX_HTML_DIR=/appdata/myapp/dist
NGINX_HTML_VOLUME_NAME=nginx_html
NGINX_HTML_VOLUME_EXTERNAL=false
# Swarm config object name (immutable). Bump after editing nginx/default.conf.
NGINX_DEFAULT_CONF_NAME=nginx_default_conf

NGINX_S3_BUCKET_NAME=
NGINX_S3_ACCESS_KEY_ID=
NGINX_S3_SECRET_KEY=ChangeMe
NGINX_S3_SERVER=
NGINX_S3_SERVER_PORT=443
NGINX_S3_SERVER_PROTO=https
NGINX_S3_REGION=us-east-1
NGINX_S3_STYLE=path
NGINX_AWS_SIGS_VERSION=4
NGINX_S3_ALLOW_DIRECTORY_LIST=false
NGINX_S3_PROVIDE_INDEX_PAGE=true
NGINX_S3_DNS_RESOLVERS=127.0.0.11

NGINX_TRAEFIK_LABELS_SWARM_ENABLE=true
NGINX_TRAEFIK_LABELS_DOCKER_ENABLE=true
NGINX_ENTRYPOINTS=web
NGINX_MIDDLEWARES=
NGINX_TLS_ENABLED=false
NGINX_TLS_CERTRESOLVER=letsencrypt

NGINX_DEPLOY_MODE=replicated
NGINX_DEPLOY_REPLICAS=1
NGINX_PLACEMENT_CONSTRAINTS=node.platform.os==linux
NGINX_MEMORY_LIMIT=128M

NGINX_HOMEPAGE_GROUP=Files
NGINX_HOMEPAGE_NAME=nginx
NGINX_HOMEPAGE_ICON=nginx.png
NGINX_HOMEPAGE_HREF=http://nginx.example.com/
NGINX_HOMEPAGE_DESCRIPTION=Static HTTP
NGINX_HOMEPAGE_SITEMONITOR=http://nginx:80
