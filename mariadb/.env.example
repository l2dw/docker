# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Official image: https://hub.docker.com/_/mariadb
# Not an HTTP app — no Traefik. MARIADB_BASE_PATH=/ is unused.
# Overlay: mariadb-server:3306. Optional host publish: 23306→3306.

DEFAULT_NETWORK_NAME=mariadb-network
DEFAULT_NETWORK_EXTERNAL=false

MARIADB_IMAGE=docker.io/library/mariadb:11
MARIADB_RESTART=unless-stopped
MARIADB_PRIVILEGED=false
MARIADB_ENV_FILE=.env.example
MARIADB_BASE_PATH=/
MARIADB_TRAEFIK_LABELS_SWARM_ENABLE=false
MARIADB_TRAEFIK_LABELS_DOCKER_ENABLE=false

# Generated by `make mariadb-setup` if empty. Placeholders only — never commit real secrets.
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=mariadb
MARIADB_USER=mariadb
MARIADB_PASSWORD=

MARIADB_DATA_VOLUME_NAME=mariadb-data
MARIADB_DATA_VOLUME_EXTERNAL=false
MARIADB_DATA_VOLUME_DRIVER=local
MARIADB_DATA_VOLUME_DRIVER_TYPE=
MARIADB_DATA_VOLUME_DRIVER_O=
MARIADB_DATA_VOLUME_DRIVER_DEVICE=
MARIADB_DATA_HOST_PATH=mariadb-data
MARIADB_DATA_CONTAINER_PATH=/var/lib/mysql

# Overlay DNS alias for other stacks (Compose service name `server` still works).
MARIADB_NETWORK_ALIAS=mariadb-server

# Long-syntax publish: host:container. MARIADB_PORT is the container listen port (3306).
# Swarm mode is ingress|host. Protocol is tcp (hardcoded in compose). Overlay still uses :3306.
MARIADB_PUBLISHED_PORT=23306
MARIADB_PORT=3306
MARIADB_PORT_MODE=ingress

MARIADB_HEALTHCHECK_INTERVAL=10s
MARIADB_HEALTHCHECK_TIMEOUT=5s
MARIADB_HEALTHCHECK_RETRIES=5
MARIADB_HEALTHCHECK_START_PERIOD=30s

MARIADB_DEPLOY_MODE=replicated
MARIADB_DEPLOY_REPLICAS=1
MARIADB_PLACEMENT_CONSTRAINTS=node.platform.os==linux
MARIADB_MEMORY_LIMIT=512M
