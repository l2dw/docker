# MariaDB — placeholders only. Production: MARIADB_ENV_FILE=.env
# Official image: https://hub.docker.com/_/mariadb
# TCP only — no Traefik. MARIADB_BASE_PATH=/ unused.

APP_NAME=mariadb
DEFAULT_NETWORK_NAME=mariadb-network
DEFAULT_NETWORK_EXTERNAL=false
# Join Dokploy overlay: DEFAULT_NETWORK_NAME=dokploy-network (setup sets EXTERNAL=true).

MARIADB_IMAGE=docker.io/library/mariadb:11
MARIADB_RESTART=unless-stopped
MARIADB_PRIVILEGED=false
MARIADB_ENV_FILE=.env.example
MARIADB_BASE_PATH=/
MARIADB_TRAEFIK_LABELS_SWARM_ENABLE=false
MARIADB_TRAEFIK_LABELS_DOCKER_ENABLE=false

MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=mariadb
MARIADB_USER=mariadb
MARIADB_PASSWORD=

MARIADB_DATA_VOLUME_NAME=mariadb_data
MARIADB_DATA_VOLUME_EXTERNAL=false
MARIADB_DATA_VOLUME_DRIVER=local
MARIADB_DATA_VOLUME_TYPE=
MARIADB_DATA_VOLUME_OPTS=
MARIADB_DATA_VOLUME_PATH=
MARIADB_DATA_VOLUME_DIR=/var/lib/mysql

MARIADB_PUBLISHED_PORT=23306
MARIADB_PORT=3306
MARIADB_PORT_PROTOCOL=tcp
MARIADB_PORT_MODE=ingress

MARIADB_HEALTHCHECK_INTERVAL=10s
MARIADB_HEALTHCHECK_TIMEOUT=5s
MARIADB_HEALTHCHECK_RETRIES=5
MARIADB_HEALTHCHECK_START_PERIOD=30s

MARIADB_DEPLOY_MODE=replicated
MARIADB_DEPLOY_REPLICAS=1
MARIADB_PLACEMENT_CONSTRAINTS=node.platform.os==linux
MARIADB_RESTART_POLICY_CONDITION=any
MARIADB_RESTART_POLICY_DELAY=5s
MARIADB_RESTART_POLICY_MAX_ATTEMPTS=3
MARIADB_MEMORY_LIMIT=512M

MARIADB_HOMEPAGE_GROUP=Database
MARIADB_HOMEPAGE_NAME=MariaDB
MARIADB_HOMEPAGE_ICON=mariadb.png
MARIADB_HOMEPAGE_DESCRIPTION=MariaDB server
MARIADB_HOMEPAGE_URL=
MARIADB_HOMEPAGE_SITEMONITOR=
