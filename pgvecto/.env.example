# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://hub.docker.com/r/tensorchord/pgvecto-rs (Postgres + vectors.so)
# Not an HTTP app — no Traefik. PGVECTO_BASE_PATH=/ is unused.
# TCP 5432 on the overlay only (not published on the host).

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

PGVECTO_IMAGE=docker.io/tensorchord/pgvecto-rs:pg14-v0.2.0
PGVECTO_RESTART=unless-stopped
PGVECTO_PRIVILEGED=false
PGVECTO_ENV_FILE=.env.example
PGVECTO_BASE_PATH=/
PGVECTO_TRAEFIK_LABELS_SWARM_ENABLE=false
PGVECTO_TRAEFIK_LABELS_DOCKER_ENABLE=false

# Generated by `make pgvecto-setup` if empty. Placeholders only — never commit real secrets.
PGVECTO_PASSWORD=
PGVECTO_USER=pgvecto
PGVECTO_DATABASE=pgvecto
PGVECTO_INITDB_ARGS=--data-checksums

PGVECTO_DATA_VOLUME_NAME=pgvecto-data
PGVECTO_DATA_VOLUME_EXTERNAL=false
# Swarm: volume *name*, not a host path. Named *_BIND so it is not confused with PGDATA.
PGVECTO_DATA_BIND=pgvecto-data

# Overlay DNS alias for other stacks (Compose service name `pgvecto` still works).
PGVECTO_NETWORK_ALIAS=dokploy-pgvecto

# postgres -c tunables (Immich / pgvecto-rs defaults)
PGVECTO_MAX_WAL_SIZE=2GB
PGVECTO_SHARED_BUFFERS=512MB

PGVECTO_DEPLOY_MODE=replicated
PGVECTO_DEPLOY_REPLICAS=1
PGVECTO_PLACEMENT_CONSTRAINTS=node.platform.os==linux
PGVECTO_MEMORY_LIMIT=1G
