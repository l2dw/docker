# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://docs.karakeep.app/installation/docker
# Formerly Hoarder. Subpath is unsupported — Host-only Traefik. KARAKEEP_BASE_PATH=/ is unused.

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=true

KARAKEEP_IMAGE=ghcr.io/karakeep-app/karakeep:release
KARAKEEP_CHROME_IMAGE=ghcr.io/karakeep-app/karakeep-chrome:release
KARAKEEP_RESTART=unless-stopped
KARAKEEP_PRIVILEGED=false
KARAKEEP_WEB_ENV_FILE=.env.example
KARAKEEP_CHROME_ENV_FILE=.env.example
KARAKEEP_BASE_PATH=/

# Public hostname (DNS → Traefik). Host-only — do not use PathPrefix/stripPrefix.
KARAKEEP_DOMAIN=karakeep.example.com
KARAKEEP_APP_URL=http://karakeep.example.com
KARAKEEP_NEXTAUTH_URL=http://karakeep.example.com

# Generated by make karakeep-setup if empty (openssl).
KARAKEEP_NEXTAUTH_SECRET=

KARAKEEP_BROWSER_WEB_URL=http://karakeep-chrome:9222
KARAKEEP_DISABLE_SIGNUPS=false
KARAKEEP_OPENAI_API_KEY=

KARAKEEP_TRAEFIK_LABELS_SWARM_ENABLE=true
KARAKEEP_TRAEFIK_LABELS_DOCKER_ENABLE=true
KARAKEEP_ENTRYPOINTS=web
KARAKEEP_MIDDLEWARES=
KARAKEEP_TLS_ENABLED=false
KARAKEEP_TLS_CERTRESOLVER=letsencrypt

KARAKEEP_DEPLOY_MODE=replicated
KARAKEEP_DEPLOY_REPLICAS=1
KARAKEEP_PLACEMENT_CONSTRAINTS=node.platform.os==linux
KARAKEEP_WEB_MEMORY_LIMIT=1G
KARAKEEP_CHROME_MEMORY_LIMIT=1G

KARAKEEP_DATA_DIR=
KARAKEEP_DATA_VOLUME_NAME=karakeep-data
KARAKEEP_DATA_VOLUME_EXTERNAL=false
KARAKEEP_DATA_CONTAINER_PATH=/data

KARAKEEP_HOMEPAGE_GROUP=Bookmarks
KARAKEEP_HOMEPAGE_NAME=Karakeep
KARAKEEP_HOMEPAGE_ICON=karakeep.png
KARAKEEP_HOMEPAGE_DESCRIPTION=Bookmark and note hoarder (formerly Hoarder)
KARAKEEP_HOMEPAGE_SITEMONITOR=http://karakeep-web:3000
