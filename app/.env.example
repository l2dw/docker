# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
http_proxy=
https_proxy=
no_proxy=

TZ=America/Montreal
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

# # Network: stack-local by default. Set NAME=dokploy-network + EXTERNAL=true to join the shared Dokploy overlay.
DEFAULT_NETWORK_NAME=app-network
DEFAULT_NETWORK_EXTERNAL=false

# # Image (generic wrapper — set to the app you are deploying)
APP_IMAGE=

# # Container listen port / host-published port (compose.yml only; docker-compose.yml ingress is via Traefik labels)
APP_PORT=3000
APP_PUBLISHED_PORT=30000
APP_PORT_MODE=ingress

# # Data volume — named Docker volume by default. Can be repointed to a bind mount or an NFS share
# # via driver_opts, without changing compose.yml/docker-compose.yml (see README § Volume NFS).
APP_DATA_VOLUME_NAME=app_data
APP_DATA_VOLUME_EXTERNAL=false
APP_DATA_VOLUME_DRIVER=local
# # Leave TYPE/O/DEVICE empty => normal local named volume (Docker manages the storage).
# # Set the three below to mount an NFS export directly as the named volume:
# APP_DATA_VOLUME_DRIVER_TYPE=nfs
# APP_DATA_VOLUME_DRIVER_O=addr=nfs-server.example.com,rw,nfsvers=4
# APP_DATA_VOLUME_DRIVER_DEVICE=:/exports/app-data
APP_DATA_VOLUME_DRIVER_TYPE=
APP_DATA_VOLUME_DRIVER_O=
APP_DATA_VOLUME_DRIVER_DEVICE=
APP_DATA_HOST_PATH=app_data
APP_DATA_CONTAINER_PATH=/data

# # Env file loaded by the service (path relative to app/). Prod should use .env (gitignored).
APP_ENV_FILE=.env.example

# # Memory
APP_MEMORY_LIMIT=1G

# # Deploy (Swarm)
APP_DEPLOY_MODE=replicated
APP_DEPLOY_REPLICAS=1
APP_PLACEMENT_CONSTRAINTS=node.platform.os==linux
APP_RESTART_POLICY_CONDITION=any
APP_RESTART_POLICY_DELAY=5s
APP_RESTART_POLICY_MAX_ATTEMPTS=3

# # Traefik (docker-compose.yml only)
APP_BASE_PATH=/
APP_DOMAIN=app.example.com
APP_TRAEFIK_ENTRYPOINTS=web
APP_TRAEFIK_MIDDLEWARES=
APP_TRAEFIK_TLS_ENABLED=false
APP_TRAEFIK_TLS_CERTRESOLVER=letsencrypt
APP_TRAEFIK_LABELS_SWARM_ENABLE=true
APP_TRAEFIK_LABELS_DOCKER_ENABLE=true

# # Homepage (docker-compose.yml only)
APP_HOMEPAGE_ENABLED=true
APP_HOMEPAGE_GROUP=APP
APP_HOMEPAGE_NAME=APP
APP_ICON=
APP_URL=http://app.example.com/
APP_DESCRIPTION=
APP_SITEMONITOR_URL=http://app.example.com/
APP_PING_URL=http://app.example.com
