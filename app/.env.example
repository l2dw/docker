# Copied into root `.env` (Make exports it) or set in Dokploy env UI.
# Keep stack keys in sync with root `.env.example` (DEFAULT_NETWORK_*, APP_*).
# Generic wrapper: set APP_IMAGE to the app you are deploying.
# - One assignment per line: KEY=value (comments use # at line start).

TZ=America/Montreal
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

# Network: stack-local by default. Set NAME=dokploy-network + EXTERNAL=true to join Dokploy/Traefik.
DEFAULT_NETWORK_NAME=app-network
DEFAULT_NETWORK_EXTERNAL=false

APP_IMAGE=docker.io/library/alpine:latest

# Overlay DNS aliases + Traefik router/service name (Compose service name is `app`)
APP_NAME=app
APP_ALIAS=app
APP_TRAEFIK_SERVICE=app

# Container listen / host publish (web.docker-compose.yml / tcp.docker-compose.yml)
APP_PORT=3000
APP_PUBLISHED_PORT=30000
APP_PORT_PROTOCOL=tcp
APP_PORT_MODE=ingress

APP_DATA_VOLUME_NAME=app_data
APP_DATA_VOLUME_EXTERNAL=false
APP_DATA_VOLUME_DRIVER=local
APP_DATA_VOLUME_DRIVER_TYPE=
APP_DATA_VOLUME_DRIVER_O=
APP_DATA_VOLUME_DRIVER_DEVICE=
APP_DATA_HOST_PATH=data
APP_DATA_CONTAINER_PATH=/data

APP_ENV_FILE=.env.example
APP_MEMORY_LIMIT=512M

APP_DEPLOY_MODE=replicated
APP_DEPLOY_REPLICAS=1
APP_PLACEMENT_CONSTRAINTS=node.platform.os==linux
APP_RESTART_POLICY_CONDITION=any
APP_RESTART_POLICY_DELAY=5s
APP_RESTART_POLICY_MAX_ATTEMPTS=3

# Which compose file to use (Dokploy path or Make APP_TRAEFIK_MODE):
#   http → web.docker-compose.yml
#   tcp  → tcp.docker-compose.yml
#   (unset/other → docker-compose.yml homepage-only)
APP_TRAEFIK_MODE=http
APP_TRAEFIK_LABELS_SWARM_ENABLE=true
APP_TRAEFIK_LABELS_DOCKER_ENABLE=true

# HTTP router (web.docker-compose.yml): Host(`$APP_DOMAIN`) && PathPrefix(`$APP_BASE_PATH`)
# Example → https://example.com/app
APP_DOMAIN=example.com
APP_BASE_PATH=/app
APP_TRAEFIK_ENTRYPOINTS=web
APP_TRAEFIK_MIDDLEWARES=
APP_TRAEFIK_TLS_ENABLED=false
APP_TRAEFIK_TLS_CERTRESOLVER=letsencrypt

# Homepage
APP_HOMEPAGE_ENABLED=true
APP_HOMEPAGE_GROUP=APP
APP_HOMEPAGE_NAME=APP
APP_HOMEPAGE_ICON=app.png
APP_HOMEPAGE_URL=
APP_HOMEPAGE_DESCRIPTION=
APP_HOMEPAGE_SITEMONITOR_URL=
APP_HOMEPAGE_PING=
