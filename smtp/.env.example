# Copied to `.env` and loaded by `make` via `-include` + export (see Makefile).
# - One assignment per line: KEY=value (no spaces around "=" required; comments use # at line start).
# - A lone `$` in a value is interpreted by GNU Make ($$ becomes $). Prefer plain values here, or $$VAR for compose-time vars.
http_proxy=
https_proxy=
no_proxy=
USER_UID= # default: 1000, echo $(id -u) to get the current user's UID
USER_GID= # default: 1000, echo $(id -g) to get the current user's GID
USER_NAME= # default: jenkins, echo $(id -un) to get the current user's name
TZ=America/Montreal
DEFAULT_NETWORK=dokploy-network
DOCKER_RUNTIME_SOCKET=/var/run/docker.sock

## SMTP
SMTP_IMAGE=namshi/smtp:latest
SMTP_PULL_POLICY=always
SMTP_RESTART=unless-stopped
SMTP_PRIVILEGED=false
SMTP_REPLICAS=1
SMTP_SWARM_MODE=replicated
SMTP_MEMORY_LIMIT=512M
SMTP_PLACEMENT_CONSTRAINTS=node.role==manager
SMTP_HOMEPAGE_GROUP=
SMTP_HOMEPAGE_NAME=smtp
SMTP_HOMEPAGE_ICON=smtp.png
SMTP_HOMEPAGE_PING=
#
SMTP_MAILNAME=smtp.example.com
SMTP_RELAY_NETWORKS=:192.168.31.0/16:10.16.0.0/8
# Smarthost (Workspace, custom): set HOST (+ PORT, USER, PASS, ALIASES)
SMTP_SMARTHOST_ADDRESS=
SMTP_SMARTHOST_PORT=587
SMTP_SMARTHOST_USER=
SMTP_SMARTHOST_PASSWORD=
SMTP_SMARTHOST_ALIASES=
# Test send (export for: make smtp-test-send / bin/send-test-email.sh)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_TO=
# SMTP_FROM=
# HOSTNAME=
# DOMAIN=
# SMTP_SUBJECT=smtp test
