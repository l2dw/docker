# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Docs: https://docs.immich.app/install/environment-variables
# Postgres and Redis are **external**. Immich v3 needs VectorChord on Postgres
# (not the separate pgvecto / pgvecto.rs stack). Create DB `immich` before first start.

DEFAULT_NETWORK_NAME=immich-network
DEFAULT_NETWORK_EXTERNAL=false

IMMICH_RESTART=unless-stopped
IMMICH_PRIVILEGED=false
IMMICH_SERVER_ENV_FILE=.env.example
IMMICH_ML_ENV_FILE=.env.example

# Subpath is NOT supported by Immich — dedicated subdomain only (Host-only Traefik).
IMMICH_BASE_PATH=/
IMMICH_DOMAIN=immich.example.com

IMMICH_SERVER_IMAGE=ghcr.io/immich-app/immich-server:v3.1.0
IMMICH_ML_IMAGE=ghcr.io/immich-app/immich-machine-learning:v3.1.0

# External Postgres (VectorChord-capable). Password must match the DB role.
IMMICH_DB_HOSTNAME=dokploy-postgresql
IMMICH_DB_PORT=5432
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD=

# External Redis (make redis-setup). Paste REDIS_PASSWORD here.
IMMICH_REDIS_HOSTNAME=dokploy-redis
IMMICH_REDIS_PORT=6379
IMMICH_REDIS_PASSWORD=ChangeMe
IMMICH_REDIS_DBINDEX=0

IMMICH_UPLOAD_VOLUME_NAME=immich-upload
IMMICH_UPLOAD_VOLUME_EXTERNAL=false
IMMICH_MODEL_CACHE_VOLUME_NAME=immich-model-cache
IMMICH_MODEL_CACHE_VOLUME_EXTERNAL=false
# Swarm: volume *names*, not host paths.
IMMICH_UPLOAD_BIND=immich-upload
IMMICH_MODEL_CACHE_BIND=immich-model-cache

IMMICH_TRAEFIK_LABELS_SWARM_ENABLE=true
IMMICH_TRAEFIK_LABELS_DOCKER_ENABLE=true
IMMICH_ENTRYPOINTS=web
IMMICH_MIDDLEWARES=
IMMICH_TLS_ENABLED=false
IMMICH_TLS_CERTRESOLVER=letsencrypt

IMMICH_SERVER_DEPLOY_MODE=replicated
IMMICH_SERVER_DEPLOY_REPLICAS=1
IMMICH_SERVER_PLACEMENT_CONSTRAINTS=node.platform.os==linux
IMMICH_SERVER_MEMORY_LIMIT=1G
IMMICH_ML_DEPLOY_MODE=replicated
IMMICH_ML_DEPLOY_REPLICAS=1
IMMICH_ML_PLACEMENT_CONSTRAINTS=node.platform.os==linux
IMMICH_ML_MEMORY_LIMIT=1G

IMMICH_HOMEPAGE_GROUP=Photos
IMMICH_HOMEPAGE_NAME=Immich
IMMICH_HOMEPAGE_ICON=immich.png
IMMICH_HOMEPAGE_HREF=http://immich.example.com
IMMICH_HOMEPAGE_DESCRIPTION=Immich photo/video library
IMMICH_HOMEPAGE_SITEMONITOR=http://immich-server:2283
