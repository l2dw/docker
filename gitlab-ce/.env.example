APP_NAME=gitlab-ce
DEFAULT_NETWORK_NAME=gitlab-ce-network
DEFAULT_NETWORK_EXTERNAL=false
TZ=America/Montreal

# Compose env_file (path relative to gitlab-ce/). environment: overrides the file. Production: GITLAB_ENV_FILE=.env
GITLAB_ENV_FILE=.env.example

GITLAB_IMAGE=docker.io/gitlab/gitlab-ce:19.6.0-ce.0
GITLAB_RESTART=unless-stopped
GITLAB_PRIVILEGED=false
# GitLab needs >= 4G RAM (Puma + Sidekiq + Gitaly); PostgreSQL/Redis are external so they are not counted here.
GITLAB_MEMORY_LIMIT=4G

# Public URL (scheme + host [+ path]) and Traefik host. Host-only (/) is the default; a subpath needs
# GITLAB_BASE_PATH=/gitlab AND GITLAB_EXTERNAL_URL=https://host/gitlab (omnibus relative_url).
GITLAB_DOMAIN=gitlab.example.com
GITLAB_EXTERNAL_URL=https://gitlab.example.com
GITLAB_BASE_PATH=/
# Protocol seen by GitLab behind the TLS-terminating proxy (https when Traefik/WAF terminates TLS)
GITLAB_FORWARDED_PROTO=https
# Initial root password (first start only). Empty = generated by `make gitlab-ce-setup`.
GITLAB_ROOT_PASSWORD=
GITLAB_PROMETHEUS_ENABLE=false

# External PostgreSQL (>= 16 recommended; extensions pg_trgm, btree_gist, plpgsql). See README for the SQL.
GITLAB_DB_HOST=
GITLAB_DB_PORT=5432
GITLAB_DB_NAME=gitlabhq_production
GITLAB_DB_USER=gitlab
GITLAB_DB_PASSWORD=
# External Redis (single instance; empty password = no AUTH)
GITLAB_REDIS_HOST=
GITLAB_REDIS_PORT=6379
GITLAB_REDIS_PASSWORD=

# HTTP container port (Traefik LB). HTTP is not published.
GITLAB_PORT=80
# Git over SSH (TCP, published). Host port 2222 keeps the host sshd on 22 free.
GITLAB_SSH_PORT=22
GITLAB_SSH_PUBLISHED_PORT=2222
GITLAB_SSH_PORT_MODE=ingress
GITLAB_SSH_PORT_PROTOCOL=tcp

GITLAB_TRAEFIK_LABELS_SWARM_ENABLE=true
GITLAB_TRAEFIK_LABELS_DOCKER_ENABLE=true
GITLAB_ENTRYPOINTS=web
GITLAB_MIDDLEWARES=
GITLAB_TLS_ENABLED=false
GITLAB_TLS_CERTRESOLVER=letsencrypt

GITLAB_DEPLOY_MODE=replicated
GITLAB_DEPLOY_REPLICAS=1
GITLAB_PLACEMENT_CONSTRAINTS=node.platform.os==linux
GITLAB_RESTART_POLICY_CONDITION=any
GITLAB_RESTART_POLICY_DELAY=5s
GITLAB_RESTART_POLICY_MAX_ATTEMPTS=3

# Volumes — NAME is a short Docker volume name (not a host path under Swarm).
# config (/etc/gitlab) holds gitlab-secrets.json: BACK IT UP, losing it makes the database unreadable.
# Recipes (TYPE / OPTS / PATH / EXTERNAL), repeated for CONFIG, LOGS and DATA:
#   Local named (default): EXTERNAL=false  TYPE=  OPTS=  PATH=
#   Bind:                  EXTERNAL=false  TYPE=none  OPTS=bind  PATH=/appdata/gitlab-ce/<config|logs|data>
#   NFS:                   EXTERNAL=false  TYPE=nfs   OPTS=addr=nfs-host,rw,nfsvers=4  PATH=:/exports/gitlab-ce/<config|logs|data>
#   External:              EXTERNAL=true   (pre-create: docker volume create gitlab_config)
#   # GITLAB_DATA_VOLUME_TYPE=none
#   # GITLAB_DATA_VOLUME_OPTS=bind
#   # GITLAB_DATA_VOLUME_PATH=/appdata/gitlab-ce/data
GITLAB_CONFIG_VOLUME_NAME=gitlab_config
GITLAB_CONFIG_VOLUME_EXTERNAL=false
GITLAB_CONFIG_VOLUME_DRIVER=local
GITLAB_CONFIG_VOLUME_TYPE=
GITLAB_CONFIG_VOLUME_OPTS=
GITLAB_CONFIG_VOLUME_PATH=
GITLAB_CONFIG_VOLUME_DIR=/etc/gitlab
GITLAB_LOGS_VOLUME_NAME=gitlab_logs
GITLAB_LOGS_VOLUME_EXTERNAL=false
GITLAB_LOGS_VOLUME_DRIVER=local
GITLAB_LOGS_VOLUME_TYPE=
GITLAB_LOGS_VOLUME_OPTS=
GITLAB_LOGS_VOLUME_PATH=
GITLAB_LOGS_VOLUME_DIR=/var/log/gitlab
GITLAB_DATA_VOLUME_NAME=gitlab_data
GITLAB_DATA_VOLUME_EXTERNAL=false
GITLAB_DATA_VOLUME_DRIVER=local
GITLAB_DATA_VOLUME_TYPE=
GITLAB_DATA_VOLUME_OPTS=
GITLAB_DATA_VOLUME_PATH=
GITLAB_DATA_VOLUME_DIR=/var/opt/gitlab

GITLAB_HOMEPAGE_GROUP=Development
GITLAB_HOMEPAGE_NAME=GitLab CE
GITLAB_HOMEPAGE_ICON=gitlab.png
GITLAB_HOMEPAGE_DESCRIPTION=Self-hosted Git, CI/CD and DevSecOps platform
GITLAB_HOMEPAGE_URL=
GITLAB_HOMEPAGE_SITEMONITOR=http://gitlab-ce:80/users/sign_in
