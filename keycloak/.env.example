# Keycloak — placeholders only. Production: KEYCLOAK_ENV_FILE=.env
# Docs: https://www.keycloak.org/server/containers
# Subpath via KC_HTTP_RELATIVE_PATH (KEYCLOAK_BASE_PATH).

APP_NAME=keycloak
DEFAULT_NETWORK_NAME=keycloak-network
DEFAULT_NETWORK_EXTERNAL=false
# Join Dokploy overlay: DEFAULT_NETWORK_NAME=dokploy-network (setup sets EXTERNAL=true).

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.3
KEYCLOAK_RESTART=unless-stopped
KEYCLOAK_PRIVILEGED=false
KEYCLOAK_ENV_FILE=.env.example

KEYCLOAK_DOMAIN=keycloak.example.com
KEYCLOAK_BASE_PATH=/auth
KEYCLOAK_APP_URL=http://keycloak.example.com/auth
KEYCLOAK_PORT=8080

KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_DB=postgres
KEYCLOAK_DB_URL=jdbc:postgresql://<DB_HOST>:5432/keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_HTTP_ENABLED=true
KEYCLOAK_PROXY_HEADERS=xforwarded
KEYCLOAK_HOSTNAME_STRICT=true
KEYCLOAK_CACHE=local
KEYCLOAK_HEALTH_ENABLED=true
KEYCLOAK_METRICS_ENABLED=false
KEYCLOAK_LOG_LEVEL=info
KEYCLOAK_LOG=file,console
KEYCLOAK_LOG_FILE=/opt/keycloak/logs/keycloak.log

KEYCLOAK_TRAEFIK_LABELS_SWARM_ENABLE=true
KEYCLOAK_TRAEFIK_LABELS_DOCKER_ENABLE=true
KEYCLOAK_ENTRYPOINTS=web
KEYCLOAK_MIDDLEWARES=
KEYCLOAK_TLS_ENABLED=false
KEYCLOAK_TLS_CERTRESOLVER=letsencrypt

KEYCLOAK_DEPLOY_MODE=replicated
KEYCLOAK_DEPLOY_REPLICAS=1
KEYCLOAK_PLACEMENT_CONSTRAINTS=node.platform.os==linux
KEYCLOAK_RESTART_POLICY_CONDITION=any
KEYCLOAK_RESTART_POLICY_DELAY=5s
KEYCLOAK_RESTART_POLICY_MAX_ATTEMPTS=3
KEYCLOAK_MEMORY_LIMIT=1G

KEYCLOAK_DATA_VOLUME_NAME=keycloak_data
KEYCLOAK_DATA_VOLUME_EXTERNAL=false
KEYCLOAK_DATA_VOLUME_DRIVER=local
KEYCLOAK_DATA_VOLUME_TYPE=
KEYCLOAK_DATA_VOLUME_OPTS=
KEYCLOAK_DATA_VOLUME_PATH=
KEYCLOAK_DATA_VOLUME_DIR=/opt/keycloak/data
KEYCLOAK_THEMES_VOLUME_NAME=keycloak_themes
KEYCLOAK_THEMES_VOLUME_EXTERNAL=false
KEYCLOAK_THEMES_VOLUME_DRIVER=local
KEYCLOAK_THEMES_VOLUME_TYPE=
KEYCLOAK_THEMES_VOLUME_OPTS=
KEYCLOAK_THEMES_VOLUME_PATH=
KEYCLOAK_THEMES_VOLUME_DIR=/opt/keycloak/themes
KEYCLOAK_PROVIDERS_VOLUME_NAME=keycloak_providers
KEYCLOAK_PROVIDERS_VOLUME_EXTERNAL=false
KEYCLOAK_PROVIDERS_VOLUME_DRIVER=local
KEYCLOAK_PROVIDERS_VOLUME_TYPE=
KEYCLOAK_PROVIDERS_VOLUME_OPTS=
KEYCLOAK_PROVIDERS_VOLUME_PATH=
KEYCLOAK_PROVIDERS_VOLUME_DIR=/opt/keycloak/providers
KEYCLOAK_CONF_VOLUME_NAME=keycloak_conf
KEYCLOAK_CONF_VOLUME_EXTERNAL=false
KEYCLOAK_CONF_VOLUME_DRIVER=local
KEYCLOAK_CONF_VOLUME_TYPE=
KEYCLOAK_CONF_VOLUME_OPTS=
KEYCLOAK_CONF_VOLUME_PATH=
KEYCLOAK_CONF_VOLUME_DIR=/opt/keycloak/conf
KEYCLOAK_LOGS_VOLUME_NAME=keycloak_logs
KEYCLOAK_LOGS_VOLUME_EXTERNAL=false
KEYCLOAK_LOGS_VOLUME_DRIVER=local
KEYCLOAK_LOGS_VOLUME_TYPE=
KEYCLOAK_LOGS_VOLUME_OPTS=
KEYCLOAK_LOGS_VOLUME_PATH=
KEYCLOAK_LOGS_VOLUME_DIR=/opt/keycloak/logs

KEYCLOAK_HOMEPAGE_GROUP=Identity
KEYCLOAK_HOMEPAGE_NAME=Keycloak
KEYCLOAK_HOMEPAGE_ICON=keycloak.png
KEYCLOAK_HOMEPAGE_DESCRIPTION=Open-source identity and access management
KEYCLOAK_HOMEPAGE_URL=
KEYCLOAK_HOMEPAGE_SITEMONITOR=http://keycloak:8080/auth
