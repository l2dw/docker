# Copied into root `.env` (Make exports it for `docker stack deploy`).
# Image: https://www.keycloak.org/server/containers
# Subpath: KC_HTTP_RELATIVE_PATH (KEYCLOAK_BASE_PATH=/auth). Align KEYCLOAK_APP_URL. Do not stripPrefix.
# Postgres is external (no db service in this stack). Create the database/role first.

DEFAULT_NETWORK_NAME=dokploy-network
DEFAULT_NETWORK_EXTERNAL=false

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:latest
KEYCLOAK_RESTART=unless-stopped
KEYCLOAK_PRIVILEGED=false
KEYCLOAK_ENV_FILE=.env.example

# Public URL (no trailing slash). Must include BASE_PATH when not serving at /.
# Vendor: KC_HOSTNAME (full URL) + KC_HTTP_RELATIVE_PATH.
KEYCLOAK_APP_URL=http://example.com/auth
KEYCLOAK_DOMAIN=example.com
KEYCLOAK_BASE_PATH=/auth

KEYCLOAK_HTTP_ENABLED=true
KEYCLOAK_PROXY_HEADERS=xforwarded
KEYCLOAK_HOSTNAME_STRICT=true
KEYCLOAK_CACHE=local
KEYCLOAK_HEALTH_ENABLED=true
KEYCLOAK_METRICS_ENABLED=false
KEYCLOAK_LOG_LEVEL=info
KEYCLOAK_LOG=file,console
KEYCLOAK_LOG_FILE=/opt/keycloak/logs/keycloak.log

# Bootstrap admin (KC_BOOTSTRAP_ADMIN_*). Password generated by make keycloak-setup.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=

KEYCLOAK_DB=postgres
KEYCLOAK_DB_USERNAME=keycloak
# Generated by make keycloak-setup if empty — must match the existing Postgres role.
KEYCLOAK_DB_PASSWORD=
# Overlay hostname of an existing Postgres (e.g. dokploy-postgresql). No nested interpolation.
KEYCLOAK_DB_URL=jdbc:postgresql://dokploy-postgresql:5432/keycloak

KEYCLOAK_TRAEFIK_LABELS_SWARM_ENABLE=true
KEYCLOAK_TRAEFIK_LABELS_DOCKER_ENABLE=true
KEYCLOAK_ENTRYPOINTS=web
KEYCLOAK_MIDDLEWARES=
KEYCLOAK_TLS_ENABLED=false
KEYCLOAK_TLS_CERTRESOLVER=letsencrypt

KEYCLOAK_DEPLOY_MODE=replicated
KEYCLOAK_DEPLOY_REPLICAS=1
KEYCLOAK_PLACEMENT_CONSTRAINTS=node.platform.os==linux
KEYCLOAK_MEMORY_LIMIT=1G

# Empty DIR = named volume. Bind a host path to pin files.
KEYCLOAK_DATA_DIR=
KEYCLOAK_DATA_VOLUME_NAME=keycloak-data
KEYCLOAK_DATA_VOLUME_EXTERNAL=false
KEYCLOAK_DATA_CONTAINER_PATH=/opt/keycloak/data

KEYCLOAK_THEMES_DIR=
KEYCLOAK_THEMES_VOLUME_NAME=keycloak-themes
KEYCLOAK_THEMES_VOLUME_EXTERNAL=false
KEYCLOAK_THEMES_CONTAINER_PATH=/opt/keycloak/themes

KEYCLOAK_PROVIDERS_DIR=
KEYCLOAK_PROVIDERS_VOLUME_NAME=keycloak-providers
KEYCLOAK_PROVIDERS_VOLUME_EXTERNAL=false
KEYCLOAK_PROVIDERS_CONTAINER_PATH=/opt/keycloak/providers

KEYCLOAK_CONF_DIR=
KEYCLOAK_CONF_VOLUME_NAME=keycloak-conf
KEYCLOAK_CONF_VOLUME_EXTERNAL=false
KEYCLOAK_CONF_CONTAINER_PATH=/opt/keycloak/conf

KEYCLOAK_LOGS_DIR=
KEYCLOAK_LOGS_VOLUME_NAME=keycloak-logs
KEYCLOAK_LOGS_VOLUME_EXTERNAL=false
KEYCLOAK_LOGS_CONTAINER_PATH=/opt/keycloak/logs

KEYCLOAK_HOMEPAGE_GROUP=Identity
KEYCLOAK_HOMEPAGE_NAME=Keycloak
KEYCLOAK_HOMEPAGE_ICON=keycloak.png
KEYCLOAK_HOMEPAGE_DESCRIPTION=Open-source identity and access management
KEYCLOAK_HOMEPAGE_SITEMONITOR=http://keycloak:8080/auth
