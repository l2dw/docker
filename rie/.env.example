### Docker Compose configuration
COMPOSE_PROJECT_NAME=rie

ENV_FILE=.env.example

APP_NAME=rie
APP_PORT=3000
APP_BASE_PATH=/
APP_DOMAIN=rie.example.com
APP_TRAEFIK_ENTRYPOINTS=web
APP_TRAEFIK_MIDDLEWARES=
APP_TRAEFIK_TLS_ENABLED=false
APP_TRAEFIK_TLS_CERTRESOLVER=letsencrypt

RIE_IMAGE=atelier.cen.umontreal.ca/rie/rie:latest
ENV_FILE=.env.example
DEPLOY_MODE=replicated
DEPLOY_REPLICAS=1
MEMORY_LIMIT=1G
PLACEMENT_CONSTRAINTS=node.platform.os==linux
RESTART_POLICY_CONDITION=any
RESTART_POLICY_DELAY=5s
RESTART_POLICY_MAX_ATTEMPTS=3
TRAEFIK_LABELS_SWARM_ENABLE=false
TRAEFIK_LABELS_DOCKER_ENABLE=true
TRAEFIK_ENTRYPOINTS=web
TRAEFIK_MIDDLEWARES=
TRAEFIK_TLS_ENABLED=false
TRAEFIK_TLS_CERTRESOLVER=letsencrypt
RIE_HOMEPAGE_GROUP=APP
RIE_HOMEPAGE_NAME=RIE
RIE_HOMEPAGE_ICON=rie.png
RIE_HOMEPAGE_DESCRIPTION=RIE application
RIE_HOMEPAGE_SITEMONITOR=http://app:3000

### General configuration
TZ=America/Montreal
http_proxy=
https_proxy=
no_proxy=
HTTP_PROXY=${http_proxy:-}
HTTPS_PROXY=${https_proxy:-}
NO_PROXY=${no_proxy:-}
NODE_ENV=production
ENV_NAME=prod

ENABLE_SERVICE_WEB_APP=true
ENABLE_SERVICE_API=false

# Database configuration
PG_DATABASE_NAME=rie
PG_DATABASE_USER=rie
PG_DATABASE_PASSWORD=rie123
PG_DATABASE_HOST=rie-postgresql
PG_DATABASE_PORT=5432

# API configuration
API_BASE_PATH=/api
API_PORT=4000
RIE_API_DOMAIN=rie.example.com
RIE_API_URL=http://rie.example.com/api

# Authentication
MICROSOFT_TENANT_ID=your-microsoft-tenant-id
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
BETTER_AUTH_SECRET=your-better-auth-secret--long-32
# OpenTelemetry
LOG_LEVEL=info
OTEL_SERVICE_NAME_API=rie-${ENV_NAME}--api
OTEL_SERVICE_NAME_CLIENT=rie-${ENV_NAME}--client
OTEL_API_ENABLED=false
OTEL_CLIENT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# S3 Storage client
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_PROVIDER=minio
S3_USE_SSL=true
S3_REGION=your-s3-region
S3_BUCKET=rie-storage
# Client configuration
RIE_CLIENT_DOMAIN=rie.example.com
RIE_CLIENT_BASE_PATH=/web
CLIENT_DOMAIN=rie.example.com
CLIENT_BASE_PATH=/web
CLIENT_ORIGIN_URL=http://rie.example.com/web
CLIENT_PORT=3000
CLIENT_HTTP_PROTOCOL=https
CLIENT_HTTP_HOST=rie.example.com
CLIENT_HTTP_PORT=443
# Next.js configuration
NEXT_PUBLIC_VERSION=
NEXT_PUBLIC_BASE_PATH=/web
NEXT_PUBLIC_API_FULL_URL=http://rie.example.com/api
NEXT_PUBLIC_RIE_API_URL=http://rie.example.com/api
NEXT_PUBLIC_API_HTTP_PROTOCOL=http
NEXT_PUBLIC_API_HTTP_HOST=rie.example.com
NEXT_PUBLIC_API_PORT=443
NEXT_PUBLIC_API_BASE_PATH=/api
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# SMTP / Email (used by SmtpEmailAdapterLive)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@rie.umontreal.ca
SIGNUP_ALLOWED_EMAIL_SUFFIXES=@umontreal.ca
DEFAULT_NETWORK_NAME=rie-network
DEFAULT_NETWORK_EXTERNAL=false
RIE_HOMEPAGE_URL=
RIE_DATA_VOLUME_NAME=rie_data
RIE_DATA_VOLUME_EXTERNAL=false
RIE_DATA_VOLUME_DRIVER=local
RIE_DATA_VOLUME_TYPE=
RIE_DATA_VOLUME_OPTS=
RIE_DATA_VOLUME_PATH=
RIE_DATA_VOLUME_DIR=/appdata
RIE_RESTART=unless-stopped
RIE_PRIVILEGED=false
